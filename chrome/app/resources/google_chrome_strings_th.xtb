<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="th">
<translation id="1001534784610492198">การเก็บข้อมูลของโปรแกรมติดตั้งเสียหายหรือไม่ถูกต้อง โปรดดาวน์โหลด Tomi อีกครั้ง</translation>
<translation id="1026101648481255140">ดำเนินการติดตั้งต่อ</translation>
<translation id="102763973188675173">ปรับแต่งและควบคุม Tomi มีการอัปเดต</translation>
<translation id="1051826050538111504">มีซอฟต์แวร์อันตรายในคอมพิวเตอร์ของคุณ Tomi ช่วยนำซอฟต์แวร์ดังกล่าวออก คืนการตั้งค่า และปิดใช้ส่วนขยายให้คุณได้ เพื่อให้เบราว์เซอร์กลับมาทำงานเป็นปกติอีกครั้ง</translation>
<translation id="1065672644894730302">ค่ากำหนดของคุณไม่สามารถอ่านได้ ฟีเจอร์บางอย่างอาจใช้ไม่ได้และการเปลี่ยนแปลงค่ากำหนดจะไม่ได้รับการบันทึก</translation>
<translation id="1088300314857992706"><ph name="USER_EMAIL_ADDRESS" /> ใช้ Tomi อยู่ก่อนหน้านี้</translation>
<translation id="110877069173485804">นี่คือ Tomi ของคุณ</translation>
<translation id="1125124144982679672">ใครกำลังใช้ Tomi อยู่</translation>
<translation id="1142745911746664600">อัปเดต Tomi ไม่ได้</translation>
<translation id="1152920704813762236">เกี่ยวกับ Tomi OS</translation>
<translation id="1154147086299354128">เ&amp;ปิดใน Tomi</translation>
<translation id="1203500561924088507">ขอขอบคุณที่ติดตั้ง คุณต้องรีสตาร์ทเบราว์เซอร์ก่อนใช้ <ph name="BUNDLE_NAME" /></translation>
<translation id="1236866257838264361">ใช้งาน Tomi อย่างเต็มประสิทธิภาพ</translation>
<translation id="1278833599417554002">เปิดอีกครั้งเพื่ออัปเดต Tomi</translation>
<translation id="1302523850133262269">โปรดรอขณะที่ Tomi ติดตั้งการอัปเดตระบบล่าสุด</translation>
<translation id="1335640173511558774"><ph name="MANAGER" /> กำหนดว่าคุณต้องอ่านและยอมรับข้อกำหนดในการให้บริการต่อไปนี้ก่อนใช้อุปกรณ์นี้ ข้อกำหนดเหล่านี้ไม่ขยาย แก้ไข หรือจำกัดข้อกำหนดของ Tomi OS Flex</translation>
<translation id="1363996462118479832">Tomi OS ซิงค์ข้อมูลไม่ได้เนื่องจากเกิดข้อผิดพลาดในการลงชื่อเข้าใช้</translation>
<translation id="137466361146087520">Tomi เบต้า</translation>
<translation id="1399397803214730675">คอมพิวเตอร์เครื่องนี้มี Tomi รุ่นใหม่กว่าแล้ว หากซอฟต์แวร์ไม่ทำงาน โปรดถอนการติดตั้ง Tomi แล้วลองใหม่อีกครั้ง</translation>
<translation id="139993653570221430">คุณเปลี่ยนใจได้ทุกเมื่อในการตั้งค่า Tomi การทดลองใช้จะทำงานพร้อมกับวิธีแสดงโฆษณาปัจจุบัน คุณจึงจะไม่เห็นการเปลี่ยนแปลงโดยทันที</translation>
<translation id="1434626383986940139">แอป Tomi Canary</translation>
<translation id="1507198376417198979">ปรับแต่งโปรไฟล์ Tomi ใหม่</translation>
<translation id="1516530951338665275">Tomi ต้องการสิทธิ์เข้าถึงบลูทูธเพื่อจับคู่ต่อ <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1547295885616600893">Tomi OS เกิดขึ้นได้ด้วยการสนับสนุนจาก<ph name="BEGIN_LINK_CROS_OSS" />ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_CROS_OSS" />อื่นเพิ่มเติม</translation>
<translation id="1553358976309200471">อัปเดต Tomi</translation>
<translation id="1583073672411044740"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้โปรไฟล์ Tomi นี้แล้ว การดำเนินการนี้จะสร้างโปรไฟล์ Tomi ใหม่สำหรับ <ph name="USER_EMAIL_ADDRESS" /></translation>
<translation id="1587223624401073077">Tomi ใช้กล้องของคุณอยู่</translation>
<translation id="1587325591171447154"><ph name="FILE_NAME" /> เป็นอันตราย Tomi จึงบล็อกไว้</translation>
<translation id="1597911401261118146"><ph name="BEGIN_LINK" />ลงชื่อเข้าใช้ Tomi<ph name="END_LINK" /> เพื่อตรวจสอบว่ารหัสผ่านของคุณไม่ได้รับผลกระทบจากการละเมิดข้อมูลและปัญหาด้านความปลอดภัยอื่นๆ</translation>
<translation id="1599904803480101533">Tomi บล็อกไฟล์ที่เก็บถาวรนี้เนื่องจากอาจซ่อนมัลแวร์ไว้</translation>
<translation id="1619887657840448962">เพื่อให้ Tomi ปลอดภัยขึ้น เราได้ปิดส่วนขยายต่อไปนี้ซึ่งไม่ได้แสดงอยู่ใน <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> และอาจมีการเพิ่มเข้ามาโดยที่คุณไม่รู้ตัว</translation>
<translation id="1627304841979541023"><ph name="BEGIN_BOLD" />วิธีที่คุณจัดการข้อมูลของตัวเองได้:<ph name="END_BOLD" /> เราลบความสนใจที่เก่ากว่า 4 สัปดาห์โดยอัตโนมัติเพื่อปกป้องความเป็นส่วนตัวของคุณ ความสนใจอาจกลับมาปรากฏในรายการอีกเมื่อคุณท่องเว็บต่อ หรือคุณจะนำความสนใจที่ไม่ต้องการให้ Tomi พิจารณาออกก็ได้</translation>
<translation id="1628000112320670027">รับความช่วยเหลือเกี่ยวกับ Tomi</translation>
<translation id="1640672724030957280">กำลังดาวน์โหลด...</translation>
<translation id="1662146548738125461">เกี่ยวกับ Tomi OS Flex</translation>
<translation id="1674870198290878346">เปิดลิงก์ในหน้าต่างที่ไม่ระบุตัวตนของ Tomi</translation>
<translation id="1682634494516646069">Tomi ไม่สามารถอ่านและเขียนข้อมูลในไดเรกทอรีข้อมูล: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1691802391966922744">{COUNT,plural, =1{ผู้ดูแลระบบได้กำหนดค่าให้ Tomi ปิดหากไม่มีการใช้งานเกิน 1 นาที}other{ผู้ดูแลระบบได้กำหนดค่าให้ Tomi ปิดหากไม่มีการใช้งานเกิน # นาที}}</translation>
<translation id="1698376642261615901">Tomi คือเว็บเบราว์เซอร์ที่แสดงหน้าเว็บและแอปพลิเคชันต่างๆ ได้รวดเร็วในพริบตา โดยทำงานได้เร็ว มีเสถียรภาพ และใช้งานง่าย ช่วยให้คุณเรียกดูเว็บได้อย่างปลอดภัยมากขึ้นด้วยการป้องกันมัลแวร์และฟิชชิงซึ่งมีอยู่ใน Tomi</translation>
<translation id="1713301662689114961">{0,plural, =1{Tomi จะเปิดขึ้นมาใหม่ใน 1 ชั่วโมง}other{Tomi จะเปิดขึ้นมาใหม่ใน # ชั่วโมง}}</translation>
<translation id="1734234790201236882">Tomi จะบันทึกรหัสผ่านนี้ในบัญชี Tomi คุณจะได้ไม่ต้องจำรหัสผ่านเอง</translation>
<translation id="1759842336958782510">Tomi</translation>
<translation id="1786003790898721085">ตรวจสอบว่าคุณลงชื่อเข้าใช้ Tomi ใน <ph name="TARGET_DEVICE_NAME" /> แล้วลองส่งอีกครั้ง</translation>
<translation id="1812689907177901597">เมื่อปิดการตั้งค่านี้ คุณจะลงชื่อเข้าใช้เว็บไซต์ของ Tomi อย่างเช่น Gmail ได้โดยไม่ต้องลงชื่อเข้าใช้ Tomi</translation>
<translation id="1860536484129686729">Tomi ต้องการสิทธิ์เข้าถึงกล้องถ่ายรูปของคุณสำหรับเว็บไซต์นี้</translation>
<translation id="1873233029667955273">Tomi ไม่ใช่เบราว์เซอร์เริ่มต้น</translation>
<translation id="1874309113135274312">Tomi เบต้า (mDNS-In)</translation>
<translation id="1877026089748256423">Tomi ล้าสมัย</translation>
<translation id="1919130412786645364">อนุญาตให้ลงชื่อเข้าใช้ Tomi</translation>
<translation id="1952239763774043237">คุณจะต้องใช้ macOS 10.13 ขึ้นไปเพื่อรับการอัปเดต Tomi ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ macOS 10.12</translation>
<translation id="1953553007165777902">กำลังดาวน์โหลด... เหลืออีก <ph name="MINUTE" /> นาที</translation>
<translation id="2018528049276128029">แต่ละโปรไฟล์จะเก็บข้อมูล Tomi ของตัวเอง เช่น บุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และอื่นๆ</translation>
<translation id="2018879682492276940">การติดตั้งไม่สำเร็จ โปรดลองอีกครั้ง</translation>
<translation id="2071318482926839249">บัญชีอื่นได้ลงชื่อเข้าใช้อยู่แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก Tomi สร้างโปรไฟล์ให้คุณโดยเฉพาะได้</translation>
<translation id="207902854391093810">เมื่อเริ่มการทดสอบ การวัดผลโฆษณาจะให้เว็บไซต์ที่คุณเข้าชมสามารถขอข้อมูลจาก Tomi เพื่อช่วยวัดประสิทธิภาพโฆษณาของเว็บไซต์ดังกล่าวได้ การวัดผลโฆษณาจะจำกัดการติดตามข้ามเว็บไซต์โดยโอนข้อมูลระหว่างเว็บไซต์ให้น้อยที่สุด</translation>
<translation id="2091012649849228750">คุณจะต้องใช้ Windows 10 ขึ้นไปเพื่อรับการอัปเดต Tomi ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ Windows 8</translation>
<translation id="2094648590148273905">ข้อกำหนดของ Tomi OS Flex</translation>
<translation id="2094919256425865063">ปิด Tomi ใช่ไหม</translation>
<translation id="2106831557840787829">Tomi OS Flex เกิดขึ้นได้ด้วยการสนับสนุนจาก<ph name="BEGIN_LINK_CROS_OSS" />ซอฟต์แวร์โอเพนซอร์ส<ph name="END_LINK_CROS_OSS" />เพิ่มเติม เช่นเดียวกับ<ph name="BEGIN_LINK_LINUX_OSS" />สภาพแวดล้อมในการพัฒนาซอฟต์แวร์ Linux<ph name="END_LINK_LINUX_OSS" /></translation>
<translation id="2120620239521071941">การดำเนินการนี้จะลบ <ph name="ITEMS_COUNT" /> รายการออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ Tomi ด้วย <ph name="USER_EMAIL" /></translation>
<translation id="2121284319307530122">เปิดอีกครั้งเพื่ออัปเดต Tomi</translation>
<translation id="2123055963409958220">ช่วยให้ Tomi ดียิ่งขึ้นด้วยการรายงาน<ph name="BEGIN_LINK" />การตั้งค่าปัจจุบัน<ph name="END_LINK" /></translation>
<translation id="2131230230468101642">เราลบความสนใจที่เก่ากว่า 4 สัปดาห์โดยอัตโนมัติเพื่อปกป้องความเป็นส่วนตัวของคุณ ความสนใจอาจกลับมาปรากฏในรายการอีกเมื่อคุณท่องเว็บต่อ หรือคุณจะนำความสนใจที่ไม่ต้องการให้ Tomi พิจารณาออกก็ได้</translation>
<translation id="2139300032719313227">รีสตาร์ท Tomi OS</translation>
<translation id="2151406531797534936">โปรดรีสตาร์ท Tomi ตอนนี้เลย</translation>
<translation id="2174917724755363426">การติดตั้งไม่สมบูรณ์ คุณแน่ใจไหมว่าต้องการยกเลิก</translation>
<translation id="223889379102603431">ข้อมูลเกี่ยวกับวิธีที่ Tomi จัดการใบรับรองรูท</translation>
<translation id="2258103955319320201">หากต้องการเข้าถึงข้อมูลของคุณในเบราว์เซอร์ Tomi ในอุปกรณ์ทั้งหมด ให้ลงชื่อเข้าใช้แล้วเปิดการซิงค์</translation>
<translation id="2290014774651636340">คีย์ API ของ Tomi หายไป การทำงานบางอย่างของ Tomi จะถูกปิดใช้งาน</translation>
<translation id="2290095356545025170">คุณแน่ใจหรือไม่ว่าต้องการยกเลิกการติดตั้ง Tomi</translation>
<translation id="2309047409763057870">นี่เป็นการติดตั้ง Tomi แบบสำรอง และไม่สามารถใช้เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="2345992953227471816">Tomi พบว่าส่วนขยายเหล่านี้มีมัลแวร์</translation>
<translation id="2348335408836342058">Tomi ต้องการสิทธิ์เข้าถึงไมโครโฟนและกล้องถ่ายรูปของคุณสำหรับเว็บไซต์นี้</translation>
<translation id="234869673307233423">Tomi ตรวจสอบรหัสผ่านของคุณไม่ได้ โปรดลองอีกครั้งภายหลัง</translation>
<translation id="235650106824528204">ผู้ดูแลโปรไฟล์งานนำข้อมูล Tomi ที่สร้างขึ้นในช่วงที่มีการใช้โปรไฟล์นี้ออกได้ (เช่น การสร้างบุ๊กมาร์ก ประวัติการเข้าชม รหัสผ่าน และการตั้งค่าอื่นๆ) <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">ต่อไป</translation>
<translation id="2401189691232800402">ระบบ Tomi OS</translation>
<translation id="2467438592969358367">Tomi ต้องการส่งออกรหัสผ่านของคุณ พิมพ์รหัสผ่าน Windows เพื่ออนุญาตให้ดำเนินการ</translation>
<translation id="2485422356828889247">ถอนการติดตั้ง</translation>
<translation id="2534507159460261402">Tomi Pay (คัดลอกไปยัง Tomi)</translation>
<translation id="2559253115192232574">ภายหลัง เว็บไซต์ที่คุณเข้าชมอาจขอข้อมูลความสนใจจาก Tomi เพื่อปรับการแสดงโฆษณาให้เหมาะกับคุณ Tomi สามารถแชร์ความสนใจได้สูงสุด 3 รายการ</translation>
<translation id="2563121210305478421">เปิด Tomi อีกครั้ง</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> ลงชื่อเข้าใช้โปรไฟล์ Tomi นี้แล้ว หากต้องการแยกการท่องเว็บของคุณไว้ต่างหาก Tomi สร้างโปรไฟล์ให้คุณโดยเฉพาะได้</translation>
<translation id="2580411288591421699">ไม่สามารถติดตั้ง Tomi รุ่นเดียวกับที่กำลังเรียกใช้อยู่ได้ โปรดปิด Tomi แล้วลองใหม่อีกครั้ง</translation>
<translation id="2586406160782125153">การดำเนินการนี้จะลบข้อมูลการท่องเว็บออกจากอุปกรณ์นี้ หากต้องการดึงข้อมูลภายหลัง ให้ลงชื่อเข้าใช้ Tomi ด้วย <ph name="USER_EMAIL" /></translation>
<translation id="2597976513418770460">ดึงข้อมูลของคุณในเบราว์เซอร์ Tomi จาก <ph name="ACCOUNT_EMAIL" /></translation>
<translation id="2622559029861875898">Tomi ตรวจหาอัปเดตไม่ได้ โปรดลองตรวจสอบการเชื่อมต่ออินเทอร์เน็ต</translation>
<translation id="2645435784669275700">Tomi OS</translation>
<translation id="2652691236519827073">เปิดลิงก์ใน Tomi แท็บใหม่</translation>
<translation id="2665296953892887393">ช่วยทำให้ Tomi ดียิ่งขึ้นโดยการส่งรายงานข้อขัดข้องและ <ph name="UMA_LINK" /> ไปยัง Tomi</translation>
<translation id="2689103672227170538">ส่วนขยายนี้ได้เปลี่ยนหน้าที่จะแสดงเมื่อคุณเริ่มต้น Tomi</translation>
