<translation id="4427306783828095590">การปกป้องที่ปรับปรุงแล้วทำได้มากกว่าบล็อกฟิชชิงและมัลแวร์</translation>
<translation id="4450664632294415862">Tomi - หน้าลงชื่อเข้าใช้ของเครือข่าย - <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">Tomi กำลังดำเนินการอย่างอื่นอยู่ โปรดลองอีกครั้งในภายหลัง</translation>
<translation id="4459234553906210702">การวัดผลโฆษณาจะให้เว็บไซต์ที่คุณเข้าชมสามารถขอข้อมูลจาก Tomi เพื่อช่วยในการวัดประสิทธิภาพโฆษณาเว็บไซต์ดังกล่าวได้ การวัดผลโฆษณาจะจำกัดการติดตามข้ามเว็บไซต์โดยโอนข้อมูลระหว่างเว็บไซต์ให้น้อยที่สุด</translation>
<translation id="4561051373932531560">Tomi ทำให้คุณสามารถคลิกที่หมายเลขโทรศัพท์บนเว็บแล้วโทรหาด้วย Skype!</translation>
<translation id="4567424176335768812">คุณกำลังลงชื่อเข้าใช้เป็น <ph name="USER_EMAIL_ADDRESS" /> ตอนนี้คุณสามารถเข้าถึงบุ๊กมาร์ก ประวัติการเข้าชม และการตั้งค่าอื่นๆ บนอุปกรณ์ทั้งหมดที่ลงชื่อเข้าใช้</translation>
<translation id="4571503333518166079">ไปที่การตั้งค่าการแจ้งเตือน Tomi</translation>
<translation id="459622048091363950">เมื่อ Tomi มีสิทธิ์การเข้าถึงแล้ว เว็บไซต์จะขอสิทธิ์การเข้าถึงจากคุณได้</translation>
<translation id="4600710005438004015">Tomi อัปเดตเป็นเวอร์ชันล่าสุดไม่ได้ คุณจึงไม่ได้รับฟีเจอร์ใหม่และการแก้ไขด้านความปลอดภัย</translation>
<translation id="4627412468266359539">ไม่บังคับ: ช่วยปรับปรุงฟีเจอร์และประสิทธิภาพของ Tomi OS Flex ด้วยการส่งข้อมูลการวินิจฉัยและการใช้งานให้ Tomi โดยอัตโนมัติ</translation>
<translation id="4633000520311261472">เพื่อให้ Tomi ปลอดภัยขึ้น เราปิดส่วนขยายบางรายการที่ไม่ได้ระบุไว้ใน <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> และอาจถูกเพิ่มเข้ามาโดยที่คุณไม่รู้ตัว</translation>
<translation id="4680828127924988555">ยกเลิกการติดตั้ง</translation>
<translation id="469553575393225953">ส่วนขยาย แอป และธีมจากแหล่งที่มาที่ไม่รู้จักอาจเป็นอันตรายต่ออุปกรณ์ของคุณ ขอแนะนำให้ติดตั้ง Tomi จาก Tomi เว็บสโตร์เท่านั้น</translation>
<translation id="4728575227883772061">การติดตั้งล้มเหลวเนื่องจากมีข้อผิดพลาดที่ไม่ได้ระบุ หาก Tomi ทำงานอยู่ในขณะนี้ โปรดปิดและลองอีกครั้ง</translation>
<translation id="4747730611090640388">Tomi สามารถคาดคะเนความสนใจของคุณได้  ภายหลัง เว็บไซต์ที่คุณเข้าชมอาจขอข้อมูลความสนใจจาก Tomi เพื่อปรับการแสดงโฆษณาให้เหมาะกับคุณ</translation>
<translation id="4754614261631455953">Tomi Canary (mDNS-In)</translation>
<translation id="4771048833395599659">ไฟล์นี้อาจเป็นอันตราย Tomi จึงบล็อกไว้</translation>
<translation id="479167709087336770">การดำเนินการนี้จะใช้โปรแกรมตรวจตัวสะกดแบบเดียวกับใน Tomi Search ข้อความที่คุณพิมพ์ในเบราว์เซอร์จะส่งไปยัง Tomi คุณปรับเปลี่ยนลักษณะการทำงานนี้ได้ทุกเมื่อในการตั้งค่า</translation>
<translation id="4842397268809523050">Tomi OS Flex ซิงค์ข้อมูลไม่ได้เนื่องจากการซิงค์ใช้ไม่ได้กับโดเมนของคุณ</translation>
<translation id="4873783916118289636">ตรวจสอบการควบคุมที่สำคัญด้านความเป็นส่วนตัวและความปลอดภัยใน Tomi</translation>
<translation id="4891791193823137474">ให้ Tomi ทำงานในเบื้องหลัง</translation>
<translation id="4895437082222824641">เปิดลิงก์ใน Tomi แท็บใหม่</translation>
<translation id="4953650215774548573">ตั้ง Tomi เป็นเบราว์เซอร์เริ่มต้นของคุณ</translation>
<translation id="495931528404527476">ใน Tomi</translation>
<translation id="4969674060580488087">Tomi OS Flex ซิงค์ข้อมูลไม่ได้เนื่องจากรายละเอียดการลงชื่อเข้าใช้บัญชีไม่เป็นปัจจุบัน</translation>
<translation id="4970761609246024540">ยินดีต้อนรับสู่โปรไฟล์ Tomi</translation>
<translation id="4970880042055371251">เวอร์ชัน Tomi OS</translation>
<translation id="4970947549776831107">Tomi บล็อกไฟล์นี้เนื่องจากไฟล์ประเภทนี้เป็นอันตราย</translation>
<translation id="4990567037958725628">Tomi Canary</translation>
<translation id="5037581483200764584">คุณจะต้องใช้ macOS 10.13 ขึ้นไปเพื่อรับการอัปเดต Tomi ในอนาคต คอมพิวเตอร์เครื่องนี้ใช้ OS X 10.11</translation>
<translation id="5098668839038261629">หากเปิดใช้ คุณจะออกจากระบบของ Tomi ด้วย</translation>
<translation id="5132929315877954718">พบกับแอป เกม ส่วนขยาย และธีมเด็ดๆ สำหรับ Tomi</translation>
<translation id="5139423532931106058">ปรับแต่งโปรไฟล์ Tomi ของคุณ</translation>
<translation id="5163087008893166964">ยินดีต้อนรับสู่ Tomi เปิดหน้าต่างเบราวเซอร์ใหม่แล้ว</translation>
<translation id="5170938038195470297">โปรไฟล์ของคุณไม่สามารถใช้ได้เพราะมาจากรุ่นที่ใหม่กว่าของ Tomi ฟีเจอร์บางอย่างอาจจะไม่พร้อมใช้งาน โปรดระบุไดเรกทอรีของโปรไฟล์อื่นหรือใช้ Tomi รุ่นที่ใหม่กว่า</translation>
<translation id="521447420733633466">เพื่อนและครอบครัวสามารถท่องเว็บแยกกันและตั้งค่า Tomi ตามที่ตนต้องการในกรณีที่ใช้อุปกรณ์ร่วมกัน</translation>
<translation id="5251420635869119124">ผู้เยี่ยมชมสามารถใช้ Tomi ได้โดยไม่ทิ้งร่องรอยไว้</translation>
<translation id="5334309298019785904">Tomi OS ซิงค์ข้อมูลไม่ได้เนื่องจากการซิงค์ไม่พร้อมใช้งานสำหรับโดเมนของคุณ</translation>
<translation id="5334487786912937552">Tomi ต้องการสิทธิ์เข้าถึงพื้นที่เก็บข้อมูลเพื่อดาวน์โหลดไฟล์</translation>
<translation id="5337648990166757586">ไม่บังคับ: ช่วยปรับปรุงฟีเจอร์และประสิทธิภาพของ Tomi OS โดยการส่งข้อมูลการวินิจฉัยและการใช้งานให้ Tomi โดยอัตโนมัติ</translation>
<translation id="5357889879764279201">รับความช่วยเหลือเกี่ยวกับ Tomi OS Flex</translation>
<translation id="5386244825306882791">อีกทั้งยังควบคุมหน้าที่จะแสดงเมื่อคุณเปิด Tomi หรือทำการค้นหาจากแถบอเนกประสงค์ด้วย</translation>
<translation id="5394833366792865639">แชร์แท็บ Tomi</translation>
<translation id="5412485296464121825">เว็บไซต์สามารถจัดเก็บข้อมูลเกี่ยวกับความสนใจไว้กับ Tomi ตัวอย่างเช่น หากคุณเข้าชมเว็บไซต์เพื่อซื้อรองเท้าวิ่งมาราธอน เว็บไซต์นี้อาจระบุว่าคุณสนใจการวิ่งมาราธอน ภายหลัง เมื่อคุณเข้าชมเว็บไซต์อื่นเพื่อลงทะเบียนแข่งมาราธอน เว็บไซต์นี้ก็อาจแสดงโฆษณารองเท้าวิ่งโดยอิงจากความสนใจดังกล่าว</translation>
<translation id="5430073640787465221">ไฟล์ค่ากำหนดของคุณขัดข้องหรือไม่ถูกต้อง Tomi ไม่สามารถกู้คืนการตั้งค่าของคุณได้</translation>
<translation id="5524761631371622910">เมื่อเริ่มการทดสอบและหาก Tomi สุ่มคุณไปไว้ในการทดสอบที่ดำเนินอยู่ ประวัติการท่องเว็บจะส่งผลต่อโฆษณาที่คุณเห็นและความสนใจที่ระบบคาดคะเนไว้ดังที่แสดงอยู่ด้านล่างนี้ Tomi ลบความสนใจเป็นประจำทุกเดือนเพื่อปกป้องความเป็นส่วนตัวของคุณ</translation>
<translation id="5530733413481476019">ทำให้ Tomi เร็วขึ้น</translation>
<translation id="556024056938947818">Tomi กำลังพยายามแสดงรหัสผ่าน</translation>
<translation id="5566025111015594046">Tomi (mDNS-In)</translation>
<translation id="565744775970812598"><ph name="FILE_NAME" /> อาจเป็นอันตราย Tomi จึงบล็อกไว้</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{ผู้ดูแลระบบขอให้คุณเปิด Tomi ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้}=1{ผู้ดูแลระบบขอให้คุณเปิด Tomi ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้ หน้าต่างที่ไม่ระบุตัวตนจะไม่เปิดให้อีก}other{ผู้ดูแลระบบขอให้คุณเปิด Tomi ขึ้นมาใหม่เพื่อใช้การอัปเดตนี้ หน้าต่างที่ไม่ระบุตัวตนจำนวน # หน้าต่างจะไม่เปิดให้อีก}}</translation>
<translation id="5686916850681061684">ปรับแต่งและควบคุม Tomi มีสิ่งที่คุณจำเป็นต้องทราบ โปรดคลิกเพื่อดูรายละเอียด</translation>
<translation id="5690427481109656848">Tomi LLC</translation>
<translation id="5715063361988620182">{SECONDS,plural, =1{Tomi จะรีสตาร์ทใน 1 วินาที}other{Tomi จะรีสตาร์ทใน # วินาที}}</translation>
<translation id="5727531838415286053">หาก Tomi สุ่มคุณไปไว้ในการทดสอบที่ดำเนินอยู่ ประวัติการท่องเว็บจะส่งผลต่อโฆษณาที่คุณเห็นและความสนใจที่ระบบคาดคะเนไว้ดังที่แสดงอยู่ด้านล่างนี้ Tomi ลบความสนใจเป็นประจำทุกเดือนเพื่อปกป้องความเป็นส่วนตัวของคุณ ระบบจะรีเฟรชความสนใจหากคุณไม่นำออก</translation>
<translation id="5736850870166430177">หากเว็บไซต์พยายามขโมยรหัสผ่าน หรือคุณดาวน์โหลดไฟล์ที่เป็นอันตราย Tomi อาจส่ง URL รวมถึงเนื้อหาบางส่วนในหน้าไปยัง Tomi Safe Browsing ด้วย</translation>
<translation id="5756509061973259733">มีโปรไฟล์ Tomi ที่ใช้บัญชีนี้ในอุปกรณ์นี้อยู่แล้ว</translation>
<translation id="5795887333006832406"><ph name="PAGE_TITLE" /> - Tomi Canary</translation>
