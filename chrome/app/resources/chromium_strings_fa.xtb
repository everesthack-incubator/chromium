<translation id="3412460710772753638">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="3420193029125244288">{COUNT,plural, =1{‏سرپرست شما Tomi را طوری پیکربندی کرده است که اگر بیش‌از یک دقیقه بدون فعالیت باشد بسته شود.}one{‏سرپرست شما Tomi را طوری پیکربندی کرده است که اگر بیش‌از # دقیقه بدون فعالیت باشد بسته شود.}other{‏سرپرست شما Tomi را طوری پیکربندی کرده است که اگر بیش‌از # دقیقه بدون فعالیت باشد بسته شود.}}</translation>
<translation id="3430503420100763906">‏با نمایه‌های Tomi می‌توانید همه چیزتان را در Tomi جدا کنید. برای دوستان و اعضای خانواده‌تان نمایه ایجاد کنید، یا کار و سرگرمی را ازهم جدا کنید.</translation>
<translation id="347328004046849135">‏وقتی با گذرواژه‌ای لورفته به سیستم وارد می‌شوید، Tomi شما را مطلع می‌کند</translation>
<translation id="3474745554856756813">‏این کار <ph name="ITEMS_COUNT" /> مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Tomi وارد شوید.</translation>
<translation id="3497319089134299931">‏با <ph name="SHORTCUT" /> می‌توانید بین نمایه‌های Tomi جابه‌جا شوید</translation>
<translation id="3509308970982693815">‏لطفاً همه پنجره‌های Tomi را ببندید و دوباره سعی کنید.</translation>
<translation id="3533435340678213462">‏برای محافظت از حریم خصوصی شما، علایقی را که قدیمی‌تر از ۴ هفته باشند به‌طور خودکار حذف می‌کنیم. وقتی به مرور کردن ادامه می‌دهید، ممکن است علاقه‌ای مجدداً به فهرست اضافه شود. یا می‌توانید علایقی را که نمی‌خواهید Tomi مدنظر قرار دهد حذف کنید.</translation>
<translation id="3567254597502212821">‏سابقه مرور شما، سابقه سایت‌هایی که بااستفاده از Tomi در این دستگاه از آن‌ها بازدید کرده‌اید.</translation>
<translation id="3575459661164320785">‏نرم‌افزار مضری در رایانه‌تان وجود دارد. Tomi می‌تواند آن را بردارد، تنظیمات را بازیابی کند و افزونه‌ها را غیرفعال کند تا عملکرد مرورگرتان دوباره عادی شود.</translation>
<translation id="3593091352817399191">‏حساب دیگری قبلاً به سیستم وارد شده است. برای جدا نگه داشتن جلسه‌های مرور، Tomi می‌تواند نمایه‌ای برایتان ایجاد کند که مختص شما باشد.</translation>
<translation id="3639635944603682591">‏داده‌های محصول مرور این کاربر از این دستگاه حذف می‌شود. برای بازیابی داده‌ها، با نام <ph name="USER_EMAIL" /> به سیستم Tomi وارد شوید.</translation>
<translation id="364817392622123556">{COUNT,plural, =0{‏به‌روزرسانی جدیدی برای Tomi در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد.}=1{‏به‌روزرسانی جدیدی برای Tomi در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. پنجره ناشناس بازگشایی نمی‌شود.}one{‏به‌روزرسانی جدیدی برای Tomi در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏به‌روزرسانی جدیدی برای Tomi در دسترس است و به‌محض راه‌اندازی مجدد اعمال خواهد شد. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="3651803019964686660">‏برای ارسال شماره از <ph name="ORIGIN" /> به تلفن Android خود، در هر دو دستگاه به سیستم Tomi وارد شوید.</translation>
<translation id="3685209450716071127">‏Tomi نمی‌تواند گذرواژه‌هایتان را بررسی کند. اتصال اینترنت را بررسی کنید.</translation>
<translation id="3702352323269013324">‏درباره شخصی‌سازی آگهی در Tomi بیشتر بدانید</translation>
<translation id="370962675267501463">{COUNT,plural, =0{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم از شما می‌خواهد برای اعمال این به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="3713809861844741608">‏باز کردن پیوند در &amp;برگه جدید Tomi</translation>
<translation id="3728336900324680424">‏Tomi برای ارائه پیشنهاد در نوار نشانی، به Drive شما دسترسی خواهد داشت</translation>
<translation id="378917192836375108">‏Tomi به شما اجازه می‌دهد بر روی شماره تلفن روی وب کلیک کرده و از طریق Skype تماس بگیرید!</translation>
<translation id="3830894615770080216">‏سیستم TomiOS</translation>
<translation id="3848258323044014972"><ph name="PAGE_TITLE" /> - Tomi</translation>
<translation id="386822487697155367">‏دریافت راهنمایی برای TomiOS</translation>
<translation id="3871664619793219264">‏اطلاعات مرورگر Tomi خود را که در <ph name="ACCOUNT_EMAIL" /> ذخیره شده است دریافت کنید</translation>
<translation id="388648406173476553">‏Tomi را سفارشی و کنترل کنید. چیزی نیاز به رسیدگی دارد، برای اطلاعات بیشتر کلیک کنید.</translation>
<translation id="3889543394854987837">‏برای باز کردن Tomi و شروع به مرور، روی نامتان کلیک کنید.</translation>
<translation id="390528597099634151">‏<ph name="EXISTING_USER" /> قبلاً به سیستم این نمایه Tomi وارد شده است. برای جدا نگه داشتن مرور، Tomi می‌تواند نمایه مختص خودتان را برایتان ایجاد کند.</translation>
<translation id="391789666908693569">‏<ph name="MANAGER_NAME" /> حساب شما را مدیریت می‌کند. سرپرستتان می‌تواند این نمایه مرورگر Tomi و داده‌های آن را (مثل نشانک‌ها، سابقه، و گذرواژه‌ها) ببیند و ویرایش کند.</translation>
<translation id="3945058413678539331">‏Tomi می‌خواهد گذرواژه‌ها را کپی کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="3962623956404948996">‏Tomi توصیه می‌کند این فایل را اسکن کنید زیرا ممکن است خطرناک باشد</translation>
<translation id="3997429360543082038">‏درباره TomiOS</translation>
<translation id="4019629340646866719">‏ارائه TomiOS به‌کمک <ph name="BEGIN_LINK_CROS_OSS" />نرم‌افزارهای متن‌باز<ph name="END_LINK_CROS_OSS" /> تکمیلی مثل <ph name="BEGIN_LINK_LINUX_OSS" />محیط توسعه نرم‌افزار Linux<ph name="END_LINK_LINUX_OSS" /> ممکن شده است.</translation>
<translation id="4036079820698952681">‏با گزارش <ph name="BEGIN_LINK" />تنظیمات کنونی<ph name="END_LINK" />، به بهتر شدن Tomi کمک کنید</translation>
<translation id="4050175100176540509">بهبودهای امنیتی مهم و ویژگی‌های جدید در جدیدترین نسخه در دسترس است.</translation>
<translation id="4148957013307229264">در حال نصب...</translation>
<translation id="419998258129752635">‏<ph name="PAGE_TITLE" /> - ورود به سیستم شبکه - Tomi</translation>
<translation id="421369550622382712">‏برنامه‌ها، بازی‌ها، افزونه‌ها و طرح‌های زمینه Tomi را کشف کنید.</translation>
<translation id="4216212958613226427">‏از این زبان برای نمایش واسط کاربر Tomi استفاده می‌شود</translation>
<translation id="4222932583846282852">درحال لغو کردن…</translation>
<translation id="4230135487732243613">‏داده‌های Tomi به این حساب مرتبط شود؟</translation>
<translation id="4271805377592243930">‏دریافت کمک برای Tomi</translation>
<translation id="4285930937574705105">‏به دلیل خطای نامشخص نصب ناموفق بود. اگر Tomi در حال اجرا است، لطفاً آن را ببندید و دوباره سعی کنید.</translation>
<translation id="4304713468139749426">مدیر گذرواژه</translation>
<translation id="4334294535648607276">بارگیری کامل شد.</translation>
<translation id="439358628917130594">‏<ph name="MANAGER" /> لازم می‌داند که شما «شرایط خدمات» زیر را قبل‌از استفاده از این دستگاه بخوانید و بپذیرید. این شرایط بسط داده نمی‌شود، اصلاح نمی‌شود، و شرایط Tomi OS را محدود نمی‌کند.</translation>
<translation id="4407044323746248786">‏درهرصورت از Tomi خارج می‌شوید؟</translation>
<translation id="4415566066719264597">‏اجازه به Tomi برای اجرا در پس‌زمینه</translation>
<translation id="4423735387467980091">‏سفارشی کردن و کنترل Tomi</translation>
<translation id="4427306783828095590">«محافظت بهبودیافته» کارهای بیشتری برای مسدود کردن رمزگیری و بدافزار انجام می‌دهد</translation>
<translation id="452711251841752011">‏به Tomi خوش‌آمدید؛ پنجره مرورگر جدید راه‌اندازی شد</translation>
<translation id="4544142686420020088">‏Tomi به‌روزرسانی نشد؛ مشکلی پیش آمد. <ph name="BEGIN_LINK" />مشکلات به‌روزرسانی Tomi و به‌روزرسانی‌های ناموفق را برطرف کنید.<ph name="END_LINK" /></translation>
<translation id="454579500955453258">‏در نمایه جدید Tomi ادامه می‌دهید؟</translation>
<translation id="4567424176335768812">با حساب <ph name="USER_EMAIL_ADDRESS" /> وارد سیستم شده‌اید. اکنون در همه دستگاه‌هایی که با آنها به سیستم وارد شده‌اید می‌توانید به نشانک‌ها، سابقه و دیگر تنظیماتتان دسترسی داشته باشید.</translation>
<translation id="4594305310729380060">در «مدیر گذرواژه» در این دستگاه</translation>
<translation id="459535195905078186">‏برنامه‌های Tomi</translation>
<translation id="4613863813562375431">‏نسخه TomiOS</translation>
<translation id="4621240073146040695">‏تقریباً به‌روز شده است! برای تمام کردن به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید.</translation>
<translation id="4665829708273112819">‏هشدار: Tomi نمی‌تواند مانع از ثبت سابقه مرورتان توسط افزونه‌ها شود. برای غیرفعال کردن این افزونه در «حالت ناشناس»، این گزینه را لغو انتخاب کنید.</translation>
<translation id="4673151026126227699">‏اگر گزارش‌های استفاده از Tomi را نیز هم‌رسانی کنید، این گزارش‌ها نشانی‌های وبی را که بازدید می‌کنید دربرمی‌گیرد</translation>
<translation id="4677944499843243528">‏ظاهراً نمایه توسط فرآیند Tomi دیگری (<ph name="PROCESS_ID" />) در رایانه‌ای دیگر (<ph name="HOST_NAME" />) در حال استفاده است. Tomi نمایه را قفل کرده است تا خراب نشود. اگر مطمئنید فرآیندهای دیگری از این نمایه استفاده نمی‌کنند، می‌توانید قفل نمایه را باز کنید و Tomi را مجدداً راه‌اندازی نمایید.</translation>
<translation id="4680828127924988555">لغو نصب</translation>
<translation id="4708774505295300557">‏شخصی قبلاً به‌عنوان <ph name="ACCOUNT_EMAIL_LAST" /> به سیستم Tomi در این رایانه وارد شده است. برای اینکه اطلاعاتتان جدا حفظ شود، لطفاً کاربر Tomi جدیدی ایجاد کنید.</translation>
<translation id="4746050847053251315">‏درهرصورت از Tomi خارج می‌شوید؟</translation>
<translation id="4748217263233248895">‏لحظاتی پیش به‌روزرسانی امنیتی ویژه‌ای برای Tomi اعمال شد. هم‌اکنون بازراه‌اندازی کنید و ما برگه‌هایتان را بازیابی خواهیم کرد.</translation>
<translation id="4765210420921718862">‏هروقت بخواهید می‌توانید در تنظیمات Tomi انتخابتان را تغییر دهید. دوره‌های آزمایشی به‌موازات روش کنونی ارائه آگهی اجرا می‌شود، بنابراین تغییرات بلافاصله ظاهر نمی‌شوند.</translation>
<translation id="4788777615168560705">‏Tomi نمی‌تواند گذرواژه‌هایتان را بررسی کند. بعد از ۲۴ ساعت دوباره امتحان کنید یا <ph name="BEGIN_LINK" />گذرواژه‌ها را در «حساب Tomi» خود بررسی کنید<ph name="END_LINK" />.</translation>
<translation id="479167709087336770">‏از همان غلط‌یاب املا استفاده می‌کند که در جستجوی Tomi استفاده می‌شود. نوشتاری که در مرورگر تایپ کرده‌اید برای Tomi ارسال می‌شود. هروقت بخواهید می‌توانید این رفتار را در تنظیمات تغییر دهید.</translation>
<translation id="4888717733111232871">‏قانون ترافیک ورودی برای Tomi جهت اجازه به ترافیک mDNS.</translation>
<translation id="4893347770495441059">‏راه‌اندازی مجدد برای به‌روزرسانی Tomi</translation>
<translation id="4943838377383847465">‏Tomi در حالت پس‌زمینه است.</translation>
<translation id="4987820182225656817">‏مهمان‌ها می توانند از Tomi استفاده کنند بدون این‌که اثری از خود به جا بگذارند.</translation>
<translation id="4994636714258228724">‏افرودن خودتان به Tomi</translation>
<translation id="5114678101347489141">‏Tomi ویژگی‌های جدیدی را کاوش می‌کند که به سایت‌ها اجازه می‌دهد بااستفاده از اطلاعات شخصی کمتر، همان تجربه مرور را ارائه دهند</translation>
<translation id="5224391634244552924">‏گذرواژه ذخیره‌شده‌ای وجود ندارد. Tomi زمانی می‌تواند گذرواژه‌هایتان را بررسی کند که آن‌ها را ذخیره کرده باشید.</translation>
<translation id="5252179775517634216">‏<ph name="EXISTING_USER" /> قبلاً به سیستم این نمایه Tomi وارد شده است. با این کار، نمایه Tomi جدیدی برای <ph name="USER_EMAIL_ADDRESS" /> ایجاد خواهد شد</translation>
<translation id="5277894862589591112">‏برای اعمال تغییراتتان، Tomi را راه‌اندازی مجدد کنید</translation>
<translation id="5296845517486664001">‏اگر نسخه آزمایشی روشن باشد و Tomi به‌طور تصادفی نسخه آزمایشی را برایتان فعال کرده باشد، سابقه مرورتان بر آگهی‌هایی که می‌بینید و علایقتان که در زیر برآورد شده است تأثیر می‌گذارد. برای محافظت از حریم خصوصی شما، Tomi علایقتان را هر ماه به‌طور چرخشی حذف می‌کند.</translation>
<translation id="5358375970380395591">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Tomi خود را می‌دهید. داده‌های Tomi شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Tomi حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. <ph name="LEARN_MORE" /></translation>
<translation id="5386450000063123300">‏درحال به‌روزرسانی Tomi (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="538767207339317086">‏مجاز کردن ورود به سیستم Tomi</translation>
<translation id="5398878173008909840">‏نسخه جدیدی از Tomi موجود است.</translation>
<translation id="5405650547142096840">‏حذف از Tomi</translation>
<translation id="5421879995290576427">{0,plural, =0{‏Tomi اکنون بسته می‌شود.}=1{‏Tomi تا یک ثانیه دیگر بسته می‌شود.}one{‏Tomi تا # ثانیه دیگر بسته می‌شود.}other{‏Tomi تا # ثانیه دیگر بسته می‌شود.}}</translation>
<translation id="5427571867875391349">‏تنظیم Tomi به عنوان مرورگر پیش‌فرضتان</translation>
<translation id="5438241569118040789"><ph name="PAGE_TITLE" /> - Tomi Beta</translation>
<translation id="5473971139929175403">‏Tomi ممکن است درست کار نکند زیرا این توزیع Linux دیگر از آن پشتیبانی نمی‌کند.</translation>
<translation id="5480860683791598150">‏Tomi برای هم‌رسانی مکانتان با این سایت باید به مکان شما دسترسی داشته باشد</translation>
<translation id="5487574057737591516">‏برای محافظت از حریم خصوصی شما، علایقی را که قدیمی‌تر از ۴ هفته باشند به‌طور خودکار حذف می‌کنیم. وقتی به مرور کردن ادامه می‌دهید، ممکن است علاقه‌ای مجدداً به فهرست اضافه شود. و اگر Tomi به‌اشتباه علاقه‌ای را اضافه کند یا شما نخواهید آگهی‌های مشخصی را ببینید، می‌توانید آن علاقه را بردارید.</translation>
<translation id="549669000822060376">‏وقتی Tomi جدیدترین به‌روزرسانی‌های سیستم را نصب می‌کند، لطفاً صبر کنید.</translation>
<translation id="5496810170689441661">‏Tomi می‌خواهد گذرواژه‌ها را ویرایش کند. برای اینکه اجازه دهید این کار انجام شود، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="5527463683072221100">‏باز کردن فایل‌های PDF در Tomi</translation>
