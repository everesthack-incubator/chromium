<!DOCTYPE translationbundle>
<translationbundle lang="fa">
<translation id="1026101648481255140">ازسر گرفتن نصب</translation>
<translation id="1029669172902658969">‏راه‌اندازی مجدد برای به‌روزرسانی TomiOS</translation>
<translation id="1065672644894730302">اولویت‌های شما را نمی‌توان خواند. بعضی ویژگی‌ها ممکن است در دسترس نباشند و تغییرات تنظیمات برگزیده ذخیره نخواهد شد.</translation>
<translation id="1098170124587656448">‏Tomi می‌تواند به ایمن ماندن شما در برابر نقض داده، افزونه‌های مخرب، و خطرهای دیگر کمک کند</translation>
<translation id="1104942323762546749">‏Tomi می‌خواهد گذرواژه‌های شما را صادر کند. برای اجازه به این کار، گذرواژه Windows خود را تایپ کنید.</translation>
<translation id="113122355610423240">‏Tomi مرورگر پیش‌فرضتان است</translation>
<translation id="1131805035311359397">‏برای بررسی اینکه از گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK" />به سیستم Tomi وارد شوید<ph name="END_LINK" />.</translation>
<translation id="1185134272377778587">‏درباره Tomi</translation>
<translation id="1203500561924088507">بابت نصب از شما سپاس‌گزاریم. قبل‌از استفاده از <ph name="BUNDLE_NAME" />، باید مرورگر را بازراه‌اندازی کنید.</translation>
<translation id="1231839967188101156">‏وقتی روشن باشد، Tomi حافظه را از برگه‌های غیرفعال آزاد می‌کند. با این کار، منابع بیشتری در رایانه به برگه‌ها و سایر برنامه‌ها اختصاص داده می‌شود و سرعت Tomi حفظ می‌شود. هرزمان به برگه‌های غیرفعال برگردید، به‌طور خودکار دوباره فعال می‌شوند. <ph name="BEGIN_LINK" />بیشتر بدانید<ph name="END_LINK" /></translation>
<translation id="1261119230216066228">‏«بهینه‌سازی حافظه» سرعت Tomi را بیشتر کرده است</translation>
<translation id="1315551408014407711">‏راه‌اندازی نمایه Tomi جدید</translation>
<translation id="1396446129537741364">‏Tomi می‌خواهد گذرواژه‌ها را نشان دهد.</translation>
<translation id="1414495520565016063">‏شما وارد سیستم Tomi شدید!</translation>
<translation id="1493803763272692301">‏می‌توانید از Tomi نهایت استفاده را ببرید</translation>
<translation id="1524282610922162960">‏هم‌رسانی برگه Tomi</translation>
<translation id="1553461853655228091">‏Tomi برای ایجاد نقشه سه‌بعدی محیط شما باید اجازه دسترسی به دوربین داشته باشد</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید}=1{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید. پنجره ناشناس بازگشایی نمی‌شود.}one{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}other{‏سرپرست سیستم لازم می‌داند برای اعمال به‌روزرسانی، Tomi را راه‌اندازی مجدد کنید. # پنجره ناشناس بازگشایی نمی‌شود.}}</translation>
<translation id="1625909126243026060">‏مرور کنترل‌های اصلی امنیت و حریم خصوصی در Tomi</translation>
<translation id="1632539827495546968">‏اگر می‌خواهید فقط یک‌بار از این حساب استفاده کنید، می‌توانید از <ph name="GUEST_LINK_BEGIN" />حالت مهمان<ph name="GUEST_LINK_END" /> در مرورگر Tomi استفاده کنید. اگر می‌خواهید برای شخص دیگری حساب اضافه کنید، به <ph name="DEVICE_TYPE" /> خود <ph name="LINK_BEGIN" />شخص جدیدی اضافه کنید<ph name="LINK_END" />.

اجازه‌هایی که قبلاً به وب‌سایت‌ها و برنامه‌ها داده‌اید ممکن است در این حساب اعمال شود. می‌توانید «حساب‌های Tomi» خود را در بخش <ph name="SETTINGS_LINK_BEGIN" />تنظیمات<ph name="SETTINGS_LINK_END" /> مدیریت کنید.</translation>
<translation id="1640672724030957280">در حال بارگیری…</translation>
<translation id="1708666629004767631">‏نسخه جدید و امن‌تری از Tomi موجود است.</translation>
<translation id="17264556997921157">‏می‌توانید موضوعات موردعلاقه را که سایت‌ها برای ارائه آگهی به شما استفاده می‌کنند ببینید یا حذف کنید. Tomi علایق شما را براساس سابقه مرور اخیرتان تخمین می‌زند.</translation>
<translation id="1774152462503052664">‏اجازه به Tomi برای اجرا در پس‌زمینه</translation>
<translation id="1779356040007214683">‏برای ایمن‌تر کردن Tomi، برخی از افزونه‌هایی را که در <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> فهرست شده‌اند و ممکن است بدون اطلاع شما اضافه شده باشند، غیرفعال کردیم.</translation>
<translation id="1808667845054772817">‏نصب مجدد Tomi</translation>
<translation id="185970820835152459">‏می‌توانید «حساب‌های Tomi» خودتان را که به سیستم آن‌ها وارد شده‌اید مدیریت کنید. از «حساب‌های Tomi» شما در مرورگر Tomi، «فروشگاه Play»، ‏Gmail، و محصولات دیگر استفاده می‌شود. اگر می‌خواهید حساب فرد دیگری را اضافه کنید (مثلاً یکی از اعضای خانواده)، به‌جای این کار، شخص جدیدی را به <ph name="DEVICE_TYPE" /> خود اضافه کنید. <ph name="LINK_BEGIN" />بیشتر بدانید<ph name="LINK_END" /></translation>
<translation id="1863308913976887472">‏سایت‌ها می‌توانند بااستفاده از Tomi اطلاعاتی درباره علایقتان ذخیره کنند. برای مثال، اگر برای خرید کفش مخصوص ماراتون از سایتی بازدید کنید، ممکن است آن سایت علاقه شما را به‌صورت دونده ماراتون مشخص کند. بعداً، اگر برای ثبت‌نام در مسابقه‌ای به سایتی دیگر مراجعه کردید، آن سایت می‌تواند براساس علایقتان آگهی‌ای برای کفش مخصوص دویدن به شما نشان دهد.</translation>
<translation id="1881322772814446296">‏شما با حساب مدیریت‌شده وارد سیستم می‌شوید و به سرپرست آن اجازه کنترل بر نمایه Tomi خود را می‌دهید. داده‌های Tomi شما شامل برنامه‌ها، نشانک‌ها، سابقه، گذرواژه‌ها و سایر تنظیمات برای همیشه به <ph name="USER_NAME" /> مرتبط خواهد شد. می‌توانید این داده‌ها را از طریق داشبورد حساب‌های Tomi حذف کنید اما نمی‌توانید این داده‌ها را به حساب دیگری مرتبط سازید. در صورت تمایل برای ذخیره داده‌های Tomi موجود به صورت جداگانه می‌توانید نمایه جدیدی ایجاد کنید. <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">‏با خاموش کردن این گزینه، می‌توانید بدون ورود به سیستم Tomi به سیستم سایت‌های Tomi مانند Gmail وارد شوید</translation>
<translation id="1929939181775079593">‏Tomi پاسخ نمی‌دهد. مجدداً راه‌اندازی شود؟</translation>
<translation id="193439633299369377">‏برای اعمال به‌روزرسانی، TomiOS باید بازراه‌اندازی شود.</translation>
<translation id="1940680973325097484">‏اگر می‌خواهید فقط یک‌بار از این حساب استفاده کنید، می‌توانید از «حالت مهمان» در مرورگر Tomi استفاده کنید. اگر می‌خواهید برای شخص دیگری حساب اضافه کنید، به <ph name="DEVICE_TYPE" /> خود <ph name="LINK_BEGIN" />شخص جدیدی اضافه کنید<ph name="LINK_END" />.

اجازه‌هایی که قبلاً به وب‌سایت‌ها و برنامه‌ها داده‌اید ممکن است در این حساب اعمال شود. می‌توانید «حساب‌های Tomi» خود را در بخش <ph name="SETTINGS_LINK_BEGIN" />تنظیمات<ph name="SETTINGS_LINK_END" /> مدیریت کنید.</translation>
<translation id="1953553007165777902">درحال بارگیری… <ph name="MINUTE" /> دقیقه باقی مانده است</translation>
<translation id="1966382378801805537">‏Tomi نمی‌تواند مرورگر پیش‌فرض را تعیین یا تنظیم کند</translation>
<translation id="2008474315282236005">‏این کار یک مورد را از این دستگاه حذف می‌کند. برای بازیابی داده‌هایتان در فرصتی دیگر، با <ph name="USER_EMAIL" /> به سیستم Tomi وارد شوید.</translation>
<translation id="2018879682492276940">نصب تکمیل نشد. لطفاً دوباره امتحان کنید.</translation>
<translation id="2020032459870799438">‏برای بررسی اینکه از دیگر گذرواژه‌هایتان دربرابر نقض داده یا دیگر مشکلات امنیتی محافظت می‌شود، <ph name="BEGIN_LINK" />به سیستم Tomi وارد شوید<ph name="END_LINK" />.</translation>
<translation id="2049376729098081731">‏انتخاب کنید که آیا سابقه Tomi برای تجربه‌های شخصی‌شده‌تر در سرویس‌های Tomi لحاظ شود یا نه</translation>
<translation id="2088953378266246249">‏اطلاعات مربوط به اینکه Tomi چگونه گواهینامه‌های ریشه‌اش را مدیریت می‌کند</translation>
<translation id="2174178932569897599">‏سفارشی کردن Tomi</translation>
<translation id="2174917724755363426">نصب کامل نیست. مطمئنید می‌خواهید آن را لغو کنید؟</translation>
<translation id="2185166961232948079">‏Tomi - ورود به سیستم شبکه - <ph name="PAGE_TITLE" /></translation>
<translation id="2241627712206172106">‏اگر رایانه‌ای را به صورت مشترک استفاده می‌کنید، دوستان و خانواده می‌توانند به صورت جداگانه مرور کنند و Tomi را به صورتی که مایلند تنظیم کنند.</translation>
<translation id="2313870531055795960">‏نشانی‌های وب را با فهرست سایت‌های ناامنی که در Tomi ذخیره شده است مقایسه می‌کند. اگر سایتی تلاش کند گذرواژه شما را به‌سرقت ببرد، یا وقتی فایل مخربی بارگیری می‌کنید، Tomi ممکن است نشانی‌های وب را نیز به‌همراه بخش‌های کوچکی از محتوای صفحه به «مرور ایمن» ارسال کند.</translation>
<translation id="2343156876103232566">‏برای ارسال شماره از اینجا به تلفن Android خود، در هر دو دستگاه به سیستم Tomi وارد شوید.</translation>
<translation id="2347108572062610441">‏این افزونه، صفحه‌ای را تغییر داده است که هنگام راه‌اندازی Tomi نشان داده می‌شود.</translation>
<translation id="2359808026110333948">ادامه</translation>
<translation id="2384373936468275798">‏TomiOS نتوانست داده‌های شما را همگام‌سازی کند زیرا جزئیات ورود به حساب شما به‌روز نیست.</translation>
<translation id="2396765026452590966">‏افزونه «<ph name="EXTENSION_NAME" />»، صفحه‌ای را تغییر داده است که هنگام راه‌اندازی Tomi نشان داده می‌شود.</translation>
<translation id="2401032172288869980">‏Tomi برای این سایت به اجازه دوربین و میکروفون نیاز دارد</translation>
<translation id="2483889755041906834">‏در Tomi</translation>
<translation id="2485422356828889247">حذف نصب</translation>
<translation id="2560420686485554789">‏Tomi برای بارگیری فایل‌ها باید به حافظه دسترسی داشته باشد</translation>
<translation id="2572494885440352020">Tomi Helper</translation>
<translation id="2583187216237139145">‏سرپرست نمایه کاری می‌تواند داده‌های Tomi را که درطول استفاده از این نمایه ایجاد شده‌اند (مثل ایجاد سابقه نشانک‌ها، گذرواژه‌ها، و دیگر تنظیمات) بردارد. <ph name="LEARN_MORE" /></translation>
<translation id="2592940277904433508">‏ادامه استفاده از Tomi</translation>
<translation id="2648074677641340862">‏یک خطای سیستم‌عامل در طول نصب روی داد. لطفاً Tomi را دوباره نصب کنید.</translation>
<translation id="2661879430930417727">‏اگر از دستگاهی به‌صورت مشترک استفاده می‌کنید، دوستان و اعضای خانواده می‌توانند جداگانه مرور کنند و Tomi را به‌شیوه خودشان تنظیم کنند</translation>
<translation id="2669853942967761236">‏Tomi این فایل بایگانی را مسدود کرده است چون ممکن است بدافزار پنهان کرده باشد</translation>
<translation id="268602741124540128">‏<ph name="ACCOUNT_FIRST_NAME" /> به Tomi خوش آمدید</translation>
<translation id="2711502716910134313">‏برگه Tomi</translation>
<translation id="2718390899429598676">‏برای امنیت بیشتر، Tomi داده‌های شما را رمزگذاری می‌کند.</translation>
<translation id="2770231113462710648">تغییر مرورگر پیش‌فرض به:</translation>
<translation id="2799223571221894425">راه‌اندازی مجدد</translation>
<translation id="2837693172913560447">‏با این کار، نمایه Tomi جدیدی برای <ph name="USER_EMAIL_ADDRESS" /> ایجاد خواهد شد</translation>
<translation id="2847479871509788944">‏حذف از Tomi...</translation>
<translation id="2850691299438350830">‏وقتی به سیستم وارد شده باشید، امنیت شما را در Tomi حفظ می‌کند و ممکن است برای بهبود امنیت شما در برنامه‌های دیگر Tomi استفاده شود</translation>
