<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="gu">
<translation id="1001534784610492198">ઇન્સ્ટૉલર આર્કાઇવ ખરાબ છે અથવા અમાન્ય છે. કૃપા કરીને Tomi ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="1026101648481255140">ઇન્સ્ટૉલેશનની પ્રક્રિયા ફરી શરૂ કરો</translation>
<translation id="102763973188675173">Tomiને કસ્ટમાઇઝ અને નિયંત્રિત કરો. અપડેટ ઉપલબ્ધ છે.</translation>
<translation id="1051826050538111504">તમારા કમ્પ્યુટરમાં નુકસાનકારક સૉફ્ટવેર છે. Tomi તે કાઢી નાખી શકે છે, તમારી સેટિંગ પાછી મેળવી શકે છે અને એક્સ્ટેંશન બંધ કરી શકે છે જેથી તમારું બ્રાઉઝર ફરી સામાન્ય રીતે કામ કરી શકે.</translation>
<translation id="1065672644894730302">તમારી પસંદગીઓને વાંચી શકાતી નથી.

કેટલીક સુવિધાઓ ઉપલબ્ધ હોઈ શકે છે અને પસંદગીઓ પરના ફેરફારોને સાચવવામાં આવશે નહીં.</translation>
<translation id="1088300314857992706"><ph name="USER_EMAIL_ADDRESS" />, પહેલાં Tomi નો ઉપયોગ કરી રહ્યાં હતાં</translation>
<translation id="110877069173485804">આ તમારું Tomi છે</translation>
<translation id="1125124144982679672">કોણ Tomiનો ઉપયોગ કરે છે?</translation>
<translation id="1142745911746664600">Tomi અપડેટ કરી શકતાં નથી</translation>
<translation id="1152920704813762236">TomiOS વિશે</translation>
<translation id="1154147086299354128">&amp;Tomiમાં ખોલો</translation>
<translation id="1203500561924088507">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારે તમારું બ્રાઉઝર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="1236866257838264361">તમે Tomiનો મહત્તમ લાભ મેળવી શકો છો</translation>
<translation id="1278833599417554002">&amp;Tomi અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="1302523850133262269">કૃપા કરીને Tomi નવીનતમ સિસ્ટમ અપડેટ્સ ઇન્સ્ટોલ કરે ત્યાં સુધી રાહ જુઓ.</translation>
<translation id="1335640173511558774"><ph name="MANAGER" /> માટે જરૂરી છે કે તમે આ ડિવાઇસનો ઉપયોગ કરતા પહેલાં નીચેની સેવાની શરતો વાંચો અને સ્વીકારો. આ શરતો TomiOS Flexની શરતોને વધારતી નથી, તેમાં ફેરફાર કરતી નથી અથવા તેને મર્યાદિત કરતી નથી.</translation>
<translation id="1363996462118479832">સાઇન ઇનમાં થયેલી ભૂલને કારણે TomiOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="137466361146087520">Tomi બીટા</translation>
<translation id="1399397803214730675">આ કમ્પ્યુટર પર પહેલેથી જ Tomiનું વધુ તાજેતરનું વર્ઝન છે. જો સૉફ્ટવેર કામ ન કરતું હોય, તો કૃપા કરીને Tomiને અનઇન્સ્ટૉલ કરો અને ફરી પ્રયાસ કરો.</translation>
<translation id="139993653570221430">તમે Tomi સેટિંગમાં જઈને કોઈપણ સમયે તમારો નિર્ણય બદલી શકો છો. જાહેરાતો આપવાની વર્તમાન રીતની સાથેસાથે અજમાયશો ચાલે છે, તેથી તમને ફેરફારો તરત જ દેખાશે નહીં.</translation>
<translation id="1434626383986940139">Tomi કેનેરી ઍપ્લિકેશનો</translation>
<translation id="1507198376417198979">તમારી નવી Tomi પ્રોફાઇલ કસ્ટમાઇઝ કરો</translation>
<translation id="1516530951338665275">જોડાણ કરવાનું ચાલુ રાખવા માટે, Tomiને બ્લૂટૂથના ઍક્સેસની 
 જરૂર છે. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1547295885616600893">TomiOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="1553358976309200471">Tomi અપડેટ કરો</translation>
<translation id="1583073672411044740"><ph name="EXISTING_USER" /> આ Tomi પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. આને લીધે <ph name="USER_EMAIL_ADDRESS" /> માટે નવી Tomi પ્રોફાઇલ બનશે</translation>
<translation id="1587223624401073077">Tomi તમારા કૅમેરાનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="1587325591171447154"><ph name="FILE_NAME" /> જોખમી છે, તેથી Tomi એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="1597911401261118146">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK" />Tomiમાં સાઇન ઇન કરો<ph name="END_LINK" />.</translation>
<translation id="1599904803480101533">Tomi દ્વારા આ આર્કાઇવ ફાઇલ બ્લૉક કરવામાં આવી કારણ કે તેમાં માલવેર છુપાવેલા હોઈ શકે છે</translation>
<translation id="1619887657840448962">Tomi ને સુરક્ષિત બનાવવા માટે, અમે નીચેના એક્સ્ટેન્શનને અક્ષમ કર્યું છે કે જે <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યું હોઈ શકે છે.</translation>
<translation id="1627304841979541023"><ph name="BEGIN_BOLD" />તમે તમારો ડેટા કેવી રીતે મેનેજ કરી શકો છો:<ph name="END_BOLD" /> તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે, અમે 4 અઠવાડિયા કરતાં જૂની હોય એવી તમારી રુચિઓને ઑટોમૅટિક રીતે ડિલીટ કરીએ છીએ. તમે જેમ જેમ બ્રાઉઝ કરતા રહો છો, તેમ તેમ તમારી રુચિનો વિષય ફરી સૂચિમાં દેખાઈ શકે છે. અથવા તમે તમારી રુચિના એવા વિષયો કાઢી નાખી શકો છો કે જેમને તમે Tomiની સૂચિમાં શામેલ કરવા માગતા નથી.</translation>
<translation id="1628000112320670027">Tomi સાથે સહાય મેળવો</translation>
<translation id="1640672724030957280">ડાઉનલોડ કરી રહ્યું છે...</translation>
<translation id="1662146548738125461">TomiOS Flex વિશે</translation>
<translation id="1674870198290878346">Tomi છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="1682634494516646069">Tomi એની ડેટા ડિરેક્ટરી વાંચી અથવા લખી શકતુંં નથી:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1691802391966922744">{COUNT,plural, =1{તમારા ઍડમિનિસ્ટ્રેટરે Tomiની એ રીતે ગોઠવણી કરી છે કે જો તે 1 મિનિટ કરતાં વધારે સમય સુધી નિષ્ક્રિય રહે, તો બંધ થઈ જશે.}one{તમારા ઍડમિનિસ્ટ્રેટરે Tomiની એ રીતે ગોઠવણી કરી છે કે જો તે # મિનિટ કરતાં વધારે સમય સુધી નિષ્ક્રિય રહે, તો બંધ થઈ જશે.}other{તમારા ઍડમિનિસ્ટ્રેટરે Tomiની એ રીતે ગોઠવણી કરી છે કે જો તે # મિનિટ કરતાં વધારે સમય સુધી નિષ્ક્રિય રહે, તો બંધ થઈ જશે.}}</translation>
<translation id="1698376642261615901">Tomi એ એક એવું વેબ બ્રાઉઝર છે જે પ્રકાશની ગતિએ વેબપૃષ્ઠો અને એપ્લિકેશંસને ચલાવે છે. તે ઝડપી, સ્થિર અને ઉપયોગમાં સરળ છે. Tomi માં નિર્મિત મૉલવેર અને ફિશીંગ સુરક્ષા સાથે વેબને વધુ સુરક્ષિત રૂપે બ્રાઉઝ કરો.</translation>
<translation id="1713301662689114961">{0,plural, =1{Tomi એક કલાકમાં ફરીથી લૉન્ચ થશે}one{Tomi # કલાકમાં ફરીથી લૉન્ચ થશે}other{Tomi # કલાકમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="1734234790201236882">Tomi આ પાસવર્ડ તમારા Tomi એકાઉન્ટમાં સાચવશે. તમારે તેને યાદ રાખવો જરૂરી નથી.</translation>
<translation id="1759842336958782510">Tomi</translation>
<translation id="1786003790898721085">ખાતરી કરો કે તમે તમારા <ph name="TARGET_DEVICE_NAME" /> પર Tomiમાં સાઇન ઇન કર્યું છે અને પછી ફરીથી મોકલવાનો પ્રયાસ કરો.</translation>
<translation id="1812689907177901597">આને બંધ કરવાથી, તમે Tomiમાં સાઇન ઇન કર્યા સિવાય Gmail જેવી Tomiની સાઇટમાં સાઇન ઇન કરી શકશો</translation>
<translation id="1860536484129686729">Tomiને આ સાઇટ માટે તમારા કૅમેરાના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="1873233029667955273">Tomi તમારું ડિફૉલ્ટ બ્રાઉઝર નથી</translation>
<translation id="1874309113135274312">Tomi બીટા (mDNS-In)</translation>
<translation id="1877026089748256423">Tomi જૂનું થઈ ગયું છે</translation>
<translation id="1919130412786645364">Tomiમાં સાઇન-ઇનની મંજૂરી આપો</translation>
<translation id="1952239763774043237">Tomiની ભાવિ અપડેટ મેળવવા માટે, તમારે macOS 10.13 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર macOS 10.12નો ઉપયોગ કરે છે.</translation>
<translation id="1953553007165777902">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="MINUTE" /> મિનિટ બાકી છે</translation>
<translation id="2018528049276128029">દરેક પ્રોફાઇલ બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજી ઘણી બાબતો જેવી તેની પોતાની Tomi માહિતી ધરાવે છે</translation>
<translation id="2018879682492276940">ઇન્સ્ટૉલ કરવામાં નિષ્ફળ રહ્યાં. કૃપા કરીને ફરી પ્રયાસ કરો.</translation>
<translation id="2071318482926839249">તમે પહેલેથી જ અન્ય એકાઉન્ટમાં સાઇન કરેલું છે. તમારું બ્રાઉઝિંગ અલગ રાખવા, Tomi તમારા માટે તમારી અલગ પ્રોફાઇલ બનાવી શકે છે.</translation>
<translation id="207902854391093810">અજમાયશો ચાલુ હોય ત્યારે, Ad measurement તમે જેની મુલાકાત લો છો તે સાઇટને Tomi પાસેથી માહિતીની વિનંતી કરવાની મંજૂરી આપે છે, જે સાઇટને તેની જાહેરાતોનું કાર્યપ્રદર્શન માપવામાં સહાય કરે છે. Ad measurement સાઇટ વચ્ચે શક્ય તેટલી ઓછી માહિતી ટ્રાન્સફર કરીને, સાઇટ દ્વારા પરસ્પરના ટ્રૅકિંગને પ્રતિબંધિત કરે છે.</translation>
<translation id="2091012649849228750">Tomiની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 8નો ઉપયોગ કરે છે.</translation>
<translation id="2094648590148273905">TomiOS Flexની શરતો</translation>
<translation id="2094919256425865063">છતાં પણ Tomi બંધ કરવું છે?</translation>
<translation id="2106831557840787829"><ph name="BEGIN_LINK_LINUX_OSS" />Linux ડેવલપમેન્ટ એન્વાયરમેન્ટ<ph name="END_LINK_LINUX_OSS" />ની જેમ, TomiOS Flex વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બન્યું છે.</translation>
<translation id="2120620239521071941">આ, <ph name="ITEMS_COUNT" /> આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Tomiમાં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="2121284319307530122">&amp;Tomi અપડેટ કરવા માટે, ફરીથી લૉન્ચ કરો</translation>
<translation id="2123055963409958220"><ph name="BEGIN_LINK" />વર્તમાન સેટિંગ<ph name="END_LINK" />ની જાણ કરીને Tomiને બહેતર બનાવવામાં સહાય કરો</translation>
<translation id="2131230230468101642">તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે, અમે 4 અઠવાડિયા કરતાં જૂની હોય એવી તમારી રુચિઓને ઑટોમૅટિક રીતે ડિલીટ કરીએ છીએ. તમે જેમ જેમ બ્રાઉઝ કરતા રહો છો, તેમ તેમ તમારી રુચિનો વિષય ફરી સૂચિમાં દેખાઈ શકે છે. અથવા તમે તમારી રુચિના એવા વિષયો કાઢી નાખી શકો છો કે જેમને તમે Tomiની સૂચિમાં શામેલ કરવા માગતા નથી.</translation>
<translation id="2139300032719313227">TomiOS ફરી શરૂ કરો</translation>
<translation id="2151406531797534936">કૃપા કરીને હવે Tomi ફરી શરૂ કરો</translation>
<translation id="2174917724755363426">ઇન્સ્ટૉલેશનની પ્રક્રિયા પૂર્ણ થઈ નથી. શું તમે ખરેખર રદ કરવા માગો છો?</translation>
<translation id="223889379102603431">Tomi તેના રૂટ પ્રમાણપત્રો કેવી રીતે મેનેજ કરે છે તે વિશેની માહિતી</translation>
<translation id="2258103955319320201">Tomi બ્રાઉઝર પરની તમારી વસ્તુઓને તમારા બધા ડિવાઇસ પર ઍક્સેસ કરવા માટે, સાઇન ઇન કરો અને પછી સિંક કરવાની સુવિધા ચાલુ કરો</translation>
<translation id="2290014774651636340">Tomi API કીઝ ખૂટે છે. Tomi ની કેટલીક કાર્યક્ષમતા અક્ષમ થશે.</translation>
<translation id="2290095356545025170">શું તમને ખાતરી છે કે તમારે Tomiને અનઇન્સ્ટૉલ કરવું છે?</translation>
<translation id="2309047409763057870">આ Tomi નું દ્વિતીય ઇન્સ્ટૉલેશન છે અને આને તમારું ડિફૉલ્ટ બ્રાઉઝર બનાવી શકાતું નથી.</translation>
<translation id="2345992953227471816">Tomiને આ એક્સ્ટેન્શનમાં માલવેર હોવાનું જાણવા મળ્યું છે:</translation>
<translation id="2348335408836342058">Tomiને આ સાઇટ માટે તમારા કૅમેરા અને માઇક્રોફોનના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="234869673307233423">Tomi તમારા પાસવર્ડ ચેક કરી શકતું નથી. થોડા સમય પછી ફરી પ્રયાસ કરો.</translation>
<translation id="235650106824528204">આ પ્રોફાઇલના ઉપયોગ (જેમકે બુકમાર્ક, ઇતિહાસ, પાસવર્ડ બનાવવા અને અન્ય સેટિંગ ગોઠવવા) દરમિયાન જનરેટ થયેલા કોઈપણ Tomi ડેટાને ઑફિસની પ્રોફાઇલના વ્યવસ્થાપક કાઢી નાખી શકે છે. <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">આગળ વધો</translation>
<translation id="2401189691232800402">TomiOS સિસ્ટમ</translation>
<translation id="2467438592969358367">Tomi તમારા પાસવર્ડની નિકાસ કરવા માગે છે. આને મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ ટાઇપ કરો.</translation>
<translation id="2485422356828889247">અનઇન્સ્ટૉલ કરો</translation>
<translation id="2534507159460261402">Tomi Pay (Tomi પર કૉપિ કરેલ છે)</translation>
<translation id="2559253115192232574">પછી, તમે જેની મુલાકાત લો તે સાઇટ Tomiને તમારી રુચિઓ જોવા માટે કહી શકે છે, જેથી તમને જોવા મળતી જાહેરાતોને મનગમતી બનાવી શકાય. Tomi વધુમાં વધુ 3 રુચિ શેર કરી શકે છે.</translation>
<translation id="2563121210305478421">Tomi ફરીથી લૉન્ચ કરીએ?</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> આ Tomi પ્રોફાઇલમાં પહેલેથી સાઇન ઇન છે. તમારું બ્રાઉઝિંગ અલગ રાખવા, Tomi તમારા માટે તમારી અલગ પ્રોફાઇલ બનાવી શકે છે.</translation>
<translation id="2580411288591421699">હાલમાં ચાલી રહ્યું છે તે જ Tomi વર્ઝનને ઇન્સ્ટૉલ કરી શકાતું નથી. કૃપા કરીને Tomi બંધ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="2586406160782125153">આ, તમારા બ્રાઉઝિંગ ડેટાને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Tomiમાં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="2597976513418770460"><ph name="ACCOUNT_EMAIL" />માંથી તમારા Tomi બ્રાઉઝરની વસ્તુઓ મેળવો</translation>
<translation id="2622559029861875898">Tomi અપડેટ ચેક કરી શકતું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="2645435784669275700">TomiOS</translation>
<translation id="2652691236519827073">નવા Tomi &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="2665296953892887393">ક્રૅશ રિપોર્ટ અને <ph name="UMA_LINK" /> Tomiને મોકલીને Tomiને વધુ સારું બનાવવામાં મદદ કરો.</translation>
<translation id="2689103672227170538">જ્યારે તમે Tomi શરૂ કરો છો ત્યારે જે પેજ દર્શાવવામાં આવે છે તે આ એક્સટેન્શને બદલ્યું છે.</translation>
<translation id="2742320827292110288">ચેતવણી: Tomi તમારો બ્રાઉઝિંગ ઇતિહાસ રેકોર્ડ કરવાથી એક્સ્ટેન્શનને અટકાવી શકતું નથી. છૂપા મોડમાં આ એક્સ્ટેન્શનને બંધ કરવા માટે, આ વિકલ્પની પસંદગીને નાપસંદ કરો.</translation>
<translation id="2765403129283291972">Tomiને આ સાઇટ માટે તમારા માઇક્રોફોનના ઍક્સેસની પરવાનગીની જરૂર પડે છે</translation>
<translation id="2770231113462710648">ડિફૉલ્ટ બ્રાઉઝરને આના પર બદલો:</translation>
<translation id="2775140325783767197">Tomi તમારા પાસવર્ડ ચેક કરી શકતું નથી. તમારું ઇન્ટરનેટ કનેક્શન ચેક કરવાનો પ્રયાસ કરો.</translation>
<translation id="2799223571221894425">ફરીથી લોંચ કરો</translation>
<translation id="2847461019998147611">આ ભાષામાં Tomi બતાવો</translation>
<translation id="2857540653560290388">Tomi લૉન્ચ કરી રહ્યાં છીએ…</translation>
<translation id="2857972467023607093">આ એકાઉન્ટ સાથેની Tomi પ્રોફાઇલ પહેલેથી અસ્તિત્વમાં છે</translation>
<translation id="2861074815332034794">Tomi અપડેટ કરી રહ્યાં છીએ (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">તમે હમણાં Tomi માં સાઇન ઇન છો!</translation>
<translation id="2885378588091291677">કાર્ય વ્યવસ્થાપક</translation>
<translation id="2888126860611144412">Tomi વિશે</translation>
<translation id="2915996080311180594">પછીથી ફરી શરૂ કરો</translation>
<translation id="2926676257163822632">નબળા પાસવર્ડનું અનુમાન કરવું સરળ હોય છે. Tomiને <ph name="BEGIN_LINK" />તમારા માટે સશક્ત પાસવર્ડ બનાવવા અને યાદ રાખવા<ph name="END_LINK" />ની મંજૂરી આપો.</translation>
<translation id="2926952073016206995">આ સાઇટ માટે Tomiને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="2928420929544864228">ઇન્સ્ટૉલેશનની પ્રક્રિયા પૂર્ણ થઈ.</translation>
<translation id="2929907241665500097">કંઈક ખોટુ થયું હોવાને કારણે Tomi અપડેટ કરી શકાયું નથી. <ph name="BEGIN_LINK" />Tomi અપડેટ કરવામાં આવતી સમસ્યાઓ અને નિષ્ફળ થયેલા અપડેટ સુધારો.<ph name="END_LINK" /></translation>
<translation id="2969728957078202736"><ph name="PAGE_TITLE" /> - નેટવર્ક સાઇન ઇન - Tomi</translation>
<translation id="3019382870990049182">&amp;TomiOS Flex અપડેટ કરવા માટે ફરીથી લૉન્ચ કરો</translation>
<translation id="303514781271618814">Tomi એવી સુવિધાઓની શોધખોળ કરી રહ્યું છે જે તમારા ડેટાના મર્યાદિત ઉપયોગ વડે પણ સાઇટને બ્રાઉઝિંગનો પહેલાં જેવો જ અનુભવ પ્રદાન કરી શકે</translation>
<translation id="3037838751736561277">Tomi બૅકગ્રાઉન્ડ મોડમાં છે.</translation>
<translation id="3038232873781883849">ઇન્સ્ટૉલ થવાની રાહ જોઈ રહ્યાં છીએ...</translation>
<translation id="3059710691562604940">Safe Browsingની સુવિધા બંધ છે. Tomi તેને ચાલુ રાખવાનો સુઝાવ આપે છે.</translation>
<translation id="3065168410429928842">Tomi ટૅબ</translation>
<translation id="3080151273017101988">જ્યારે Tomi બંધ થાય ત્યારે બૅકગ્રાઉન્ડમાં ઍપ ચલાવવાનું ચાલુ રાખો</translation>
<translation id="3089968997497233615">Tomiનું નવું, સુરક્ષિત વર્ઝન ઉપલબ્ધ છે.</translation>
<translation id="3100998948628680988">તમારી Tomi પ્રોફાઇલને નામ આપો</translation>
<translation id="3114643501466072395">ડેટા ઉલ્લંઘન અને અન્ય સુરક્ષાની સમસ્યાથી તમારા અન્ય પાસવર્ડ સુરક્ષિત છે કે નહીં તે ચેક કરવા માટે, <ph name="BEGIN_LINK" />Tomiમાં સાઇન ઇન કરો<ph name="END_LINK" />.</translation>
<translation id="3140883423282498090">તમે આગલી વખત Tomi ને ફરીથી શરૂ કરશો ત્યારે તમારા ફેરફારો પ્રભાવી થશે.</translation>
<translation id="3149510190863420837">Tomi ઍપ્લિકેશનો</translation>
<translation id="3169523567916669830">અજમાયશો દરમિયાન, તમે રુચિના એ વિષયોને જોઈ અને કાઢી નાખી શકો છો કે જેનો ઉપયોગ સાઇટ દ્વારા તમને જાહેરાતો બતાવવા માટે કરવામાં આવ્યો હતો. Tomi તમારા તાજેતરના બ્રાઉઝિંગ ઇતિહાસના આધારે તમારી રુચિઓનું અનુમાન લગાવે છે.</translation>
<translation id="3211604354460514046">{NUM_DEVICES,plural, =1{Tomiને HID ડિવાઇસ સાથે કનેક્ટ કરેલું છે}one{Tomiને HID ડિવાઇસ સાથે કનેક્ટ કરેલું છે}other{Tomiને HID ડિવાઇસ સાથે કનેક્ટ કરેલું છે}}</translation>
<translation id="3245429137663807393">જો તમે Tomiના વપરાશના રિપોર્ટ પણ શેર કરતા હો, તો તે રિપોર્ટમાં તમે મુલાકાત લો છો તે URLs શામેલ હોય છે</translation>
<translation id="3282568296779691940">Tomi માં સાઇન ઇન કરો</translation>
<translation id="3286538390144397061">હવે ફરીથી પ્રારંભ કરો</translation>
<translation id="3360895254066713204">Tomi સહાયક</translation>
<translation id="3379938682270551431">{0,plural, =0{Tomi હમણાં ફરીથી લૉન્ચ થશે}=1{Tomi 1 સેકન્ડમાં ફરીથી લૉન્ચ થશે}one{Tomi # સેકન્ડમાં ફરીથી લૉન્ચ થશે}other{Tomi # સેકન્ડમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="3396977131400919238">ઇન્સ્ટૉલેશન દરમિયાન એક ઑપરેટિંગ સિસ્ટમની ભૂલ આવી. કૃપા કરીને Tomi ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="3426646014273736870">મેમરી સેવર દ્વારા Tomiને વધુ ઝડપી બનાવવામાં આવ્યું</translation>
<translation id="3428747202529429621">તમને Tomi પર સલામત રાખે છે અને જ્યારે તમે સાઇન ઇન થયા હો, ત્યારે Tomiની અન્ય ઍપમાં તમારી સુરક્ષા બહેતર બનાવવામાં ઉપયોગમાં લેવાઈ શકે છે</translation>
<translation id="3434246496373299699">જ્યારે તમે તમારા Tomi એકાઉન્ટ વડે સાઇન ઇન કરો ત્યારે Tomi તમારા પાસવર્ડ ચેક કરી શકે છે</translation>
<translation id="3451115285585441894">Tomi માં ઉમેરી રહ્યું છે...</translation>
<translation id="345171907106878721">સ્વયંને Tomi માં ઉમેરો</translation>
<translation id="3453763134178591239">TomiOSની શરતો</translation>
<translation id="34857402635545079">Tomiમાંથી પણ ડેટા કાઢી નાખો (<ph name="URL" />)</translation>
<translation id="3503306920980160878">Tomiને આ સાઇટ સાથે તમારું સ્થાન શેર કરવા માટે તમારા સ્થાનના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="3533694711092285624">કોઈ સાચવેલો પાસવર્ડ નથી. જ્યારે તમે તમારા પાસવર્ડ સાચવો ત્યારે Tomi તેને ચેક કરી શકે છે.</translation>
<translation id="3541482654983822893">Tomi તમારા પાસવર્ડ ચેક કરી શકતું નથી. 24 કલાક પછી ફરી પ્રયાસ કરો.</translation>
<translation id="3576528680708590453">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME" />ને ઍક્સેસ કરવા Tomiને વૈકલ્પિક બ્રાઉઝર ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="3579965087968408543">જ્યારે તમે Tomi બંધ કરો, ત્યારે હંમેશાં તમારા ડિવાઇસમાંથી સાઇટનો ડેટા સાફ કરો</translation>
<translation id="3582972582564653026">તમારા બધા ડિવાઇસ પર Tomiને સિંક કરો અને મનગમતું બનાવો</translation>
<translation id="3596080736082218006">{COUNT,plural, =0{અપડેટ લાગુ કરવા માટે તમે Tomiને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે}=1{અપડેટ લાગુ કરવા માટે તમે Tomiને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{અપડેટ લાગુ કરવા માટે તમે Tomiને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{અપડેટ લાગુ કરવા માટે તમે Tomiને ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપક ઇચ્છે છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="3622797965165704966">હવે તમારા Tomi એકાઉન્ટ સાથે અને શેર કરેલા કમ્પ્યુટર પર Tomiનો ઉપયોગ કરવો વધુ સરળ છે.</translation>
<translation id="3673813398384385993">Tomiને "<ph name="EXTENSION_NAME" />"માં માલવેર હોવાનું જાણવા મળ્યું છે</translation>
<translation id="3703994572283698466"><ph name="BEGIN_LINK_LINUX_OSS" />Linux ડેવલપમેન્ટ એન્વાયરમેન્ટ<ph name="END_LINK_LINUX_OSS" />ની જેમ, TomiOSને વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બનાવવામાં આવ્યું છે.</translation>
<translation id="3716540481907974026">TomiOS Flexનું વર્ઝન</translation>
<translation id="3718181793972440140">આ, 1 આઇટમને આ ડિવાઇસમાંથી ડિલીટ કરશે. પછીથી તમારો ડેટા ફરીથી મેળવવા માટે, Tomiમાં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="3735758079232443276">જ્યારે તમે Tomi શરૂ કરો છો ત્યારે જે પેજ દર્શાવવામાં આવે છે તે <ph name="EXTENSION_NAME" /> એક્સટેન્શને બદલ્યું છે.</translation>
<translation id="3744202345691150878">TomiOS વડે સહાય મેળવો</translation>
<translation id="3780814664026482060">Tomi - <ph name="PAGE_TITLE" /></translation>
<translation id="3785324443014631273">સાઇન ઇન કરવામાં ભૂલ આવવાને કારણે, TomiOS Flex તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="3795971588916395511">TomiOS</translation>
<translation id="3835168907083856002">આને લીધે <ph name="USER_EMAIL_ADDRESS" /> માટે નવી Tomi પ્રોફાઇલ બનશે</translation>
<translation id="386202838227397562">કૃપા કરીને બધી Tomi વિંડોઝ બંધ કરો અને ફરીથી પ્રયાસ કરો.</translation>
<translation id="3865754807470779944">Tomiનું <ph name="PRODUCT_VERSION" /> વર્ઝન ઇન્સ્ટૉલ કરવામાં આવેલું છે</translation>
<translation id="3873044882194371212">Tomi છુ&amp;પી વિંડોમાં લિંક ખોલો</translation>
<translation id="3889417619312448367">Tomiને અનઇન્સ્ટૉલ કરો</translation>
<translation id="3999683152997576765">તમે રુચિના એ વિષયોને જોઈ અને કાઢી નાખી શકો છો કે જેનો ઉપયોગ સાઇટ તમને જાહેરાતો બતાવવા માટે કરે છે. Tomi તમારા તાજેતરના બ્રાઉઝિંગ ઇતિહાસના આધારે તમારી રુચિઓનું અનુમાન લગાવે છે.</translation>
<translation id="4035053306113201399">અપડેટ લાગુ કરવા માટે TomiOSને ફરી શરૂ કરવાની જરૂર છે.</translation>
<translation id="4050175100176540509">નવીનતમ વર્ઝનમાં મહત્ત્વપૂર્ણ સુરક્ષા સુધારણાઓ અને નવી સુવિધાઓ ઉપલબ્ધ છે.</translation>
<translation id="4053720452172726777">Tomi ને કસ્ટમાઇઝ કરો અને તેનું નિયંત્રણ કરો</translation>
<translation id="4106587138345390261">Tomi એવી નવી સુવિધાઓની શોધખોળ કરી રહ્યું છે કે જેના વડે સાઇટ તમારી ઓછી માહિતીનો ઉપયોગ કરીને બ્રાઉઝિંગનો એવો જ અનુભવ પ્રદાન કરી શકે</translation>
<translation id="4110895483821904099">તમારી નવી Tomi પ્રોફાઇલ સેટઅપ કરો</translation>
<translation id="4147555960264124640">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી Tomi પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો Tomi ડેટા, જેમ કે તમારી ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME" />થી જોડાયેલા રહેશે. તમે Tomi એકાઉન્ટ ડૅશબોર્ડથી આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">ઇન્સ્ટોલ કરી રહ્યું છે...</translation>
<translation id="4149882025268051530">ઇન્સ્ટૉલર આર્કાઇવને અનકોમ્પ્રેસ કરવામાં નિષ્ફળ. કૃપા કરીને Tomi ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="4191857738314598978">{0,plural, =1{એક દિવસની અંદર Tomiને ફરીથી લૉન્ચ કરો}one{# દિવસની અંદર Tomiને ફરીથી લૉન્ચ કરો}other{# દિવસની અંદર Tomiને ફરીથી લૉન્ચ કરો}}</translation>
<translation id="4205939740494406371">Tomi તમારા પાસવર્ડ ચેક કરી શકતું નથી. 24 કલાક પછી ફરી પ્રયાસ કરજો અથવા <ph name="BEGIN_LINK" />તમારા Tomi એકાઉન્ટમાં પાસવર્ડ ચેક કરો<ph name="END_LINK" />.</translation>
<translation id="4222932583846282852">રદ કરી રહ્યાં છીએ…</translation>
<translation id="4242034826641750751">આ સાઇટ માટે Tomiને કૅમેરા અને માઇક્રોફોનની પરવાનગીઓની જરૂર છે</translation>
<translation id="424864128008805179">Tomiમાંથી સાઇન આઉટ કરીએ?</translation>
<translation id="4251615635259297716">તમારા Tomi ડેટાને આ એકાઉન્ટ સાથે લિંક કરીએ?</translation>
<translation id="4262915912852657291"><ph name="BEGIN_BOLD" />કયા ડેટાનો ઉપયોગ કરવામાં આવે છે:<ph name="END_BOLD" /> તમારો બ્રાઉઝિંગ ઇતિહાસ, જે આ ડિવાઇસ પર તમે Tomi વડે મુલાકાત લીધેલી સાઇટનો રેકોર્ડ છે.</translation>
<translation id="4281844954008187215">સેવાની શરતો</translation>
<translation id="4293420128516039005">તમારા બધા ડિવાઇસ પર Tomiને સિંક અને વ્યક્તિગત કરવા માટે સાઇન ઇન કરો</translation>
<translation id="430327780270213103">Tomiના ટૂલબારમાં ઍક્સેસની વિનંતીઓ બતાવવા માટે એક્સ્ટેન્શનને મંજૂરી આપો</translation>
<translation id="4328355335528187361">Tomi Dev (mDNS-In)</translation>
<translation id="4334294535648607276">ડાઉનલોડ પૂર્ણ.</translation>
<translation id="4335235004908507846">Tomi તમને ડેટા ઉલ્લંઘન, ખરાબ એક્સ્ટેંશન અને બીજી ઘણી બાબતોથી સુરક્ષિત રાખી શકે છે</translation>
<translation id="4343195214584226067"><ph name="EXTENSION_NAME" />ને Tomiમાં ઉમેરવામાં આવ્યું છે</translation>
<translation id="4384570495110188418">તમે સાઇન ઇન કરેલું ન હોવાને કારણે Tomi તમારા પાસવર્ડ ચેક કરી શકતું નથી</translation>
<translation id="4427306783828095590">વધારેલી સુરક્ષા ફિશિંગ અને માલવેરને બ્લૉક કરવામાં વધુ સહાયરૂપ થાય છે</translation>
<translation id="4450664632294415862">Tomi - નેટવર્ક સાઇન ઇન - <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">Tomi પર બીજી ક્રિયા ચાલુ છે. કૃપા કરીને પછીથી ફરી પ્રયાસ કરો.</translation>
<translation id="4459234553906210702">Ad measurement તમે જેની મુલાકાત લો છો તે સાઇટને Tomi પાસેથી માહિતીની વિનંતી કરવાની મંજૂરી આપે છે, જે સાઇટને તેની જાહેરાતોનું કાર્યપ્રદર્શન માપવામાં સહાય કરે છે. Ad measurement સાઇટ વચ્ચે શક્ય તેટલી ઓછી માહિતી ટ્રાન્સફર કરીને, સાઇટ દ્વારા પરસ્પરના ટ્રૅકિંગને પ્રતિબંધિત કરે છે.</translation>
<translation id="4561051373932531560">Tomi થી તમે વેબ પર એક ફોન નંબર પર ક્લિક કરી શકો છો અને તેને Skype થી કૉલ કરી શકો છો!</translation>
<translation id="4567424176335768812">તમે <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન છો. હવે તમે તમારા બધા સાઇન ઇન કરેલા ડિવાઇસ પર તમારા બુકમાર્ક, ઇતિહાસ અને અન્ય સેટિંગને ઍક્સેસ કરી શકો છો.</translation>
<translation id="4571503333518166079">Tomiની નોટિફિકેશનની સેટિંગ પર જાઓ</translation>
<translation id="459622048091363950">એકવાર Tomiને ઍક્સેસ મળે, તે પછી વેબસાઇટ તમારી પાસે ઍક્સેસ માગી શકશે.</translation>
<translation id="4600710005438004015">Tomiનું નવું વર્ઝન અપડેટ ન થવાથી, તમે નવી સુવિધાઓ અને સુરક્ષાના સુધારા ચૂકી રહ્યા છો.</translation>
<translation id="4627412468266359539">વૈકલ્પિક: Tomiને ડાયગ્નોસ્ટિક અને વપરાશનો ડેટા ઑટોમૅટિક રીતે મોકલીને TomiOS Flexની સુવિધાઓ અને કાર્યપ્રદર્શનને બહેતર બનાવવામાં સહાય કરો.</translation>
<translation id="4633000520311261472">Tomi ને સુરક્ષિત બનાવવા માટે, અમે <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> માં સૂચિબદ્ધ નથી અને તમારી જાણ વિના ઉમેરવામાં આવ્યાં હોઈ શકે છે તેવા કેટલાક એક્સ્ટેન્શન્સને અક્ષમ કર્યા છે.</translation>
<translation id="4680828127924988555">ઇન્સ્ટૉલેશનની પ્રક્રિયા રદ કરો</translation>
<translation id="469553575393225953">અજાણ્યા સ્રોતો પરના એક્સ્ટેન્શન, ઍપ અને થીમ તમારા ડિવાઇસને નુકસાન પહોંચાડી શકે છે. Tomi તેમને Tomi વેબ સ્ટોર પરથી જ ઇન્સ્ટૉલ કરવાનો સુઝાવ આપે છે</translation>
<translation id="4728575227883772061">અનુલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ રહ્યું. જો Tomi હાલમાં ચાલુ હોય, તો કૃપા કરીને તેને બંધ કરો અને તેનો ફરીથી પ્રયાસ કરો.</translation>
<translation id="4747730611090640388">Tomi તમારી રુચિઓનું અનુમાન લગાવી શકે છે.  પછી, તમે જેની મુલાકાત લો તે સાઇટ Tomiને તમારી રુચિઓ જોવા માટે કહી શકે છે, જેથી તમને જોવા મળતી જાહેરાતોને મનગમતી બનાવી શકાય.</translation>
<translation id="4754614261631455953">Tomi કૅનેરી (mDNS-In)</translation>
<translation id="4771048833395599659">આ ફાઇલ જોખમી હોઈ શકે છે, તેથી Tomi એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="479167709087336770">આ પણ Tomi Searchમાં જે જોડણી તપાસનારનો ઉપયોગ થાય છે તેનો જ ઉપયોગ કરે છે. તમે બ્રાઉઝરમાં ટાઇપ કરો છો તે ટેક્સ્ટ Tomiને મોકલવામાં આવે છે. તમે સેટિંગમાં આ વર્તણૂકને હંમેશાં બદલી શકો છો.</translation>
<translation id="4842397268809523050">TomiOS Flex તમારા ડેટાને સિંક કરી શક્યું નથી, કારણ કે તમારા ડોમેન માટે સિંક કરવાની સુવિધા ઉપલબ્ધ નથી.</translation>
<translation id="4873783916118289636">Tomiમાં પ્રાઇવસી અને સુરક્ષા સંબંધિત મુખ્ય નિયંત્રણોનો રિવ્યૂ કરો</translation>
<translation id="4891791193823137474">Tomi ને પૃષ્ટભૂમિમાં ચાલવા દો</translation>
<translation id="4895437082222824641">નવા Tomi &amp;ટૅબમાં લિંક ખોલો</translation>
<translation id="4953650215774548573">Tomi ને તમારા ડિફોલ્ટ બ્રાઉઝર તરીકે સેટ કરો</translation>
<translation id="495931528404527476">Tomi માં</translation>
<translation id="4969674060580488087">તમારા એકાઉન્ટની સાઇન ઇન વિગતો જૂની હોવાને કારણે TomiOS Flex તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="4970761609246024540">Tomi પ્રોફાઇલમાં આપનું સ્વાગત છે</translation>
<translation id="4970880042055371251">TomiOSનું વર્ઝન</translation>
<translation id="4970947549776831107">આ પ્રકારની ફાઇલ જોખમી હોવાને કારણે Tomi દ્વારા આ ફાઇલને બ્લૉક કરવામાં આવી છે</translation>
<translation id="4990567037958725628">Tomi કૅનેરી</translation>
<translation id="5037581483200764584">Tomiની ભાવિ અપડેટ મેળવવા માટે, તમારે macOS 10.13 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર OS X 10.11નો ઉપયોગ કરે છે.</translation>
<translation id="5098668839038261629">જ્યારે ચાલુ હોય, ત્યારે તમે Tomiમાંથી પણ સાઇન આઉટ થશો</translation>
<translation id="5132929315877954718">Tomi માટે શ્રેષ્ઠ ઍપ્લિકેશનો, રમતો, એક્સટેન્શન્સ અને થીમ્સ શોધો</translation>
<translation id="5139423532931106058">તમારી Tomi પ્રોફાઇલને કસ્ટમાઇઝ કરો</translation>
<translation id="5163087008893166964">Tomi પર આપનું સ્વાગત છે; નવી બ્રાઉઝર વિન્ડો ખોલી છે</translation>
<translation id="5170938038195470297">તમારી પ્રોફાઇલનો ઉપયોગ કરી શકાતો નથી કારણ કે તે Tomiના નવા વર્ઝન તરફથી છે.

કેટલીક સુવિધાઓ ઉપલબ્ધ થઈ શકે છે. કૃપા કરીને અલગ પ્રોફાઇલ ડિરેક્ટરીનો ઉલ્લેખ કરો અથવા Tomiના નવા વર્ઝનનો ઉપયોગ કરો.</translation>
<translation id="521447420733633466">જો તમે ડિવાઇસ શેર કરતા હો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી શકે છે અને તેઓ તેમને જોઈએ તે પ્રમાણે Tomiનું સેટઅપ કરી શકે છે</translation>
<translation id="5251420635869119124">અતિથિઓ કંઈપણ પાછળ છોડ્યાં વિના Tomi નો ઉપયોગ કરી શકે છે.</translation>
<translation id="5334309298019785904">તમારા ડોમેન પર સિંક કરવાની સુવિધા ઉપલબ્ધ ન હોવાને કારણે TomiOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="5334487786912937552">ફાઇલો ડાઉનલોડ કરવા માટે, Tomiને સ્ટોરેજના ઍક્સેસની પરવાનગીની જરૂર છે</translation>
<translation id="5337648990166757586">વૈકલ્પિક: Tomiને ડાયગ્નોસ્ટિક અને વપરાશનો ડેટા ઑટોમૅટિક રીતે મોકલીને TomiOSની સુવિધાઓ અને કાર્યપ્રદર્શનને બહેતર બનાવવામાં સહાય કરો.</translation>
<translation id="5357889879764279201">TomiOS Flex માટે સહાય મેળવો</translation>
<translation id="5386244825306882791">જ્યારે તમે Tomi શરૂ કરો અથવા ઑમ્નિબૉક્સ પરથી શોધ કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="5394833366792865639">Tomi ટૅબ શેર કરો</translation>
<translation id="5412485296464121825">સાઇટ, Tomi પર તમારી રુચિના વિષયો વિશેની માહિતી સ્ટોર કરી શકે છે. ઉદાહરણ તરીકે જો તમે મૅરેથનમાં દોડવા માટે શૂઝ ખરીદવા કોઈ સાઇટની મુલાકાત લો, તો એ સાઇટ મૅરેથન દોડને તમારી રુચિના વિષય તરીકે સાચવી શકે છે. પછી, જો તમે દોડ માટે રજિસ્ટ્રેશન કરાવવા કોઈ અન્ય સાઇટની મુલાકાત લેશો, તો તે સાઇટ તમારી રુચિના વિષયના આધારે તમને દોડવા માટેના શૂઝની જાહેરાત બતાવી શકે છે.</translation>
<translation id="5430073640787465221">તમારી પસંદગીઓ ફાઇલ દૂષિત અથવા અમાન્ય છે.

Tomi તમારા સેટિંગને રિકવર કરી શકતું નથી.</translation>
<translation id="5524761631371622910">જ્યારે અજમાયશો ચાલુ હોય અને જો Tomi કોઈ સક્રિય અજમાયશમાં કોઈપણ ક્રમમાં તમારી ગોઠવણ કરી લે, તો તમારો બ્રાઉઝિંગ ઇતિહાસ તમને દેખાતી જાહેરાતો અને નીચે જણાવેલી અનુમાનિત રુચિઓને અસર કરે છે. તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે Tomi નવા વિષયો આવતા જાય, તેના આધારે દર મહિને તમારી રુચિના વિષયોને ડિલીટ કરે છે.</translation>
<translation id="5530733413481476019">Tomiને વધુ ઝડપી બનાવો</translation>
<translation id="556024056938947818">Tomi પાસવર્ડ્સ બતાવવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="5566025111015594046">Tomi (mDNS-In)</translation>
<translation id="565744775970812598"><ph name="FILE_NAME" /> જોખમી હોઈ શકે છે, તેથી Tomi એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{આ અપડેટ લાગુ કરવા માટે Tomi ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે}=1{આ અપડેટ લાગુ કરવા માટે Tomi ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{આ અપડેટ લાગુ કરવા માટે Tomi ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{આ અપડેટ લાગુ કરવા માટે Tomi ફરીથી લૉન્ચ કરો એવું તમારા વ્યવસ્થાપકનું કહેવું છે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="5686916850681061684">Tomiને કસ્ટમાઇઝ કરો અને તેનું નિયંત્રણ કરો. તમારે ક્યાંક ધ્યાન આપવાની જરૂર છે - વિગતો માટે ક્લિક કરો.</translation>
<translation id="5690427481109656848">Tomi LLC</translation>
<translation id="5715063361988620182">{SECONDS,plural, =1{Tomi 1 સેકન્ડમાં ફરી શરૂ થશે}one{Tomi # સેકન્ડમાં ફરી શરૂ થશે}other{Tomi # સેકન્ડમાં ફરી શરૂ થશે}}</translation>
<translation id="5727531838415286053">જો Tomi કોઈ સક્રિય અજમાયશમાં કોઈપણ ક્રમમાં તમારી ગોઠવણ કરી લે, તો તમારો બ્રાઉઝિંગ ઇતિહાસ તમને દેખાતી જાહેરાતો અને નીચે જણાવેલી અનુમાનિત રુચિઓને અસર કરે છે. તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે Tomi નવા વિષયો આવતા જાય, તેના આધારે દર મહિને તમારી રુચિના વિષયોને ડિલીટ કરે છે. જો તમે રુચિઓને કાઢી ન નાખો, તો તે રિફ્રેશ થાય છે.</translation>
<translation id="5736850870166430177">જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે Tomi પેજ કન્ટેન્ટના બિટ સહિત URLs પણ Safe Browsingને મોકલી શકે છે</translation>
<translation id="5756509061973259733">આ એકાઉન્ટ સાથેની Tomi પ્રોફાઇલ પહેલેથી જ આ ડિવાઇસ પર અસ્તિત્વમાં છે</translation>
<translation id="5795887333006832406"><ph name="PAGE_TITLE" /> - Tomi Canary</translation>
<translation id="5804318322022881572">Tomi લૉન્ચ કરી શકાયું નથી. ફરી પ્રયાસ કરો.</translation>
<translation id="5867197326698922595">Tomi પાસવર્ડમાં ફેરફાર કરવાનો પ્રયાસ કરે છે.</translation>
<translation id="5895138241574237353">પુનઃપ્રારંભ કરો</translation>
<translation id="5903106910045431592"><ph name="PAGE_TITLE" /> - નેટવર્ક સાઇન ઇન</translation>
<translation id="5924017743176219022">ઇન્ટરનેટ સાથે કનેક્ટ કરી રહ્યાં છીએ...</translation>
<translation id="5940385492829620908">તમારું વેબ, બુકમાર્ક અને અન્ય Tomi સામગ્રી અહીં હોય છે.</translation>
<translation id="5941711191222866238">નાનું કરો</translation>
<translation id="5941830788786076944">Tomi ને ડિફૉલ્ટ બ્રાઉઝર બનાવો</translation>
<translation id="6003112304606738118">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="HOURS" /> કલાક બાકી છે</translation>
<translation id="6022388122721048220">{0,plural, =0{Tomi હમણાં બંધ થશે.}=1{Tomi 1 સેકન્ડમાં બંધ થશે.}one{Tomi # સેકન્ડમાં બંધ થશે.}other{Tomi # સેકન્ડમાં બંધ થશે.}}</translation>
<translation id="6040143037577758943">બંધ કરો</translation>
<translation id="6070348360322141662">વધારાની સુરક્ષા માટે, Tomi, તમારા ડેટાને એન્ક્રિપ્ટ કરશે</translation>
<translation id="608006075545470555">આ બ્રાઉઝરમાં ઑફિસની પ્રોફાઇલ ઉમેરો</translation>
<translation id="6113794647360055231">Tomi હવે પહેલાંથી બહેતર બન્યું છે</translation>
<translation id="6145313976051292476">Tomiમાં PDFs ખોલો</translation>
<translation id="6155960517327665396">મેમરી સેવર Tomiને વધુ ઝડપી બનાવે છે</translation>
<translation id="6169866489629082767"><ph name="PAGE_TITLE" /> - Tomi</translation>
<translation id="6173637689840186878"><ph name="PAGE_TITLE" /> - Tomi બીટા</translation>
<translation id="6235018212288296708">mDNS ટ્રાફિકને મંજૂરી આપવા માટે Tomi માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="6247557882553405851">Tomi પાસવર્ડ મેનેજર</translation>
<translation id="6273793429163604305">તૈયાર રહો...</translation>
<translation id="6291089322031436445">Tomi Dev ઍપ્લિકેશનો</translation>
<translation id="6291549208091401781">Tomi, તમારા કમ્પ્યુટર પર પહેલાંથી તમામ વપરાશકર્તાઓ માટે ઇન્સ્ટૉલ કરેલ છે.</translation>
<translation id="6326175484149238433">Tomi માંથી દૂર કરો</translation>
<translation id="6327105987658262776">કોઈ અપડેટ ઉપલબ્ધ નથી.</translation>
<translation id="6412673304250309937">URLsને Tomiમાં સ્ટોર કરેલી અસુરક્ષિત સાઇટની સૂચિ સાથે ચેક કરે છે. જો કોઈ સાઇટ તમારો પાસવર્ડ ચોરી કરવાનો પ્રયાસ કરે અથવા તમે કોઈ નુકસાનકારક ફાઇલ ડાઉનલોડ કરો, ત્યારે Tomi પેજ કન્ટેન્ટના બિટની સાથોસાથ URLs પણ Safe Browsingને મોકલી શકે છે.</translation>
<translation id="6418662306461808273">વર્તમાન Tomi પ્રોફાઇલ પર સ્વિચ કરીએ?</translation>
<translation id="6506909944137591434">તમારા આસપાસનો 3D નકશો બનાવવા માટે, Tomiને કૅમેરાની પરવાનગીની જરૂર છે</translation>
<translation id="6515495397637126556"><ph name="PAGE_TITLE" /> - Tomi Dev</translation>
<translation id="659498884637196217">આ ડિવાઇસ પર Tomi પાસવર્ડ મેનેજરમાં</translation>
<translation id="6632473616050862500">TomiOS Flex વધારાના <ph name="BEGIN_LINK_CROS_OSS" />ઓપન સૉર્સ સૉફ્ટવેર<ph name="END_LINK_CROS_OSS" /> દ્વારા શક્ય બન્યું છે.</translation>
<translation id="6676384891291319759">ઇંટરનેટ ઍક્સેસ કરો</translation>
<translation id="6679975945624592337">Tomiને બૅકગ્રાઉન્ડમાં ચાલવા દો</translation>
<translation id="6696915334902295848">આ સાઇટ માટે Tomiને માઇક્રોફોનની પરવાનગીની જરૂર છે</translation>
<translation id="6718739135284199302">Tomiને વધુ ઝડપી બનાવો</translation>
<translation id="6735387454586646204">TomiOS Flex સિસ્ટમ</translation>
<translation id="6739177684496155661">નવી Tomi પ્રોફાઇલમાં બ્રાઉઝિંગ ચાલુ રાખીએ?</translation>
<translation id="6750954913813541382">જોડણીની ભૂલો સુધારવા માટે, તમે બ્રાઉઝરમાં ટાઇપ કરો છો તે ટેક્સ્ટ Tomi દ્વારા Tomiને મોકલવામાં આવે છે</translation>
<translation id="677276454032249905">છતાં પણ Tomiમાંથી બહાર નિકળવું છે?</translation>
<translation id="683440813066116847">mDNS ટ્રાફિકને મંજૂરી આપવા માટે Tomi કૅનેરી માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="6881299373831449287">Tomi અપડેટ કરી રહ્યાં છીએ</translation>
<translation id="6885412569789873916">Tomi બીટા ઍપ્લિકેશનો</translation>
<translation id="6933858244219479645">TomiOS સિસ્ટમ</translation>
<translation id="6938166777909186039">Tomiની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 8.1નો ઉપયોગ કરે છે.</translation>
<translation id="6943584222992551122">આ વ્યક્તિનો બ્રાઉઝિંગ ડેટા આ ડિવાઇસમાંથી ડિલીટ કરવામાં આવશે. આ ડેટા પાછો મેળવવા માટે, Tomiમાં <ph name="USER_EMAIL" /> તરીકે સાઇન ઇન કરો.</translation>
<translation id="6967962315388095737">mDNS ટ્રાફિકને મંજૂરી આપવા માટે Tomi બીટા માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="6989339256997917931">Tomi અપડેટ કરવામાં આવ્યું હતું, પણ તમે તેનો 30 દિવસ સુધી ઉપયોગ કર્યો નથી.</translation>
<translation id="7025789849649390912">ઇન્સ્ટૉલેશનની પ્રક્રિયા રોકી.</translation>
<translation id="7025800014283535195">તમે અહીં એક Tomi પ્રોફાઇલથી બીજી Tomi પ્રોફાઇલ પર સ્વિચ કરી શકો છો</translation>
<translation id="7036251913954633326">જો તમે માત્ર એક વાર જ આ એકાઉન્ટનો ઉપયોગ કરવા માગતા હો, તો તમે Tomi બ્રાઉઝરમાં <ph name="GUEST_LINK_BEGIN" />અતિથિ મોડ<ph name="GUEST_LINK_END" />નો ઉપયોગ કરી શકો છો. જો તમે કોઈ બીજી વ્યક્તિ માટે એકાઉન્ટ ઉમેરવા માગતા હો, તો તમારા <ph name="DEVICE_TYPE" />માં <ph name="LINK_BEGIN" />નવી વ્યક્તિ ઉમેરો<ph name="LINK_END" />.

તમે વેબસાઇટ અને ઍપને પહેલેથી જે પરવાનગીઓ આપી છે, તે આ એકાઉન્ટ પર લાગુ થઈ શકે છે. તમે <ph name="SETTINGS_LINK_BEGIN" />સેટિંગ<ph name="SETTINGS_LINK_END" />માં જઈને તમારા Tomi એકાઉન્ટ મેનેજ કરી શકો છો.</translation>
<translation id="7062128746136194023">તમારા માતાપિતાએ Tomi માટે "સાઇટ, ઍપ અને એક્સ્ટેન્શન માટેની પરવાનગીઓ" બંધ કરી છે. આ <ph name="EXTENSION_TYPE_PARAMETER" /> ઉમેરવાની મંજૂરી નથી.</translation>
<translation id="7085332316435785646">Tomiની સેવાઓમાં વધુ મનગમતા બનાવેલા અનુભવો આપવા માટે, Tomi ઇતિહાસ શામેલ કરવો કે નહીં, તે પસંદ કરો</translation>
<translation id="7088681679121566888">Tomi અપ ટૂ ડેટ છે</translation>
<translation id="7098166902387133879">Tomi તમારા માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="7099479769133613710">&amp;TomiOSને અપડેટ કરવા માટે તેને ફરીથી લૉન્ચ કરો</translation>
<translation id="7106741999175697885">કાર્ય વ્યવસ્થાપક - Tomi</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{Tomi માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે.}=1{Tomi માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}one{Tomi માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}other{Tomi માટે નવી અપડેટ ઉપલબ્ધ છે અને તે જેવું તમે ફરીથી લૉન્ચ કરશો, તેને લાગુ કરવામાં આવશે. તમારી # છુપી વિન્ડો ફરીથી ખૂલશે નહીં.}}</translation>
<translation id="7155997830309522122">જો એવું હોય, તો કૃપા કરીને Tomiમાં તમારા સાચવેલા પાસવર્ડમાં ફેરફાર કરો જેથી તે તમારા નવા પાસવર્ડ સાથે મેળ ખાય.</translation>
<translation id="7161904924553537242">Tomi માં સ્વાગત છે</translation>
<translation id="7177959540995930968">તમે Tomi સેટિંગમાં આ સુવિધાઓ વિશે વધુ જાણી શકો છો.</translation>
<translation id="7242029209006116544">તમે મેનેજ કરેલા એકાઉન્ટ સાથે સાઇન ઇન કરી રહ્યાં છો અને તમારી Tomi પ્રોફાઇલ પર ઍડમિનને એનું નિયંત્રણ આપી રહ્યાં છો. તમારો Tomi ડેટા, જેમ કે તમારી ઍપ, બુકમાર્ક, ઇતિહાસ, પાસવર્ડ અને બીજા સેટિંગ, કાયમ માટે <ph name="USER_NAME" />થી જોડાયેલા રહેશે. તમે Tomi એકાઉન્ટ ડૅશબોર્ડ દ્વારા આ ડેટાને ડિલીટ કરી શકશો, પરંતુ તમે આ ડેટાને બીજા એકાઉન્ટ સાથે સાંકળી શકશો નહીં. તમે હાલના Tomi ડેટાને અલગ રાખવા માટે વૈકલ્પિક રીતે એક નવી પ્રોફાઇલ બનાવી શકો છો. <ph name="LEARN_MORE" /></translation>
<translation id="7295052994004373688">આ ભાષાનો ઉપયોગ Tomi UI પ્રદર્શિત કરવા માટે થાય છે</translation>
<translation id="7296210096911315575">મહત્વપૂર્ણ ઉપયોગ અને સુરક્ષા માહિતી</translation>
<translation id="7308322188646931570">ફાઇલો ડાઉનલોડ કરવા માટે Tomiને સ્ટોરેજના ઍક્સેસની જરૂર પડે છે</translation>
<translation id="7339898014177206373">નવી વિંડો</translation>
<translation id="7388770099345495132">જો તમે માત્ર એક વાર જ આ એકાઉન્ટનો ઉપયોગ કરવા માગતા હો, તો તમે Tomi બ્રાઉઝરમાં અતિથિ મોડનો ઉપયોગ કરી શકો છો. જો તમે કોઈ બીજી વ્યક્તિ માટે એકાઉન્ટ ઉમેરવા માગતા હો, તો તમારા <ph name="DEVICE_TYPE" />માં <ph name="LINK_BEGIN" />નવી વ્યક્તિ ઉમેરો<ph name="LINK_END" />.

તમે વેબસાઇટ અને ઍપને પહેલેથી જે પરવાનગીઓ આપી છે, તે આ એકાઉન્ટ પર લાગુ થઈ શકે છે. તમે <ph name="SETTINGS_LINK_BEGIN" />સેટિંગ<ph name="SETTINGS_LINK_END" />માં જઈને તમારા Tomi એકાઉન્ટ મેનેજ કરી શકો છો.</translation>
<translation id="7398801000654795464">તમે Tomiમાં <ph name="USER_EMAIL_ADDRESS" /> તરીકે સાઇન ઇન કર્યું હતું. ફરીથી સાઇન ઇન કરવા માટે કૃપા કરીને એ જ એકાઉન્ટનો ઉપયોગ કરો.</translation>
<translation id="7410958280246779049">આ ફાઇલ જોખમી હોવાથી Tomi દ્વારા તેને બ્લૉક કરવામાં આવી છે</translation>
<translation id="7426611252293106642">આ Linux વિતરણ સિસ્ટમ પર Tomi હવે સપોર્ટ કરતું ન હોવાથી કદાચ તે યોગ્ય રીતે કાર્ય ન કરે</translation>
<translation id="7481213027396403996">Tomiની સૌથી વધુ મજબૂત સુરક્ષા મેળવો</translation>
<translation id="7486227612705979895">ઍડ્રેસ બારમાં સૂચનો કરવા માટે, Tomi તમારી ડ્રાઇવને ઍક્સેસ કરશે</translation>
<translation id="7535429826459677826">Tomi Dev</translation>
<translation id="7583399374488819119"><ph name="COMPANY_NAME" /> ઇન્સ્ટૉલર</translation>
<translation id="7606334485649076285">TomiOS Flex</translation>
<translation id="7626032353295482388">Tomi પર આપનું સ્વાગત છે</translation>
<translation id="7626072681686626474"><ph name="MANAGER" /> માટે જરૂરી છે કે તમે આ ડિવાઇસનો ઉપયોગ કરતા પહેલાં નીચે આપેલી સેવાની શરતો વાંચો અને તેને સ્વીકારો. આ શરતો TomiOSની શરતોમાં વધારો કરતી નથી, તેમાં ફેરફાર કરતી નથી અથવા તેને મર્યાદિત કરતી નથી.</translation>
<translation id="7629695634924605473">Tomi વડે તમે તમારા પાસવર્ડમાં ક્યારેક ચેડાં થાય તો તેના વિશે જાણકારી મેળવી શકો છો</translation>
<translation id="7641148173327520642">તમારા સિસ્ટમ વ્યવસ્થાપકે <ph name="TARGET_URL_HOSTNAME" />ને ઍક્સેસ કરવા Tomiને <ph name="ALTERNATIVE_BROWSER_NAME" /> ખોલવા માટે ગોઠવેલું છે.</translation>
<translation id="7649070708921625228">સહાય</translation>
<translation id="7651907282515937834">Tomi એન્ટરપ્રાઇઝ લૉગો</translation>
<translation id="7655455401911432608">તમારો બ્રાઉઝિંગ ઇતિહાસ કે જેમાં આ ડિવાઇસ પર તમે Tomi વડે મુલાકાત લીધેલી સાઇટનો રેકોર્ડ હોય છે.</translation>
<translation id="7747138024166251722">ઇન્સ્ટૉલર અસ્થાયી ડિરેક્ટરી બનાવી શક્યું નથી. કૃપા કરીને ખાલી ડિસ્ક સ્પેસ માટે અને સૉફ્ટવેર ઇન્સ્ટૉલ કરવાની પરવાનગી માટે તપાસો.</translation>
<translation id="7761834446675418963">Tomi ને ખોલવા માટે તમારા નામને ક્લિક કરો અને બ્રાઉઝ કરવાનું પ્રારંભ કરો.</translation>
<translation id="7777080907402804672">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો Tomi તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Tomiને છબીઓ મોકલવામાં આવે છે. તમે આને કોઈપણ સમયે સેટિંગમાં જઈને બંધ કરી શકો છો.</translation>
<translation id="7781002470561365167">Tomiનું નવું વર્ઝન ઉપલબ્ધ છે.</translation>
<translation id="778331955594035129">આ સાઇટ માટે Tomiને સ્થાનની પરવાનગીની જરૂર છે</translation>
<translation id="7787950393032327779">બીજા કમ્પ્યુટર (<ph name="HOST_NAME" />) પર પ્રોફાઇલ બીજી Tomi પ્રક્રિયા (<ph name="PROCESS_ID" />) દ્વારા ઉપયોગમાં હોય એવું લાગે છે. Tomi એ પ્રોફાઇલને લૉક કરી છે જેથી તે દૂષિત ન થઈ જાય. જો તમને ખાતરી છે કે કોઈ અન્ય પ્રક્રિયાઓ આ પ્રોફાઇલનો ઉપયોગ કરી રહી નથી, તો તમે પ્રોફાઇલને અનલૉક કરી અને Tomi ને ફરીથી લોંચ કરી શકો છો.</translation>
<translation id="7801699035218095297">Tomi પાસવર્ડની કૉપિ કરવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="7808348361785373670">Tomi માંથી દૂર કરો...</translation>
<translation id="7825851276765848807">અનુલ્લેખિત ભૂલને કારણે ઇન્સ્ટોલેશન નિષ્ફળ રહ્યું. કૃપા કરીને Tomi ફરીથી ડાઉનલોડ કરો.</translation>
<translation id="7845233973568007926">ઇન્સ્ટૉલ કરવા બદલ આભાર. <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારે તમારું કમ્પ્યુટર ફરી શરૂ કરવું આવશ્યક છે.</translation>
<translation id="7872446069773932638">ડાઉનલોડ કરી રહ્યાં છીએ… <ph name="SECONDS" /> સેકન્ડ બાકી છે</translation>
<translation id="7880591377632733558">Tomi પર આપનું સ્વાગત છે, <ph name="ACCOUNT_FIRST_NAME" /></translation>
<translation id="7890208801193284374">જો તમે કમ્પ્યુટરને શેર કરો છો, તો મિત્રો અને કુટુંબીજનો અલગ-અલગ બ્રાઉઝ કરી શકે છે અને તેમને જોઈએ તેમ Tomi ને સેટ કરી શકે છે.</translation>
<translation id="7896673875602241923">કોઈએ આ કમ્પ્યુટર પર પહેલા <ph name="ACCOUNT_EMAIL_LAST" /> તરીકે Tomiમાં સાઇન ઇન કર્યું છે. તમારી માહિતી અલગ રાખવા માટે કૃપા કરીને નવો Tomi વપરાશકર્તા બનાવો.</translation>
<translation id="7917876797003313048">તમે તમારા સાઇન ઇન કરેલા હોય એવા Tomi એકાઉન્ટ મેનેજ કરી શકો છો. તમારા Tomi એકાઉન્ટનો ઉપયોગ Tomi બ્રાઉઝર, Play Store, Gmail અને વધુ માટે થાય છે. જો તમે કોઈ બીજા, જેમકે તમારા કુટુંબના સભ્ય માટે એકાઉન્ટ ઉમેરવા માંગતા હો, તો તેના બદલે નવી વ્યક્તિને તમારા <ph name="DEVICE_TYPE" />માં ઉમેરો. <ph name="LINK_BEGIN" />વધુ જાણો<ph name="LINK_END" /></translation>
<translation id="7930071585467473040">Tomi પાસવર્ડની કૉપિ કરવાનો પ્રયાસ કરી રહ્યું છે.</translation>
<translation id="7951272445806340501">અપડેટ લાગુ કરવા માટે TomiOS Flexને ફરી શરૂ કરવાની જરૂર છે.</translation>
<translation id="7962368738413920945">સાઇટ કદાચ તમારી અપેક્ષા મુજબ કામ કરશે, પરંતુ તમે Tomiની બધી વિન્ડો બંધ કરી દો તે પછી, તે તમારો ડેટા સાચવશે નહીં</translation>
<translation id="7962410387636238736">આ કમ્પ્યુટર હવેથી Tomi અપડેટ મેળવી શકશે નહીં કારણકે Windows XP અને Windows Vista હવે સમર્થિત રહ્યાં નથી</translation>
<translation id="8005666035647241369">આ ડિવાઇસ પર Tomi પાસવર્ડ મેનેજરમાં સાચવો</translation>
<translation id="8008534537613507642">Tomi ફરીથી ઇન્સ્ટોલ કરો</translation>
<translation id="8013993649590906847">જો છબીમાં ઉપયોગી વર્ણન ન હોય, તો Tomi તમને વર્ણન પૂરું પાડવાનો પ્રયાસ કરશે. વર્ણન બનાવવા માટે, Tomiને છબીઓ મોકલવામાં આવે છે.</translation>
<translation id="80471789339884597">ઇન્સ્ટૉલ કરવા બદલ આભાર. તમારે <ph name="BUNDLE_NAME" />નો ઉપયોગ કરતા પહેલાં તમારા બધા બ્રાઉઝર ફરી શરૂ કરવા આવશ્યક છે.</translation>
<translation id="8064015586118426197">TomiOS Flex</translation>
<translation id="808089508890593134">Tomi</translation>
<translation id="8129812357326543296">&amp;Tomi વિશે</translation>
<translation id="813913629614996137">પ્રારંભ કરી રહ્યું છે...</translation>
<translation id="8255190535488645436">Tomi તમારા કૅમેરા અને માઇક્રોફોનનો ઉપયોગ કરી રહ્યું છે.</translation>
<translation id="8270775718612349140">Tomi દ્વારા મેનેજ કરાતા પ્રમાણપત્રો</translation>
<translation id="8286862437124483331">Tomi પાસવર્ડ્સ બતાવવાનો પ્રયાસ કરી રહ્યું છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="828798499196665338">તમારા માતાપિતાએ Tomi માટે "સાઇટ, ઍપ અને એક્સ્ટેન્શન માટેની પરવાનગીઓ" બંધ કરી છે. આ <ph name="EXTENSION_TYPE_PARAMETER" /> ચાલુ કરવાની મંજૂરી નથી.</translation>
<translation id="8290100596633877290">ઓહ! Tomi ક્રેશ થઈ ગયું. હમણાં ફરીથી લોંચ કરીએ?</translation>
<translation id="8341646175450781745">જ્યારે ચાલુ હોય, ત્યારે Tomi નિષ્ક્રિય ટૅબમાંથી મેમરી ખાલી કરે છે. આ સક્રિય ટૅબ અને અન્ય ઍપને વધુ કમ્પ્યુટર સંસાધનો આપે છે અને Tomiને વધુ ઝડપી રાખે છે. તમે તમારા નિષ્ક્રિય ટૅબ પર પાછા જાઓ ત્યારે તે ઑટોમૅટિક રીતે ફરી સક્રિય થાય છે. <ph name="BEGIN_LINK" />વધુ જાણો<ph name="END_LINK" /> અથવા <ph name="BEGIN_LINK_2" />પ્રતિસાદ મોકલો<ph name="END_LINK_2" /></translation>
<translation id="8342675569599923794">આ ફાઇલ જોખમી છે, તેથી Tomi એ તેને અવરોધિત કરેલ છે.</translation>
<translation id="8349795646647783032"><ph name="BEGIN_BOLD" />અમે આ ડેટાનો ઉપયોગ કેવી રીતે કરીએ છીએ:<ph name="END_BOLD" /> સાઇટ, Tomi પર તમારી રુચિના વિષયો વિશેની માહિતી સ્ટોર કરી શકે છે. ઉદાહરણ તરીકે જો તમે મૅરેથનમાં દોડવા માટે શૂઝ ખરીદવા કોઈ સાઇટની મુલાકાત લો, તો એ સાઇટ મૅરેથન દોડને તમારી રુચિના વિષય તરીકે સાચવી શકે છે. પછી, જો તમે દોડ માટે રજિસ્ટ્રેશન કરાવવા કોઈ અન્ય સાઇટની મુલાકાત લેશો, તો તે સાઇટ તમારી રુચિના વિષયના આધારે તમને દોડવા માટેના શૂઝની જાહેરાત બતાવી શકે છે.</translation>
<translation id="8370517070665726704">કૉપિરાઇટ <ph name="YEAR" /> Tomi LLC. સર્વાધિકાર સુરક્ષિત.</translation>
<translation id="8383226135083126309"><ph name="BEGIN_BOLD" />અમે આ ડેટાનો ઉપયોગ કેવી રીતે કરીએ છીએ:<ph name="END_BOLD" /> Tomi તમારી રુચિઓનું અનુમાન લગાવી શકે છે. પછી, તમે જેની મુલાકાત લો તે સાઇટ Tomiને તમારી રુચિઓ જોવા માટે કહી શકે છે, જેથી તમને જોવા મળતી જાહેરાતોને મનગમતી બનાવી શકાય.</translation>
<translation id="8387459386171870978">Tomiનો ઉપયોગ કરવાનું ચાલુ રાખો</translation>
<translation id="8394720698884623075">URLsને Tomiમાં સ્ટોર કરેલી અસુરક્ષિત સાઇટની સૂચિ સાથે સરખાવીને ચેક કરે છે</translation>
<translation id="840084489713044809">Tomi તમારા પાસવર્ડની નિકાસ કરવા માગે છે.</translation>
<translation id="8416347857511542594">Tomiમાં રુચિ મુજબ જાહેરાત વિશે વધુ જાણો</translation>
<translation id="8418845734693287262">તમારા એકાઉન્ટની સાઇન ઇન વિગતો જૂની હોવાને કારણે TomiOS તમારા ડેટાને સિંક કરી શક્યું નથી.</translation>
<translation id="8433638294851456451">અહીંથી તમારા Android ફોન પર નંબર મોકલવા માટે, બન્ને ડિવાઇસ પર Tomiમાં સાઇન ઇન કરો.</translation>
<translation id="8451192282033883849"><ph name="MANAGER_NAME" /> દ્વારા તમારું એકાઉન્ટ મેનેજ કરવામાં આવે છે. તમારા ઍડમિનિસ્ટ્રેટર આ Tomi બ્રાઉઝરની પ્રોફાઇલ અને બુકમાર્ક, ઇતિહાસ તથા પાસવર્ડ જેવો તેનો ડેટા જોઈ શકે છે અને તેમાં ફેરફાર કરી શકે છે.</translation>
<translation id="8498858610309223613">Tomi માટેનું વિશેષ સુરક્ષા અપડેટ હમણાં જ લાગુ કરવામાં આવ્યું. ફરી શરૂ કરો અને અમે તમારાં ટૅબની પુનઃસ્થાપના કરીશું.</translation>
<translation id="8504220326736535258">આ ફાઇલમાં માલવેર હોવાથી Tomi દ્વારા તેને બ્લૉક કરવામાં આવી છે</translation>
<translation id="8516431725144212809">Tomi દ્વારા અનુમાન લગાવ્યા મુજબની તમારી રુચિઓ</translation>
<translation id="8521348052903287641">mDNS ટ્રાફિકને મંજૂરી આપવા માટે Tomi Dev માટે ઇનબાઉન્ડ નિયમ.</translation>
<translation id="8540666473246803645">Tomi</translation>
<translation id="8550334526674375523">ઑફિસની આ પ્રોફાઇલ તમારી વ્યક્તિગત પ્રોફાઇલથી સાવ અલગ છે.</translation>
<translation id="8556340503434111824">Tomiનું એક નવું વર્ઝન ઉપલબ્ધ છે અને તે પહેલાં કરતાંએ વધુ ઝડપી છે.</translation>
<translation id="8571790202382503603">Tomi પ્રોફાઇલ વડે તમે તમારી બધી વસ્તુઓ Tomi પર અલગ-અલગ રાખી શકો છો. આનાથી ઑફિસ અને મનોરંજન વચ્ચે વિભાજન કરવાનું સરળ બને છે.</translation>
<translation id="8614913330719544658">Tomi પ્રતિસાદ આપતું નથી. હવે ફરીથી લોંચ કરીએ?</translation>
<translation id="861702415419836452">તમારા આસપાસનો 3D નકશો બનાવવા માટે, Tomiને તમારા કૅમેરાના ઍક્સેસની પરવાનગી જરૂરી છે</translation>
<translation id="8625237574518804553">{0,plural, =1{Tomi 1 મિનિટમાં ફરીથી લૉન્ચ થશે}one{Tomi # મિનિટમાં ફરીથી લૉન્ચ થશે}other{Tomi # મિનિટમાં ફરીથી લૉન્ચ થશે}}</translation>
<translation id="8641606876632989680">જ્યારે તમે ચેડાં થયેલા પાસવર્ડ વડે સાઇન ઇન કરશો ત્યારે Tomi તમને સૂચિત કરશે</translation>
<translation id="8649026945479135076">તમારા અનુભવને મનગમતો બનાવવા માટે તમે જે સાઇટની મુલાકાત લો છો તે બધી સાઇટ તમને જેમાં રુચિ હોય એવી તમામ વસ્તુઓ યાદ રાખી લે તે સામાન્ય બાબત છે. સાઇટ, Tomi પર તમારી રુચિના વિષયો વિશેની માહિતી પણ સ્ટોર કરી શકે છે.</translation>
<translation id="8669527147644353129">Tomi સહાયક</translation>
<translation id="8679801911857917785">જ્યારે તમે Tomi શરૂ કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="8684875378076460854">Tomi આ ફાઇલને સ્કૅન કરવાનો સુઝાવ આપે છે, કારણ કે તે જોખમકારક હોઈ શકે છે</translation>
<translation id="8686817260976772516">Tomi પ્રોફાઇલ વડે તમે તમારી બધી વસ્તુઓ Tomi પર અલગ-અલગ રાખી શકો છો. મિત્રો અને કુટુંબ માટે પ્રોફાઇલ બનાવો અથવા તેને ઑફિસ અને મનોરંજન વચ્ચે વિભાજિત કરો.</translation>
<translation id="8712767363896337380">લગભગ અપ ટૂ ડેટ છે! અપડેટ કરવાનું સમાપ્ત કરવા માટે, Tomi ફરીથી લૉન્ચ કરો.</translation>
<translation id="873133009373065397">Tomi ડિફૉલ્ટ બ્રાઉઝરને નિર્ધારિત અથવા સેટ કરી શકતું નથી</translation>
<translation id="8821043148920470810">Tomiની ભાવિ અપડેટ મેળવવા માટે, તમારે Windows 10 કે તે પછીના વર્ઝન પર અપડેટ કરવું જરૂરી રહેશે. આ કમ્પ્યુટર Windows 7નો ઉપયોગ કરે છે.</translation>
<translation id="8823341990149967727">Tomi જૂનું થઈ ગયું છે</translation>
<translation id="8825634023950448068">તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે, અમે 4 અઠવાડિયા કરતાં જૂની હોય એવી તમારી રુચિઓને ઑટોમૅટિક રીતે ડિલીટ કરીએ છીએ. તમે જેમ જેમ બ્રાઉઝ કરતા રહો છો, તેમ તેમ તમારી રુચિનો વિષય ફરી સૂચિમાં દેખાઈ શકે છે. અને જો તમને લાગે કે Tomi દ્વારા પસંદ કરાયેલો તમારી રુચિનો વિષય ખોટો છે અથવા તમે અમુક ચોક્કસ પ્રકારની જાહેરાતો જોવા માગતા ન હો, તો તમે તે રુચિ કાઢી નાખી શકો છો.</translation>
<translation id="8834965163890861871">Tomi પાસવર્ડમાં ફેરફાર કરવાનો પ્રયાસ કરે છે. આની મંજૂરી આપવા માટે તમારો Windows પાસવર્ડ લખો.</translation>
<translation id="884296878221830158">જ્યારે તમે Tomi શરૂ કરો અથવા હોમ બટન ક્લિક કરો ત્યારે કયું પેજ બતાવવામાં આવે તે તેનું પણ નિયંત્રણ કરે છે.</translation>
<translation id="8847000024471094355">Tomi નિષ્ક્રિય છે</translation>
<translation id="8862326446509486874">તમારી પાસે સિસ્ટમ-સ્તરનાં ઇન્સ્ટોલ માટે ઉચિત અધિકારો નથી. એડમિન તરીકે ઇન્સ્ટૉલરને ફરીથી ચલાવવનો પ્રયાસ કરો.</translation>
<translation id="8914504000324227558">Tomi ફરીથી લોંચ કરો</translation>
<translation id="8922193594870374009"><ph name="ORIGIN" />માંથી તમારા Android ફોન પર નંબર મોકલવા માટે, બન્ને ડિવાઇસ પર Tomiમાં સાઇન ઇન કરો.</translation>
<translation id="8983720963221508955">તમે તમારા એકાઉન્ટમાં Safe Browsingમાં વધારેલી સુરક્ષાની સુવિધા ચાલુ કરી છે. હવે આ સુવિધા Tomi માટે મેળવો.</translation>
<translation id="8986207147630327271">તમે આ બ્રાઉઝરમાં ઑફિસની પ્રોફાઇલ ઉમેરી રહ્યાં છો અને તમારા વ્યવસ્થાપકને માત્ર ઑફિસની પ્રોફાઇલનો નિયંત્રણ આપી રહ્યાં છો.</translation>
<translation id="8989968390305463310">તમારો બ્રાઉઝિંગ ઇતિહાસ તમે જુઓ છો તે જાહેરાતોને અને નીચે જણાવેલી અનુમાનિત રુચિઓને અસર કરે છે. તમારી પ્રાઇવસીની સુરક્ષા કરવા માટે Tomi નવા વિષયો આવતા જાય, તેના આધારે દર મહિને તમારી રુચિના વિષયોને ઑટોમૅટિક રીતે ડિલીટ કરે છે. જો તમે રુચિઓને કાઢી ન નાખો, તો તે રિફ્રેશ થઈ શકે છે.</translation>
<translation id="8999208279178790196">{0,plural, =0{એક Tomi અપડેટ ઉપલબ્ધ છે}=1{એક Tomi અપડેટ ઉપલબ્ધ છે}one{Tomi અપડેટ # દિવસ માટે ઉપલબ્ધ છે}other{Tomi અપડેટ # દિવસ માટે ઉપલબ્ધ છે}}</translation>
<translation id="9003498785844995646">જ્યારે ચાલુ હોય ત્યારે Tomi, સ્મૂધ સ્ક્રોલિંગ અને વીડિયોના ફ્રેમ રેટ જેવી બૅકગ્રાઉન્ડની પ્રવૃત્તિ અને વિઝ્યુઅલ ઇફેક્ટને મર્યાદિત કરીને બૅટરી પાવર બચાવે છે. <ph name="BEGIN_LINK" />વધુ જાણો<ph name="END_LINK" /> અથવા <ph name="BEGIN_LINK_2" />પ્રતિસાદ મોકલો<ph name="END_LINK_2" /></translation>
<translation id="9053892488859122171">TomiOS Flex સિસ્ટમ</translation>
<translation id="9067395829937117663">Tomi માટે Windows 7 અથવા તે પછીનું સંસ્કરણ આવશ્યક છે.</translation>
<translation id="911206726377975832">તમારો બ્રાઉઝિંગ ડેટા પણ ડિલીટ કરી દઈએ?</translation>
<translation id="9138603949443464873">તમારા ફેરફારો લાગુ કરવા માટે, Tomiને ફરી લૉન્ચ કરો</translation>
<translation id="9195993889682885387">Tomi છેલ્લા અમુક અઠવાડિયાઓના તમારા બ્રાઉઝિંગ ઇતિહાસને આધારે તમારી રુચિઓનું અનુમાન લગાવી શકે છે. આ માહિતી તમારા ડિવાઇસમાં જ રહે છે.</translation>
<translation id="919706545465235479">સમન્વયન પ્રારંભ કરવા માટે Tomi અપડેટ કરો</translation>
<translation id="922152298093051471">Tomi કસ્ટમાઇઝ કરો</translation>
<translation id="93760716455950538">TomiOS Flex ફરી શરૂ કરો</translation>
<translation id="940313311831216333">Tomi પરની તમારી વસ્તુઓને તમારા બધા ડિવાઇસ પર ઍક્સેસ કરવા માટે, સાઇન ઇન કરો અને પછી સિંક કરવાની સુવિધા ચાલુ કરો.</translation>
<translation id="943390475793766444">Tomi આ ફાઇલને સ્કૅન કરવાનો સુઝાવ આપે છે, કારણ કે તે જોખમકારક હોઈ શકે છે.</translation>
<translation id="989369509083708165">Tomi તમારું ડિફૉલ્ટ બ્રાઉઝર છે</translation>
<translation id="989816563149873169"><ph name="SHORTCUT" /> વડે એક Tomi પ્રોફાઇલથી બીજી Tomi પ્રોફાઇલ પર સ્વિચ કરી શકાય છે</translation>
</translationbundle>