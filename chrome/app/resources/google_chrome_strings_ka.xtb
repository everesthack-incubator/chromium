<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1001534784610492198">ინსტალატორის არქივი დაზიანებული ან არასწორია. გთხოვთ, ხელახლა ჩამოტვირთოთ Tomi.</translation>
<translation id="1026101648481255140">ინსტალაციის გაგრძელება</translation>
<translation id="102763973188675173">მოირგეთ და გააკონტროლეთ Tomi. ხელმისაწვდომია განახლება.</translation>
<translation id="1051826050538111504">თქვენს კომპიუტერზე აღმოჩენილია საზიანო პროგრამული უზრუნველყოფა. Tomi-ს შეუძლია მისი ამოშლა, თქვენი პარამეტრების აღდგენა და გაფართოებების გათიშვა, რომ ბრაუზერმა კვლავ ნორმალურად იმუშაოს.</translation>
<translation id="1065672644894730302">თქვენი პარამეტრების წაკითხვა შეუძლებელია.

ზოგიერთი ფუნქცია შეიძლება მიუწვდომელი იყოს და პარამეტრების ცვლილებები არ იქნება შენახული.</translation>
<translation id="1088300314857992706"><ph name="USER_EMAIL_ADDRESS" /> დრე იყენებდა Tomi-ს</translation>
<translation id="110877069173485804">ეს არის თქვენი Tomi</translation>
<translation id="1125124144982679672">ვინ იყენებს Tomi-ს?</translation>
<translation id="1142745911746664600">Tomi-ის განახლება ვერ მოხერხდა</translation>
<translation id="1152920704813762236">TomiOS-ის შესახებ</translation>
<translation id="1154147086299354128">Tomi-ში &amp;გახსნა</translation>
<translation id="1203500561924088507">გმადლობთ დაინსტალირებისთვის. <ph name="BUNDLE_NAME" />-ის გამოყენებამდე თქვენი ბრაუზერი უნდა გადატვირთოთ.</translation>
<translation id="1236866257838264361">თქვენ საშუალება გაქვთ, Tomi-ის შესაძლებლობები მაქსიმალურად გამოიყენოთ</translation>
<translation id="1278833599417554002">ხელახლა გაშვება &amp;Tomi-ის გასაახლებლად</translation>
<translation id="1302523850133262269">დაელოდეთ, სანამ Tomi დააინსტალირებს სისტემის უახლეს განახლებებს.</translation>
<translation id="1335640173511558774"><ph name="MANAGER" /> მოითხოვს, რომ ამ მოწყობილობის გამოყენებამდე წაიკითხოთ ქვემოთ მოცემული მომსახურების პირობები და დაეთანხმოთ მათ. აღნიშნული პირობები არ არის TomiOS Flex-ის წესების დამატება, ასევე, არ ცვლის და არც ზღუდავს მათ.</translation>
<translation id="1363996462118479832">Tomi S-მა ვერ დაასინქრონა თქვენი მონაცემები შესვლის შეცდომის გამო.</translation>
<translation id="137466361146087520">Tomi Beta</translation>
<translation id="1399397803214730675">ამ კომპიუტერს უკვე აქვს Tomi Chrom-ის უფრო ახალი ვერსია. იმ შემთხვევაში, თუ პროგრამა არ მუშაობს, გთხოვთ, განახორციელეთ Tomi-ის დეინსტალაცია და სცადეთ ისევ.</translation>
<translation id="139993653570221430">აზრის შეცვლას ნებისმიერ დროს შეძლებთ Tomi-ის პარამეტრებიდან. ცდები განხორციელდება რეკლამის ჩვენების ამჟამინდელი მექანიზმების მოქმედების პარალელურად, ამიტომ ცვლილებებს მომენტალურად არ შეამჩნევთ.</translation>
<translation id="1434626383986940139">Tomi Canary პროგრამები</translation>
<translation id="1507198376417198979">მოირგეთ თქვენი ახალი Tomi პროფილი</translation>
<translation id="1516530951338665275">დაწყვილების გასაგრძელებლად Tomi საჭიროებს Bluetooth-ზე წვდომას. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1547295885616600893">TomiOS მუშაობს <ph name="BEGIN_LINK_CROS_OSS" />ღია კოდის პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS" /> დამსახურებით.</translation>
<translation id="1553358976309200471">Tomi-ის განახლება</translation>
<translation id="1583073672411044740"><ph name="EXISTING_USER" /> უკვე შესულია ამ Tomi პროფილში. ეს მოქმედება შექმნის ახალ Tomi პროფილს <ph name="USER_EMAIL_ADDRESS" />-ისთვის</translation>
<translation id="1587223624401073077">Tomi იყენებს თქვენს კამერას.</translation>
<translation id="1587325591171447154">Tomi-მა დაბლოკა <ph name="FILE_NAME" />, რადგან ის სახიფათოა.</translation>
<translation id="1597911401261118146"><ph name="BEGIN_LINK" />შედით Tomi-ში<ph name="END_LINK" />, რომ შეამოწმოთ, შეეხო თუ არა პერსონალურ მონაცემთა გაჟონვის შემთხვევები და უსაფრთხოებასთან დაკავშირებული პრობლემები თქვენს პაროლებს.</translation>
<translation id="1599904803480101533">Tomi-მა დაბლოკა არქივის ეს ფაილი, ვინაიდან მასში, შესაძლოა, იმალებოდეს მავნე პროგრამა</translation>
<translation id="1619887657840448962">Tomi-ის უსაფრთხოების გასაძლიერებლად, ჩვენ გავთიშეთ შემდეგი გაფართოება, რომელიც არ არის ხელმისაწვდომი <ph name="IDS_EXTENSION_WEB_STORE_TITLE" />-ში და, შესაძლოა, თქვენი თანხმობის გარეშე დაემატა.</translation>
<translation id="1627304841979541023"><ph name="BEGIN_BOLD" />თქვენი მონაცემების მართვის ხერხები:<ph name="END_BOLD" /> თქვენი კონფიდენციალურობის დაცვის მიზნით, ჩვენ ავტომატურად ვშლით თქვენს ინტერესებს, რომლებიც 4 კვირაზე ძველია. თქვენ მიერ ვების დათვალიერების პარალელურად, ესა თუ ეს ინტერესი შეიძლება ხელახლა გამოჩნდეს სიაში. სურვილისამებრ, შეგიძლიათ წაშალოთ ინტერესები, რომლებიც არ გსურთ, Tomi-მა რომ გაითვალისწინოს.</translation>
<translation id="1628000112320670027">Tomi-თან დაკავშირებული დახმარების მიღება</translation>
<translation id="1640672724030957280">მიმდინარეობს ჩამოტვირთვა…</translation>
<translation id="1662146548738125461">TomiOS Flex-ის შესახებ</translation>
<translation id="1674870198290878346">ბმულის გახსნა Tomi-ის ინკო&amp;გნიტო ფანჯარაში</translation>
<translation id="1682634494516646069">Tomi ვერ ახერხებს თავის მონაცემთა დირექტორიაში წაკითხვას და ჩაწერის განხორციელებას:

<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1691802391966922744">{COUNT,plural, =1{თქვენი ადმინისტრატორის მიერ განსაზღვრული კონფიგურაციის მიხედვით, Tomi უნდა დაიხუროს, თუ ის უმოქმედოა 1 წუთზე მეტი ხნის განმავლობაში.}other{თქვენი ადმინისტრატორის მიერ განსაზღვრული კონფიგურაციის მიხედვით, Tomi უნდა დაიხუროს, თუ ის უმოქმედოა # წუთზე მეტი ხნის განმავლობაში.}}</translation>
<translation id="1698376642261615901">Tomi არის ვებ-ბრაუზერი, რომელიც ძალიან სწრაფად ხსნის ვებ-გვერდებს და პროგრამებს. იგი სწრაფი, სტაბილური და ადვილად გამოსაყენებელია. უფრო უსაფრთხოდ დაათვალიერეთ ინტერნეტ-გვერდები, Tomi-ში ჩაშენებული საზიანო პროგრამების და თაღლითობის საწინააღმდეგო დაცვის დახმარებით.</translation>
<translation id="1713301662689114961">{0,plural, =1{Tomi ხელახლა გაეშვება 1 საათში}other{Tomi ხელახლა გაეშვება # საათში}}</translation>
<translation id="1734234790201236882">Tomi შეინახავს ამ პაროლს თქვენს Tomi ანგარიშში. მისი დამახსოვრება აუცილებელი არ არის.</translation>
<translation id="1759842336958782510">Tomi</translation>
<translation id="1786003790898721085">დარწმუნდით, რომ თქვენს <ph name="TARGET_DEVICE_NAME" />-ზე შესული ხართ Tomi-ში, შემდეგ კი ხელახლა ცადეთ გაგზავნა.</translation>
<translation id="1812689907177901597">ამ პარამეტრის გამორთვის შემთხვევაში, Tomi-ის საიტებში (მაგალითად, Gmail-ში) შესვლას შეძლებთ Tomi-ში შესვლის გარეშე</translation>
<translation id="1860536484129686729">Tomi საჭიროებს თქვენს კამერაზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="1873233029667955273">Tomi არ არის თქვენი ნაგულისხმევი ბრაუზერი</translation>
<translation id="1874309113135274312">Tomi Beta (mDNS-In)</translation>
<translation id="1877026089748256423">Tomi მოძველებულია</translation>
<translation id="1919130412786645364">Tomi-ში შესვლის დაშვება</translation>
<translation id="1952239763774043237">Tomi-ის მომავალი განახლებების მისაღებად დაგჭირდებათ macOS 10.13 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს macOS 10.12-ს.</translation>
<translation id="1953553007165777902">მიმდინარეობს ჩამოტვირთვა… დარჩენილია <ph name="MINUTE" /> წუთი</translation>
<translation id="2018528049276128029">თითოეულ პროფილში ინახება საკუთარი Tomi ინფორმაცია, როგორიცაა სანიშნეები, ისტორია, პაროლები და სხვა</translation>
<translation id="2018879682492276940">ინსტალაცია ვერ მოხერხდა. ცადეთ ხელახლა.</translation>
<translation id="2071318482926839249">სხვა ანგარიში უკვე შესულია. თქვენი დათვალიერების მონაცემები რომ განაცალკეოთ, Tomi-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="207902854391093810">როცა ცდები ჩართულია, რეკლამის ეფექტურობის გაზომვის მეშვეობით, თქვენ მიერ მონახულებულ საიტებს საშუალება ექნება, Tomi-ისგან მოითხოვონ გარკვეული ინფორმაცია, რომელიც ამა თუ იმ საიტს თავისი რეკლამის ეფექტურობის განსაზღვრაში დაეხმარება. რეკლამის ეფექტურობის გაზომვისას საიტებს შორის თვალის მიდევნების მექანიზმები შეზღუდულია, რაც ნიშნავს, რომ საიტებს შორის მინიმალური ინფორმაცია გადაიცემა.</translation>
<translation id="2091012649849228750">Tomi-ის მომავალი განახლებების მისაღებად დაგჭირდებათ Windows 10 ან უფრო ახალი ვერსია. ეს კომპიუტერი იყენებს Windows 8-ს.</translation>
<translation id="2094648590148273905">TomiOS Flex-ის პირობები</translation>
<translation id="2094919256425865063">მაინც გსურთ Tomi-იდან გასვლა?</translation>
<translation id="2106831557840787829">TomiOS Flex და <ph name="BEGIN_LINK_LINUX_OSS" />Linux-ის შემუშავების გარემო<ph name="END_LINK_LINUX_OSS" /> მუშაობს <ph name="BEGIN_LINK_CROS_OSS" />ღია კოდის დამატებითი პროგრამული უზრუნველყოფის<ph name="END_LINK_CROS_OSS" /> დამსახურებით.</translation>
<translation id="2120620239521071941">ეს მოქმედება წაშლის <ph name="ITEMS_COUNT" /> ერთეულს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Tomi-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">ხელახლა გაშვება &amp;Tomi-ის გასაახლებლად</translation>
<translation id="2123055963409958220">ხელი შეუწყვეთ Tomi-ის გაუმჯობესებას <ph name="BEGIN_LINK" />მიმდინარე პარამეტრების<ph name="END_LINK" /> გამოგზავნის მეშვეობით</translation>
<translation id="2131230230468101642">თქვენი კონფიდენციალურობის დაცვის მიზნით, ჩვენ ავტომატურად ვშლით თქვენს ინტერესებს, რომლებიც 4 კვირაზე ძველია. თქვენ მიერ ვების დათვალიერების პარალელურად, ესა თუ ეს ინტერესი შეიძლება ხელახლა გამოჩნდეს სიაში. სურვილისამებრ, შეგიძლიათ წაშალოთ ინტერესები, რომლებიც არ გსურთ, Tomi-მა რომ გაითვალისწინოს.</translation>
<translation id="2139300032719313227">გადატვირთეთ TomiOS</translation>
<translation id="2151406531797534936">გთხოვთ, ახლავე გადატვირთოთ Tomi</translation>
<translation id="2174917724755363426">ინსტალაცია არ დასრულებულა. ნამდვილად გსურთ გაუქმება?</translation>
<translation id="223889379102603431">ინფორმაცია Tomi-ის მიერ თავისი ძირეული სერტიფიკატების მართვის შესახებ</translation>
<translation id="2258103955319320201">Tomi ბრაუზერში თქვენს კონტენტზე თქვენი ნებისმიერი მოწყობილობიდან წვდომისთვის შედით სისტემაში, შემდეგ კი ჩართეთ სინქრონიზაცია</translation>
<translation id="2290014774651636340">Tomi API გასაღები გამოტოვებულია. Tomi-ის ზოგიერთი ფუნქცია გამორთული იქნება.</translation>
<translation id="2290095356545025170">ნამდვილად გსურთ მოახდინოთ Tomi-ის დეინსტალაცია?</translation>
<translation id="2309047409763057870">ეს Tomi-ის მეორადი ინსტალაცია არის და ნაგულისხმევ ბრაუზერად ის ვერ დაყენდება.</translation>
<translation id="2345992953227471816">Tomi-მა აღმოაჩინა, რომ შემდეგი გაფართოებები შეიცავს მავნე პროგრამას:</translation>
<translation id="2348335408836342058">Tomi საჭიროებს თქვენს კამერასა და მიკროფონზე წვდომის ნებართვას ამ საიტისთვის</translation>
<translation id="234869673307233423">Tomi ვერ ახერხებს პაროლების შემოწმებას. ცადეთ მოგვიანებით.</translation>
<translation id="235650106824528204">ამ პროფილის გამოყენებისას შექმნილი Tomi მონაცემების (მაგ., შექმნილი სანიშნეების, ისტორიის, პაროლებისა და სხვა პარამეტრების) ამოშლა შეუძლია სამსახურის პროფილის ადმინისტრატორს. <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">გაგრძელება</translation>
<translation id="2401189691232800402">TomiOS სისტემა</translation>
<translation id="2467438592969358367">Tomi ითხოვს თქვენი პაროლების ექსპორტირებას. აღნიშნულის დასაშვებად აკრიფეთ თქვენი Windows-ის პაროლი.</translation>
<translation id="2485422356828889247">დეინსტალაცია</translation>
<translation id="2534507159460261402">Tomi Pay (Tomi-ში კოპირებული)</translation>
<translation id="2559253115192232574">მოგვიანებით, თქვენ მიერ მონახულებულ საიტს საშუალება ექნება, Tomi-ს სთხოვოს თქვენი ინტერესების ჩვენება, თქვენთვის ხილული რეკლამის პერსონალიზების მიზნით. Tomi-ს შეუძლია 3-მდე ინტერესის გაზიარება.</translation>
<translation id="2563121210305478421">გსურთ Tomi-ის ხელახლა გაშვება?</translation>
<translation id="2574930892358684005"><ph name="EXISTING_USER" /> უკვე შესულია ამ Tomi პროფილში. თქვენი დათვალიერების მონაცემები რომ განაცალკევოთ, Tomi-ს შეუძლია თქვენთვის პერსონალური პროფილის შექმნა.</translation>
<translation id="2580411288591421699">შეუძლებელია იმავე Tomi-ის ვერსიის დაყენება, რომელიც ამჟამად გაშვებულია. დახურეთ Tomi და ხელახლა სცადეთ.</translation>
<translation id="2586406160782125153">ეს მოქმედება წაშლის თქვენს დათვალიერების მონაცემებს ამ მოწყობილობიდან. თქვენი მონაცემების მოგვიანებით მისაღებად, შედით Tomi-ში, როგორც <ph name="USER_EMAIL" />.</translation>
<translation id="2597976513418770460">მიიღეთ Tomi ბრაუზერში შენახული თქვენი კონტენტი <ph name="ACCOUNT_EMAIL" />-დან</translation>
<translation id="2622559029861875898">Tomi ვერ ახერხებს განახლებების შემოწმებას. შეამოწმეთ კავშირი ინტერნეტთან.</translation>
