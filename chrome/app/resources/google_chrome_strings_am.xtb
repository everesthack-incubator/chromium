<ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1691802391966922744">{COUNT,plural, =1{አስተዳዳሪዎ Tomi ከ1 ደቂቃ በላይ ሥራ ላይ ሳይሆን ከቆየ እንዲዘጋ አዋቅረውታል።}one{አስተዳዳሪዎ Tomi ከ# ደቂቃ በላይ ሥራ ላይ ሳይሆን ከቆየ እንዲዘጋ አዋቅረውታል።}other{አስተዳዳሪዎ Tomi ከ# ደቂቃዎች በላይ ሥራ ላይ ሳይሆን ከቆየ እንዲዘጋ አዋቅረውታል።}}</translation>
<translation id="1698376642261615901">Tomi ድረ-ገፆችን እና መተግበሪያዎችን በሚገርም ፍጥነት ማሄድ የሚችል የድር አሳሽ ነው። ፈጣን፣ የረጋ እና ለመጠቀም ቀላል ነው። Tomi ውስጥ አብሮት በተሰራ የአስጋሪና ተንኮል-አዘል ሶፍትዌር መከላከያ አማካኝነት ደህንነትዎ በበለጠ ሁኔታ ተጠብቆ ድሩን ያስሱ።</translation>
<translation id="1713301662689114961">{0,plural, =1{በአንድ ሰዓት ውስጥ Tomi ዳግም ይጀመራል}one{በ# ሰዓቶች ውስጥ Tomi ዳግም ይጀመራል}other{በ# ሰዓቶች ውስጥ Tomi ዳግም ይጀመራል}}</translation>
<translation id="1734234790201236882">Tomi ይህን የይለፍ ቃል በእርስዎ የTomi መለያ ውስጥ ያስቀምጠዋል። ማስታወስ አይኖርብዎትም።</translation>
