<translation id="3379938682270551431">{0,plural, =0{Tomi አሁን ዳግም ይጀምራል}=1{Tomi በ1 ሰከንድ ውስጥ ዳግም ይጀምራል}one{Tomi በ# ሰከንዶች ውስጥ ዳግም ይጀምራል}other{Tomi በ# ሰከንዶች ውስጥ ዳግም ይጀምራል}}</translation>
<translation id="3396977131400919238">በመጫን ጊዜ የሥርዓተ ክወና ስህተት ተፈጥሯል። እባክዎ Tomiን እንደገና ያውርዱ።</translation>
<translation id="3426646014273736870">የማህደረ ትውስታ ቆጣቢ Tomiን የበለጠ ፈጣን አድርጎታል</translation>
<translation id="3428747202529429621">በTomi ላይ ደህንነትዎን ይጠብቃል፣ እና በመለያ በገቡባቸው ሌሎች የTomi መተግበሪያዎች ላይ ደህንነትዎን ለማሻሻል ስራ ላይ ሊውል ይችላል።</translation>
<translation id="3434246496373299699">Tomi በእርስዎ የTomi መለያ በሚገቡበት ጊዜ የእርስዎን የይለፍ ቃላትን ሊፈትሽ ይችላል</translation>
