<translation id="3873044882194371212">አገናኝ በTomi ማንነት የ&amp;ማያሳውቅ መስኮት ውስጥ ክፈት</translation>
<translation id="3889417619312448367">Tomiን አራግፍ</translation>
<translation id="3999683152997576765">ማስታወቂያዎችን ለእርስዎ ለማሳየት የሚጠቀሙባቸውን የዝንባሌ ጣቢያዎች ርዕሶች ማየት እና ማስወገድ ይችላሉ። Tomi በቅርብ ጊዜ የአሰሳ ታሪክዎ ላይ ተመስርቶ የእርስዎን ዝንባሌዎች ይገምታል።</translation>
<translation id="4035053306113201399">TomiOS ዝማኔውን ለመተግበር ዳግም መጀመር አለበት።</translation>
<translation id="4050175100176540509">አስፈላጊ የደህንነት ማሻሻያዎች እና አዲስ ባህሪያት በቅርብ ጊዜው ስሪቱ ላይ ይገኛሉ።</translation>
<translation id="4053720452172726777">Tomiን ያብጁ እና ይቆጣጠሩ</translation>
<translation id="4106587138345390261">Tomi ጣቢያዎች ያነሰ መረጃዎን ተጠቅመው ተመሳሳይ የአሰሳ ተሞክሮ እንዲያቀርቡ የሚያስችሏቸውን አዲስ ባህሪያት እያሰሰ ነው።</translation>
<translation id="4110895483821904099">አዲሱን የTomi መገለጫዎ ያቀናብሩት</translation>
<translation id="4147555960264124640">በሚተዳደር መለያ እየገቡ ነው፣ እና አስተዳዳሪው በእርስዎ Tomi መገለጫ ላይ ቁጥጥር እየሰጡት ነው። እንደ የእርስዎ መተግበሪያዎች፣ ዕልባቶች፣ ታሪክ፣ የይለፍ ቃላት እና ሌሎች ቅንብሮች ያሉ የእርስዎ Tomi ውሂብ እስከ መጨረሻው ከ<ph name="USER_NAME" /> ጋር የተያያዙ ይሆናሉ። ይህን ውሂብ በTomi የመለያዎች Dashboard አማካኝነት ሊሰርዙት ይችላሉ፣ ነገር ግን ይህን ውሂብ ከሌላ መለያ ጋር ሊያጎዳኙት አይችሉም። <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">በመጫን ላይ...</translation>
<translation id="4149882025268051530">ጫኝው መዝገብ ለመበተን አልቻለም። እባክዎ Tomiን እንደገና ያውርዱ።</translation>
<translation id="4191857738314598978">{0,plural, =1{በአንድ ቀን ውስጥ Tomiን ዳግም አስጀምር}one{በ# ቀኖች ውስጥ Tomiን ዳግም አስጀምር}other{በ# ቀኖች ውስጥ Tomiን ዳግም አስጀምር}}</translation>
<translation id="4205939740494406371">Tomi የእርስዎን የይለፍ ቃላት መፈተሽ አይችልም። ከ24 ሰዓቶች በኋላ እንደገና ይሞክሩ ወይም <ph name="BEGIN_LINK" />በTomi መለያዎ ውስጥ የይለፍ ቃላትን ይፈትሹ<ph name="END_LINK" />።</translation>
<translation id="4222932583846282852">በመሰረዝ ላይ...</translation>
<translation id="4242034826641750751">Tomi ለዚህ ጣቢያ የካሜራ እና የማይክሮፎን ፈቃዶች ያስፈልጉታል</translation>
<translation id="424864128008805179">ከTomi ተዘግቶ ይወጣ?</translation>
<translation id="4251615635259297716">የTomi ውሂብዎ ከዚህ መለያ ጋር ይገናኝ?</translation>
<translation id="4262915912852657291"><ph name="BEGIN_BOLD" />ምን ውሂብ ጥቅም ላይ እንደሚውል፦<ph name="END_BOLD" /> የአሰሳ ታሪክዎ፣ በዚህ መሣሪያ ላይ Tomiን ተጠቅመው የጎበኟቸው የጣቢያዎች መዝገብ።</translation>
<translation id="4281844954008187215">የአግልግሎት ውል</translation>
<translation id="4293420128516039005">Tomiን በመላ መሣሪያዎችዎ ላይ ለማሳመር እና ግላዊነት ለማላበስ</translation>
<translation id="430327780270213103">ቅጥያ በTomi የመሳሪያ አሞሌ ውስጥ የመዳረሻ ጥያቄዎችን እንዲያሳይ ፍቀድ</translation>
<translation id="4328355335528187361">Tomi ገንቢ (mDNS-In)</translation>
<translation id="4334294535648607276">ማውረድ ተጠናቅቋል።</translation>
<translation id="4335235004908507846">Tomi ደህንነትዎ ከውሂብ ጥሰቶች፣ ከመጥፎ ቅጥያዎች እና ተጨማሪ ነገሮች እንደተጠበቀ እንዲቆይ ሊያግዝ ይችላል</translation>
<translation id="4343195214584226067"><ph name="EXTENSION_NAME" /> ወደ Tomi ታክሏል</translation>
<translation id="4384570495110188418">እርስዎ በመለያ ስላልገቡ ስለሆኑ Tomi የይለፍ ቃላትዎን መፈተሽ አይችልም</translation>
<translation id="4427306783828095590">የተሻሻለ ጥበቃ ማስገር እና ተንኮል-አዘል ዌር ለማገድ የበለጠ ይሠራል</translation>
<translation id="4450664632294415862">Tomi - በአውታረ መረብ ወደ መለያ መግባት - <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">በTomi ላይ ሌላ ሥርዓተ ክወና በሂደት ላይ ነው። እባክዎ በኋላ ላይ እንደገና ይሞክሩ።</translation>
<translation id="4459234553906210702">የማስታወቂያ ልኬት እርስዎ የሚጎበኟቸው ጣቢያዎች የማስታወቂያዎቻቸውን አፈጻጸም የሚለካው ጣቢያ የሚያግዘውን መረጃ ከTomi እንዲጠይቁ ያስችላቸዋል። የማስታወቂያ ልኬት በተቻለ መጠን ትንሽ መረጃን በጣቢያዎች መካከል በማስተላለፍ የጣቢያ ተሻጋሪ ክትትልን ይገድባል።</translation>
<translation id="4561051373932531560">Tomi ድር ላይ ያለ ስልክ ቁጥር ጠቅ እንዲያደርጉት እና በSkype እንዲደውሉለት ያስችልዎታል!</translation>
<translation id="4567424176335768812">እንደ <ph name="USER_EMAIL_ADDRESS" /> ሆነው ገብተዋል። አሁን የእርስዎን ዕልባቶች፣ ታሪክ እና ሌሎች ቅንብሮች በመለያ በገቡ ሁሉም መሣሪያዎችዎ ላይ መድረስ ይችላሉ።</translation>
<translation id="4571503333518166079">ወደ Tomi ማሳወቂያ ቅንብሮች ይሂዱ</translation>
<translation id="459622048091363950">አንዴ Tomi መዳረሻ ከኖረው በኋላ ድር ጣቢያዎች እርስዎን መዳረሻ መጠየቅ ይችላሉ።</translation>
<translation id="4600710005438004015">Tomi ወደ የቅርብ ጊዜው ስሪት ሊዘመን አልቻለም፣ ስለዚህ አዲስ ባህሪያት እና የደህንነት ማስተካከያዎች እያመለጠዎት ነው።</translation>
<translation id="4627412468266359539">ግዴታ አይደለም፦ የምርመራ እና የአጠቃቀም ውሂብን በራስ-ሰር ወደ Tomi በመላክ የTomiOS Flex ባህሪያትን እና አፈጻጸምን እንዲሻሻል ያግዙ።</translation>
<translation id="4633000520311261472">Tomi ይበልጥ ደህንነቱ የተጠበቀ እንዲሆን ለማድረግ፣ በ<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ውስጥ ያልተጠቀሱ እና እርስዎ ሳያውቋቸው የታከሉ ሊሆኑ የሚችሉ የተወሰኑ ዝርዝሮችን አሰናክለናል።</translation>
<translation id="4680828127924988555">መጫኑን ሰርዝ</translation>
<translation id="469553575393225953">ካልታወቁ ምንጮች የመጡ ቅጥያዎች፣ መተግበሪያዎች እና ገጽታዎች መሣሪያዎን ሊጎዱ ይችላሉ። Tomi እነሱን ከTomi የድር መደብር ብቻ መጫንን ይመክራል</translation>
<translation id="4728575227883772061">ተለይቶ ባልታወቀ ስህተት ምክንያት ጭነት ከሽፏል። Tomi አሁን እያሄደ ከሆነ ፣ እባክዎ ይዝጉትና እንደገና ይሞክሩ።</translation>
<translation id="4747730611090640388">Tomi የእርስዎን ዝንባሌዎች ሊገምት ይችላል።  በኋላ ላይ እርስዎ የሚጎበኙት ጣቢያ እርስዎ የሚያዩዋቸውን ማስታወቂያዎች ግላዊነት ለማላበስ Tomi ዝንባሌዎችዎን እንዲያይ ሊጠይቅ ይችላል።</translation>
<translation id="4754614261631455953">Tomi Canary (mDNS-In)</translation>
<translation id="4771048833395599659">ይህ ፋይል አደገኛ ሊሆን ስለሚችል Tomi አግዶታል።</translation>
<translation id="479167709087336770">ይህ በ Tomi ፍለጋ ውስጥ ጥቅም ላይ ጋር ተመሳሳይ የፊደል አራሚ ይጠቀማል። በአሳሽ ውስጥ የሚተይቡት ጽሁፍ ወደ Tomi ይላካል። ይህን ባህሪ ሁልጊዜ በቅንብሮች ውስጥ መለወጥ ይችላሉ።</translation>
<translation id="4842397268809523050">ስምረት ለጎራዎ ስለማይገኝ TomiOS Flex ውሂብዎን ማስመር አልቻለም።</translation>
<translation id="4873783916118289636">በTomi ውስጥ ቁልፍ የግላዊነት እና የደህንነት ቁጥጥሮችን ይገምግሙ</translation>
<translation id="4891791193823137474">Tomi በጀርባ ውስጥ ይሂድ</translation>
<translation id="4895437082222824641">አገናኝ በአዲስ የTomi &amp;ትር ውስጥ ክፈት</translation>
<translation id="4953650215774548573">Tomiን እንደ ነባሪ አሳሽዎ አድርገው ያቀናብሩ</translation>
<translation id="495931528404527476">በTomi ውስጥ</translation>
<translation id="4969674060580488087">የመለያ መግቢያ ዝርዝሮችዎ ጊዜ ያለፈባቸው ስለሆኑ TomiOS Flex ውሂብዎን ማስመር አልቻለም።</translation>
<translation id="4970761609246024540">ወደ Tomi መገለጫዎች እንኳን በደህና መጡ</translation>
<translation id="4970880042055371251">የTomiOS ስሪት</translation>
<translation id="4970947549776831107">እንደዚህ አይነት ፋይል አደገኛ ስለሆነ Tomi ይህን ፋይል አግዶታል።</translation>
<translation id="4990567037958725628">Tomi Canary</translation>
<translation id="5037581483200764584">የወደፊት የTomi ዝመኔዎችን ለማግኘት፣ macOS 10.13 ወይም ከዚያ በኋላ ያለው ያስፈልግዎታል። ይህ ኮምፒተር OS X 10.11 እየተጠቀመ ነው።</translation>
<translation id="5098668839038261629">ሲበራ ከTomi ዘግተው እንዲወጡም ይደረጋሉ</translation>
<translation id="5132929315877954718">ለTomi ምርጥ መተግበሪያዎችን፣ ጨዋታዎችን፣ ቅጥያዎችን እና ገጽታዎችን ያግኙ።</translation>
<translation id="5139423532931106058">የTomi መገለጫዎን ያብጁ</translation>
<translation id="5163087008893166964">እንኳን ወደ Tomi በደህና መጡ፤ አዲስ የአሳሽ መስኮት ተከፍቷል።</translation>
<translation id="5170938038195470297">መገለጫዎ የአዲስ Tomi ስሪት አካል ስለሆነ መጠቀም አይቻልም።

አንዳንድ ባሕሪያት ላይገኙ ይችላሉ። እባክዎ የተለየ የመገለጫ አቃፊ ይግለጹ ወይም አዲሱን የTomi ስሪት ይጠቀሙ።</translation>
<translation id="521447420733633466">መሣሪያ የሚያጋሩ ከሆኑ ጓደኛዎች እና ቤተሰብ ተለይተው ሊያስሱ እና Tomiን በሚፈልጉበት መንገድ ማዋቀር ይችላሉ</translation>
<translation id="5251420635869119124">እንግዳዎች ምንም ነገር ሳይተዉ Tomiን መጠቀም ይችላሉ።</translation>
<translation id="5334309298019785904">ማስመር ለጎራዎ ስለማይገኝ TomiOS ውሂብዎን ማስመር አልቻለም።</translation>
<translation id="5334487786912937552">Tomi ፋይሎችን ለማውረድ የማከማቻ መዳረሻ ፈቃድ ያስፈልገዋል</translation>
<translation id="5337648990166757586">ከተፈለገ፦ የምርመራ እና የአጠቃቀም ውሂብ ወደ Tomi በራስ-ሰር በመላክ የTomiOS ባህሪያትን እና አፈጻጸምን እንዲሻሻል ያግዙ።</translation>
<translation id="5357889879764279201">በTomiOS Flex ላይ እገዛን ያግኙ</translation>
<translation id="5386244825306882791">እንዲሁም Tomiን ሲጀምሩት ወይም ከኦምኒቦክሱ ሆነው ሲፈልጉ የሚታየውን ገጽ ይቆጣጠራል።</translation>
<translation id="5394833366792865639">አንድ የTomi ትር ያጋሩ</translation>
<translation id="5412485296464121825">ጣቢያዎች በTomi አማካኝነት ስለዝንባሌዎችዎ መረጃን ማከማቸት ይችላሉ። ለምሳሌ፣ ለማራቶን ጫማ ለመግዛት ጣቢያን ከጎበኙ ጣቢያው ዝንባሌዎን እንደ ማራቶን መሮጥ ሊገልጽ ይችላል። በኋላ ላይ ለሩጫ ለመመዝገብ ሌላ ጣቢያ ከጎበኙ ይህ ጣቢያ በዝንባሌዎችዎ ላይ ተመስርቶ የመሮጫ ጫማ ማስታወቂያ ሊያሳየዎት ይችላል።</translation>
<translation id="5430073640787465221">የምርጫዎችዎ ፋይል ተበላሽቷል ወይም ልክ አይደለም ነው።

Tomi ቅንጅቶችዎን ማስመለስ አልቻለም።</translation>
