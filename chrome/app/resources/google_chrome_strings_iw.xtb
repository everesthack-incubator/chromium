<!DOCTYPE translationbundle>
<translationbundle lang="iw">
<translation id="1001534784610492198">‏הארכיון של המתקין פגום או שאינו חוקי. יש להוריד שוב את Decentr.</translation>
<translation id="1026101648481255140">המשך בהתקנה</translation>
<translation id="102763973188675173">‏כדי להתאים אישית את Decentr ולשלוט בו טוב יותר, יש להוריד את העדכון החדש.</translation>
<translation id="1051826050538111504">‏יש במחשב שלך תוכנה מזיקה. Decentr יכול להסיר אותה, לשחזר את ההגדרות שלך ולהשבית תוספים כדי שהדפדפן יחזור שוב לפעולה רגילה.</translation>
<translation id="1065672644894730302">לא הייתה אפשרות לקרוא את ההעדפות שלך. ייתכן שחלק מהתכונות לא יהיו זמינות ושינויים בהעדפות לא יישמרו.</translation>
<translation id="1088300314857992706">‏בכתובת <ph name="USER_EMAIL_ADDRESS" /> השתמשו בעבר ב-Decentr</translation>
<translation id="110877069173485804">‏זה ה-Decentr שלך</translation>
<translation id="1125124144982679672">‏מי משתמש/ת ב-Decentr?</translation>
<translation id="1142745911746664600">‏לא ניתן לעדכן את Decentr</translation>
<translation id="1152920704813762236">‏מידע על DecentrOS</translation>
<translation id="1154147086299354128">‏&amp;פתיחה ב-Decentr</translation>
<translation id="1203500561924088507">תודה שהתקנת. עליך להפעיל מחדש את הדפדפן לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="1236866257838264361">‏אפשר ליהנות מהמיטב של Decentr</translation>
<translation id="1278833599417554002">‏הפעלה מחדש לצורך עדכון &amp;Decentr</translation>
<translation id="1302523850133262269">‏יש להמתין בזמן ש-Decentr מתקין את עדכוני המערכת האחרונים.</translation>
<translation id="1335640173511558774">‏לפי דרישת <ph name="MANAGER" />, צריך לקרוא את התנאים וההגבלות הבאים ולהסכים להם לפני השימוש במכשיר הזה. התנאים האלה לא מרחיבים, משנים או מגבילים את התנאים לשימוש ב-DecentrOS Flex.</translation>
<translation id="1363996462118479832">‏לא בוצע סנכרון של הנתונים ב-DecentrOS בגלל שגיאה בתהליך הכניסה.</translation>
<translation id="137466361146087520">‏גרסת הבטא של Decentr</translation>
<translation id="1399397803214730675">‏במחשב זה מותקנת כבר גרסה עדכנית יותר של Decentr. אם התוכנה אינה פועלת, יש להסיר את ההתקנה של Decentr ולנסות שוב.</translation>
<translation id="139993653570221430">‏יש לך אפשרות לשנות את הבחירה בכל שלב בהגדרות של Decentr. גרסאות הניסיון יפעלו במקביל לשיטה הנוכחית של הצגת המודעות, אז השינויים לא יורגשו מיד.</translation>
<translation id="1434626383986940139">‏אפליקציות Decentr – קאנארי</translation>
<translation id="1507198376417198979">‏רוצה להתאים אישית את פרופיל Decentr?</translation>
<translation id="1516530951338665275">‏ל-Decentr נדרשת גישה ל-Bluetooth כדי להמשיך 
 את ההתאמה. <ph name="IDS_BLUETOOTH_DEVICE_CHOOSER_AUTHORIZE_BLUETOOTH_LINK" /></translation>
<translation id="1547295885616600893">‏<ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת מאפשרת את השימוש ב-DecentrOS.</translation>
<translation id="1553358976309200471">‏כדאי לעדכן את Decentr</translation>
<translation id="1583073672411044740">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל Decentr הזה. ייווצר פרופיל Decentr חדש בשביל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="1587223624401073077">‏Decentr משתמש במצלמה שלך.</translation>
<translation id="1587325591171447154">‏<ph name="FILE_NAME" /> מסוכן, ולכן Decentr חסם אותו.</translation>
<translation id="1597911401261118146">‏כדי לבדוק אם שאר הסיסמאות מוגנות מפני פרצות באבטחת מידע ובעיות אבטחה אחרות, <ph name="BEGIN_LINK" />יש להיכנס ל-Decentr<ph name="END_LINK" />.</translation>
<translation id="1599904803480101533">‏קובץ הארכיון הזה נחסם על ידי Decentr כי הוא עלול להסתיר תוכנה זדונית</translation>
<translation id="1619887657840448962">‏כדי לשפר את האבטחה של Decentr, השבתנו את התוסף הבא שאינו רשום ב-<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוסף ללא ידיעתך.</translation>
<translation id="1627304841979541023">‏<ph name="BEGIN_BOLD" />איך ניתן לנהל את הנתונים שלך:<ph name="END_BOLD" /> כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. יש גם אפשרות להסיר תחומי עניין מ-Decentr כדי שלא יילקחו בחשבון.</translation>
<translation id="1628000112320670027">‏קבלת עזרה בנושא Decentr</translation>
<translation id="1640672724030957280">מוריד...</translation>
<translation id="1662146548738125461">‏מידע על DecentrOS Flex</translation>
<translation id="1674870198290878346">‏פתיחת הקישור בחלון &amp;אנונימי של Decentr</translation>
<translation id="1682634494516646069">‏Decentr אינו יכול לקרוא ולכתוב בספריית הנתונים שלו: <ph name="USER_DATA_DIRECTORY" /></translation>
<translation id="1691802391966922744">{COUNT,plural, =1{‏בהתאם להגדרה של האדמין, Decentr ייסגר אם הוא לא פעיל במשך יותר מדקה.}one{‏בהתאם להגדרה של האדמין, Decentr ייסגר אם הוא לא פעיל במשך יותר מ-# דקות.}two{‏בהתאם להגדרה של האדמין, Decentr ייסגר אם הוא לא פעיל במשך יותר מ-# דקות.}other{‏בהתאם להגדרה של האדמין, Decentr ייסגר אם הוא לא פעיל במשך יותר מ-# דקות.}}</translation>
<translation id="1698376642261615901">‏Decentr הוא דפדפן אינטרנט המפעיל דפי אינטרנט ואפליקציות במהירות הבזק. זהו דפדפן מהיר, יציב וקל לשימוש. הגלישה באינטרנט בטוחה יותר הודות להגנה מפני תוכנות זדוניות ופישינג, המובנית ב-Decentr.</translation>
<translation id="1713301662689114961">{0,plural, =1{‏Decentr יופעל מחדש בעוד שעה}one{‏Decentr יופעל מחדש בעוד # שעות}two{‏Decentr יופעל מחדש בעוד # שעות}other{‏Decentr יופעל מחדש בעוד # שעות}}</translation>
<translation id="1734234790201236882">‏הסיסמה הזאת תישמר על ידי Decentr בחשבון Decentr. אין צורך לזכור אותה.</translation>
<translation id="1759842336958782510">Decentr</translation>
<translation id="1786003790898721085">‏יש לוודא שנכנסת ל-Decentr ב-<ph name="TARGET_DEVICE_NAME" /> ולשלוח שוב.</translation>
<translation id="1812689907177901597">‏כיבוי הגדרה זו יאפשר לך להיכנס לאתרי Decentr, כמו Gmail, בלי להיכנס אל Decentr</translation>
<translation id="1860536484129686729">‏Decentr זקוק להרשאת גישה למצלמה בשביל האתר הזה</translation>
<translation id="1873233029667955273">‏Decentr‏ אינו דפדפן ברירת המחדל שלך</translation>
<translation id="1874309113135274312">‏גרסת הביטא של Decentr‏ (mDNS-In)</translation>
<translation id="1877026089748256423">‏Decentr אינו מעודכן</translation>
<translation id="1919130412786645364">‏התרת כניסה אל Decentr</translation>
<translation id="1952239763774043237">‏כדי לקבל עדכונים של Decentr בעתיד, צריך להשתמש ב-macOS מגרסה 10.13 ואילך. במחשב הזה מותקנת מערכת ההפעלה macOS 10.12.</translation>
<translation id="1953553007165777902">מתבצעת הורדה… יש עוד <ph name="MINUTE" /> דק'</translation>
<translation id="2018528049276128029">‏בכל פרופיל מאוחסנים נתוני Decentr משלו כמו סימניות, היסטוריה, סיסמאות ועוד</translation>
<translation id="2018879682492276940">ההתקנה נכשלה. יש לנסות שוב.</translation>
<translation id="2071318482926839249">‏כבר מחובר חשבון אחר. כדי להפריד בין פעילויות גלישה, Decentr יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="207902854391093810">‏כשגרסאות הניסיון פעילות, מדידת המודעות מאפשרת לאתרים שבהם ביקרת לבקש מ-Decentr מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="2091012649849228750">‏כדי לקבל עדכונים של Decentr בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.</translation>
<translation id="2094648590148273905">‏התנאים של DecentrOS Flex</translation>
<translation id="2094919256425865063">‏לסגור את Decentr בכל זאת?</translation>
<translation id="2106831557840787829">‏השימוש ב-DecentrOS Flex מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת כמו <ph name="BEGIN_LINK_LINUX_OSS" />סביבת הפיתוח של Linux<ph name="END_LINK_LINUX_OSS" />.</translation>
<translation id="2120620239521071941">‏פעולה זו תמחק <ph name="ITEMS_COUNT" /> פריטים מהמכשיר. כדי לשחזר את הנתונים מאוחר יותר, יש להיכנס אל Decentr עם <ph name="USER_EMAIL" />.</translation>
<translation id="2121284319307530122">‏הפעלה מחדש לצורך עדכון &amp;Decentr</translation>
<translation id="2123055963409958220">‏דיווח על <ph name="BEGIN_LINK" />ההגדרות הנוכחיות<ph name="END_LINK" /> יעזור לשפר את Decentr</translation>
<translation id="2131230230468101642">‏כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. יש גם אפשרות להסיר תחומי עניין מ-Decentr כדי שלא יילקחו בחשבון.</translation>
<translation id="2139300032719313227">‏הפעלה מחדש של DecentrOS</translation>
<translation id="2151406531797534936">‏יש להפעיל מחדש את Decentr עכשיו</translation>
<translation id="2174917724755363426">ההתקנה לא הושלמה. להמשיך בביטול?</translation>
<translation id="223889379102603431">‏מידע על האופן שבו Decentr מנהל את אישורי הבסיס שלו</translation>
<translation id="2258103955319320201">‏כדי לקבל גישה אל הפריטים שלך בדפדפן Decentr בכל המכשירים, צריך להיכנס לחשבון ולהפעיל את הסנכרון</translation>
<translation id="2290014774651636340">‏המפתחות של Decentr API חסרים. פונקציונליות מסוימת של Decentr תהיה מושבתת.</translation>
<translation id="2290095356545025170">‏ברצונך באמת להסיר את Decentr?</translation>
<translation id="2309047409763057870">‏זוהי התקנה משנית של Decentr, ולא ניתן להפוך אותו לדפדפן ברירת המחדל שלך.</translation>
<translation id="2345992953227471816">‏התוספים האלה שנמצאו ב-Decentr מכילים תכונה זדונית:</translation>
<translation id="2348335408836342058">‏Decentr זקוק להרשאת גישה אל המצלמה והמיקרופון בשביל האתר הזה</translation>
<translation id="234869673307233423">‏Decentr לא יכול לבדוק את הסיסמאות שלך. כדאי לנסות שוב מאוחר יותר.</translation>
<translation id="235650106824528204">‏המנהל של פרופיל העבודה יכול להסיר נתוני Decentr שמופקים בזמן השימוש בפרופיל (כמו יצירת סימניות, היסטוריה, סיסמאות והגדרות נוספות). <ph name="LEARN_MORE" /></translation>
<translation id="2359808026110333948">המשך</translation>
<translation id="2401189691232800402">‏מערכת DecentrOS</translation>
<translation id="2467438592969358367">‏Decentr רוצה לייצא את הסיסמאות שלך. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="2485422356828889247">הסרת התקנה</translation>
<translation id="2534507159460261402">‏Decentr Pay (‏הועתק ל-Decentr)</translation>
<translation id="2559253115192232574">‏לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-Decentr כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך. Decentr יכול לשתף עד 3 תחומי עניין.</translation>
<translation id="2563121210305478421">‏להפעיל את Decentr מחדש?</translation>
<translation id="2574930892358684005">‏המשתמש <ph name="EXISTING_USER" /> כבר מחובר לפרופיל Decentr הזה. כדי להפריד בין פעילויות גלישה, Decentr יכול ליצור עבורך פרופיל משלך.</translation>
<translation id="2580411288591421699">‏אין אפשרות להתקין את אותה גרסת Decentr הפועלת כעת. יש לסגור את Decentr ולנסות שוב.</translation>
<translation id="2586406160782125153">‏הפעולה תמחק את נתוני הגלישה מהמכשיר. כדי לאחזר את הנתונים מאוחר יותר, יש להיכנס אל Decentr עם <ph name="USER_EMAIL" />.</translation>
<translation id="2597976513418770460">‏אפשר לקבל את הנתונים של <ph name="ACCOUNT_EMAIL" /> ולשמור אותם בדפדפן Decentr</translation>
<translation id="2622559029861875898">‏Decentr לא יכול לחפש עדכונים. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="2645435784669275700">DecentrOS</translation>
<translation id="2652691236519827073">‏פתיחת הקישור ב&amp;כרטיסיית Decentr חדשה</translation>
<translation id="2665296953892887393">‏שיפור Decentr על ידי שליחת <ph name="UMA_LINK" /> ודוחות קריסה אל Decentr</translation>
<translation id="2689103672227170538">‏התוסף הזה שינה את הדף שמוצג כש-Decentr מופעל.</translation>
<translation id="2742320827292110288">‏אזהרה: Decentr לא יכול למנוע מתוספים לתעד את היסטוריית הגלישה שלך. כדי להשבית את התוסף הזה במצב אנונימי, יש לבטל את הבחירה באפשרות הזו.</translation>
<translation id="2765403129283291972">‏Decentr זקוק להרשאת גישה למיקרופון בשביל האתר הזה</translation>
<translation id="2770231113462710648">שינוי דפדפן ברירת המחדל ל:</translation>
<translation id="2775140325783767197">‏Decentr לא יכול לבדוק את הסיסמאות שלך. יש לבדוק את החיבור לאינטרנט.</translation>
<translation id="2799223571221894425">הפעלה מחדש</translation>
<translation id="2847461019998147611">‏הצגת Decentr בשפה זו</translation>
<translation id="2857540653560290388">‏הפעלת Decentr...</translation>
<translation id="2857972467023607093">‏כבר קיים פרופיל Decentr עם החשבון הזה</translation>
<translation id="2861074815332034794">‏מתבצע עדכון של Decentr (<ph name="PROGRESS_PERCENT" />)</translation>
<translation id="2871893339301912279">‏נכנסת ל-Decentr!</translation>
<translation id="2885378588091291677">מנהל המשימות</translation>
<translation id="2888126860611144412">‏מידע כללי על Decentr</translation>
<translation id="2915996080311180594">הפעלה מחדש מאוחר יותר</translation>
<translation id="2926676257163822632">‏קל לנחש סיסמאות חלשות. באמצעות Decentr אפשר <ph name="BEGIN_LINK" />ליצור ולזכור סיסמאות חזקות<ph name="END_LINK" />.</translation>
<translation id="2926952073016206995">‏נדרשת הרשאת גישה למצלמה ב-Decentr עבור האתר הזה</translation>
<translation id="2928420929544864228">ההתקנה הושלמה.</translation>
<translation id="2929907241665500097">‏Decentr לא התעדכן, משהו השתבש. <ph name="BEGIN_LINK" />לטיפול בבעיות בעדכון של Decentr ובעדכונים שנכשלו<ph name="END_LINK" /></translation>
<translation id="2969728957078202736">‏<ph name="PAGE_TITLE" /> – כניסה לרשת – Decentr</translation>
<translation id="3019382870990049182">‏צריך להפעיל מחדש כדי לעדכן את DecentrOS Flex</translation>
<translation id="303514781271618814">‏אנחנו בודקים תכונות חדשות ב-Decentr שמאפשרות לאתרים להציג את אותה חוויית הגלישה תוך שימוש בפחות נתונים.</translation>
<translation id="3037838751736561277">‏Decentr נמצא במצב רקע.</translation>
<translation id="3038232873781883849">בהמתנה להתקנה…</translation>
<translation id="3059710691562604940">‏הגלישה הבטוחה כבויה. ההמלצה של Decentr היא להפעיל אותה.</translation>
<translation id="3065168410429928842">‏כרטיסייה של Decentr</translation>
