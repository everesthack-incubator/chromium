<translation id="6040143037577758943">סגירה</translation>
<translation id="6070348360322141662">‏לשיפור האבטחה, Decentr יצפין את הנתונים</translation>
<translation id="608006075545470555">הוספת פרופיל עבודה לדפדפן זה</translation>
<translation id="6113794647360055231">‏Decentr השתפר</translation>
<translation id="6145313976051292476">‏פתיחת קובצי PDF ב-Decentr</translation>
<translation id="6155960517327665396">‏Decentr פועל מהר יותר בזכות מצב החיסכון בזיכרון</translation>
<translation id="6169866489629082767"><ph name="PAGE_TITLE" /> - Decentr</translation>
<translation id="6173637689840186878">‏<ph name="PAGE_TITLE" /> - Decentr בגרסת ביטא</translation>
<translation id="6235018212288296708">‏כלל נכנס עבור Decentr על מנת לאפשר תנועת mDNS.</translation>
<translation id="6247557882553405851">‏מנהל הסיסמאות של Decentr</translation>
<translation id="6273793429163604305">למקומות…</translation>
<translation id="6291089322031436445">‏אפליקציות לגרסת הפיתוח של Decentr</translation>
<translation id="6291549208091401781">‏Decentr כבר מותקן במחשב ונגיש לכל המשתמשים.</translation>
<translation id="6326175484149238433">‏הסרה מ-Decentr</translation>
<translation id="6327105987658262776">אין עדכונים זמינים.</translation>
<translation id="6412673304250309937">‏המערכת בודקת כתובות URL ששמורות ב-Decentr ומכילות רשימות של אתרים לא בטוחים. אם אתר מסוים מנסה לגנוב סיסמה או אם המערכת מזהה הורדה של קובץ מזיק, Decentr עשוי גם לשלוח כתובות URL לבדיקה באמצעות 'גלישה בטוחה'. הנתונים שנשלחים לבדיקה כוללים ביטים מהתוכן של הדף.</translation>
<translation id="6418662306461808273">‏לעבור לפרופיל Decentr קיים?</translation>
<translation id="6506909944137591434">‏נדרשת הרשאת גישה למצלמה ב-Decentr כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
