<translation id="3785324443014631273">‏לא ניתן היה לסנכרן את הנתונים ב-DecentrOS Flex בגלל שגיאה בכניסה.</translation>
<translation id="3795971588916395511">DecentrOS</translation>
<translation id="3835168907083856002">‏ייווצר פרופיל Decentr חדש בשביל <ph name="USER_EMAIL_ADDRESS" />.</translation>
<translation id="386202838227397562">‏יש לסגור את כל החלונות של Decentr ולנסות שוב.</translation>
<translation id="3865754807470779944">‏מותקנת גרסה <ph name="PRODUCT_VERSION" /> של Decentr</translation>
<translation id="3873044882194371212">‏פתיחת הקישור בחלון &amp;אנונימי של Decentr</translation>
<translation id="3889417619312448367">‏הסרת Decentr</translation>
<translation id="3999683152997576765">‏יש לך אפשרות לראות ולהסיר את תחומי העניין שלפיהם האתרים מציגים לך את המודעות. ההערכה של תחומי העניין ב-Decentr מתבססת על היסטוריית הגלישה שלך מהזמן האחרון.</translation>
<translation id="4035053306113201399">‏יש להפעיל מחדש את DecentrOS כדי להחיל את העדכון.</translation>
<translation id="4050175100176540509">הגרסה החדשה כוללת שיפורי בטיחות חשובים ותכונות חדשות.</translation>
<translation id="4053720452172726777">‏הגדרת Decentr בהתאם לרצונך</translation>
<translation id="4106587138345390261">‏אנחנו בודקים תכונות חדשות ב-Decentr שמאפשרות לאתרים לספק את אותה חוויית הגלישה תוך שימוש בפחות פרטים אישיים</translation>
<translation id="4110895483821904099">‏הגדרת הפרופיל החדש שלך ב-Decentr</translation>
<translation id="4147555960264124640">‏בחרת להיכנס לחשבון מנוהל, ומנהל המערכת שלו יקבל שליטה על הפרופיל שלך ב-Decentr. הנתונים שלך ב-Decentr, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות מרכז השליטה של חשבונות Decentr, אבל לא ניתן יהיה לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE" /></translation>
<translation id="4148957013307229264">מתקין...</translation>
<translation id="4149882025268051530">‏המתקין נכשל בביצוע דחיסה לארכיון. יש להוריד שוב את Decentr.</translation>
<translation id="4191857738314598978">{0,plural, =1{‏צריך להפעיל מחדש את Decentr תוך יום אחד}one{‏צריך להפעיל מחדש את Decentr תוך # ימים}two{‏צריך להפעיל מחדש את Decentr תוך # ימים}other{‏צריך להפעיל מחדש את Decentr תוך # ימים}}</translation>
<translation id="4205939740494406371">‏Decentr לא יכול לבדוק את הסיסמאות שלך. יש לנסות שוב בעוד 24 שעות או <ph name="BEGIN_LINK" />לבדוק את הסיסמאות בחשבון Decentr<ph name="END_LINK" />.</translation>
<translation id="4222932583846282852">מבטל…</translation>
<translation id="4242034826641750751">‏נדרשות הרשאות גישה למצלמה ולמיקרופון ב-Decentr עבור האתר הזה</translation>
<translation id="424864128008805179">‏האם לצאת מ-Decentr?</translation>
<translation id="4251615635259297716">‏האם לקשר את הנתונים שלך ב-Decentr לחשבון זה?</translation>
<translation id="4262915912852657291">‏<ph name="BEGIN_BOLD" />באילו נתונים נעשה שימוש:<ph name="END_BOLD" /> היסטוריית הגלישה – תיעוד האתרים שביקרת בהם באמצעות Decentr במכשיר הזה.</translation>
<translation id="4281844954008187215">תנאי שירות</translation>
<translation id="4293420128516039005">‏כניסה לחשבון תסנכרן ותתאים אישית את Decentr בכל המכשירים שברשותך</translation>
<translation id="430327780270213103">‏מתן הרשאה לתוסף להציג בקשות גישה בסרגל הכלים של Decentr</translation>
<translation id="4328355335528187361">‏גרסת הפיתוח של Decentr ‏(mDNS-In)</translation>
<translation id="4334294535648607276">ההורדה הושלמה.</translation>
<translation id="4335235004908507846">‏Decentr עוזר להגן עליך מפני פרצות באבטחת המידע, תוספים לא תקינים ועוד</translation>
<translation id="4343195214584226067">‏<ph name="EXTENSION_NAME" /> נוסף ל-‏Decentr</translation>
<translation id="4384570495110188418">‏Decentr לא יכול לבדוק את הסיסמאות שלך כי לא נכנסת לחשבון</translation>
<translation id="4427306783828095590">עם ההגנה המשופרת, החסימה של פישינג ותוכנות זדוניות מקיפה יותר</translation>
<translation id="4450664632294415862">‏Decentr – כניסה לרשת – <ph name="PAGE_TITLE" /></translation>
<translation id="4458462641685292929">‏מתבצעת כרגע פעולה אחרת ב-Decentr. יש לנסות שוב מאוחר יותר.</translation>
<translation id="4459234553906210702">‏מדידת המודעות מאפשרת לאתרים שביקרת בהם לבקש מ-Decentr מידע שיעזור לבעלי האתרים למדוד את הביצועים של המודעות שלהם. מדידת המודעות מגבילה את המעקב באתרים שונים על ידי העברת כמות קטנה ככל האפשר של מידע בין אתרים.</translation>
<translation id="4561051373932531560">‏Decentr מאפשר לך ללחוץ על מספר טלפון באינטרנט ולהתקשר אליו באמצעות Skype!</translation>
<translation id="4567424176335768812">נכנסת למערכת בתור <ph name="USER_EMAIL_ADDRESS" />. כעת יש לך אפשרות לגשת אל הסימניות, ההיסטוריה והגדרות אחרות שלך בכל המכשירים שבהם התחברת לחשבון.</translation>
<translation id="4571503333518166079">‏מעבר אל הגדרות של הודעות ב-Decentr</translation>
<translation id="459622048091363950">‏אחרי מתן גישה ל-Decentr, אתרים יוכלו לבקש ממך גישה.</translation>
<translation id="4600710005438004015">‏עדכון Decentr לגרסה האחרונה לא הצליח, ולכן אין לך גישה אל תכונות חדשות ותיקוני אבטחה.</translation>
<translation id="4627412468266359539">‏אופציונלי: שליחה אוטומטית של נתוני השימוש וניתוח הביצועים אל Decentr תעזור לשפר את התכונות ואת הביצועים של DecentrOS Flex.</translation>
<translation id="4633000520311261472">‏כדי לשפר את האבטחה של Decentr, השבתנו חלק מהתוספים שלא רשומים ב<ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> וייתכן שנוספו ללא ידיעתך.</translation>
<translation id="4680828127924988555">ביטול ההתקנה</translation>
<translation id="469553575393225953">‏תוספים, אפליקציות ועיצובים ממקורות לא מוכרים עלולים להזיק למכשיר. ההמלצה של Decentr היא להתקין אותם רק מחנות האינטרנט של Decentr</translation>
<translation id="4728575227883772061">‏ההתקנה נכשלה בשל שגיאה לא צפויה. אם Decentr פועל כעת, יש לסגור אותו ולנסות שוב.</translation>
<translation id="4747730611090640388">‏Decentr יכול להעריך מהם תחומי העניין שלך.  לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-Decentr כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך.</translation>
<translation id="4754614261631455953">‏גרסה ניסיונית של Decentr‏ (mDNS-In)</translation>
<translation id="4771048833395599659">‏Decentr‏ חסם את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="479167709087336770">‏נעשה כאן שימוש בבדיקת האיות של חיפוש Decentr. הטקסט המוקלד בדפדפן נשלח אל Decentr. אפשר לשנות את ההתנהגות הזו בכל שלב דרך ההגדרות.</translation>
<translation id="4842397268809523050">‏לא ניתן היה לסנכרן את הנתונים שלך ב-DecentrOS Flex כי הסנכרון לא זמין בדומיין שלך.</translation>
<translation id="4873783916118289636">‏בדיקה של אמצעי הבקרה החשובים ביותר על פרטיות ואבטחה ב-Decentr</translation>
<translation id="4891791193823137474">‏לאפשר ל-Decentr לפעול ברקע</translation>
<translation id="4895437082222824641">‏פתיחת הקישור ב&amp;כרטיסיית Decentr חדשה</translation>
<translation id="4953650215774548573">‏הגדרת Decentr כדפדפן ברירת המחדל</translation>
<translation id="495931528404527476">‏ב-Decentr</translation>
<translation id="4969674060580488087">‏לא ניתן לסנכרן את הנתונים שלך ב-DecentrOS Flex כי פרטי הכניסה של החשבון שלך לא מעודכנים.</translation>
<translation id="4970761609246024540">‏ברוך בואך לפרופילים של Decentr</translation>
<translation id="4970880042055371251">‏גרסת DecentrOS</translation>
<translation id="4970947549776831107">‏סוג הקובץ הזה מסוכן ולכן הקובץ נחסם על ידי Decentr</translation>
<translation id="4990567037958725628">Decentr Canary</translation>
<translation id="5037581483200764584">‏כדי לקבל עדכונים של Decentr בעתיד, צריך להשתמש ב-macOS מגרסה 10.13 ואילך. במחשב הזה פועלת מערכת ההפעלה ‎OS X 10.11.</translation>
<translation id="5098668839038261629">‏כשההגדרה מופעלת, תתבצע יציאה גם מ-Decentr</translation>
<translation id="5132929315877954718">‏מקום לגלות אפליקציות, משחקים, תוספים ועיצובים מעולים ל-Decentr.</translation>
<translation id="5139423532931106058">‏התאמה אישית של פרופיל Decentr</translation>
<translation id="5163087008893166964">‏ברוך בואך אל Decentr. נפתח חלון חדש בדפדפן</translation>
<translation id="5170938038195470297">‏לא ניתן להשתמש בפרופיל שלך משום שהוא מגרסה חדשה יותר של Decentr. ייתכן שחלק מהתכונות לא יהיו זמינות. ציין ספריית פרופיל אחרת או השתמש בגרסה חדשה יותר של Decentr.</translation>
<translation id="521447420733633466">‏כשמשתפים מכשיר, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את Decentr בדיוק כפי שהם רוצים</translation>
<translation id="5251420635869119124">‏אורחים יכולים להשתמש ב-Decentr בלי להשאיר עקבות.</translation>
<translation id="5334309298019785904">‏לא בוצע סנכרון של הנתונים ב-DecentrOS כי הסנכרון לא זמין לדומיין שלך.</translation>
<translation id="5334487786912937552">‏נדרשת הרשאת גישה לאחסון ב-Decentr כדי להוריד את קבצים</translation>
<translation id="5337648990166757586">‏אופציונלי: שליחה אוטומטית של נתוני אבחון ונתוני שימוש במכשיר אל Decentr תעזור לשפר את התכונות ואת הביצועים של DecentrOS.</translation>
<translation id="5357889879764279201">‏קבלת עזרה לגבי DecentrOS Flex</translation>
<translation id="5386244825306882791">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Decentr או כשמבצעים חיפוש מסרגל הכתובות.</translation>
<translation id="5394833366792865639">‏שיתוף כרטיסיית Decentr</translation>
<translation id="5412485296464121825">‏אתרים יכולים לשמור מידע ב-Decentr לגבי תחומי העניין שלך. לדוגמה, אם ביקרת באתר כדי לקנות נעליים למרתון, האתר עשוי להגדיר 'ריצת מרתון' כתחום עניין שלך. לאחר מכן, בביקור באתר שונה, למשל כדי להירשם למרוץ, יכול להיות שתוצג לך מודעה לנעלי ריצה על סמך תחומי העניין שלך.</translation>
<translation id="5430073640787465221">‏קובץ ההעדפות שלך פגום או לא חוקי. Decentr לא יכול לשחזר את ההגדרות שלך.</translation>
<translation id="5524761631371622910">‏כשגרסאות הניסיון פעילות, ובמקרים שבהם צורפת באופן אקראי לגרסת ניסיון פעילה ב-Decentr, היסטוריית הגלישה שלך משפיעה על המודעות שמוצגות לך ועל תחומי העניין המשוערים שמופיעים בהמשך. כדי להגן על הפרטיות שלך, מתבצעת ב-Decentr מחיקה של תחומי העניין שלך על בסיס מתחלף מדי חודש.</translation>
<translation id="5530733413481476019">‏שיפור המהירות ב-Decentr</translation>
<translation id="556024056938947818">‏Decentr מנסה להציג סיסמאות.</translation>
<translation id="5566025111015594046">‏Decentr‏ (mDNS-In)</translation>
<translation id="565744775970812598">‏<ph name="FILE_NAME" /> עלול להיות מסוכן, ולכן Decentr חסם אותו.</translation>
<translation id="5678190148303298925">{COUNT,plural, =0{‏מנהל המערכת מבקש להפעיל מחדש את Decentr כדי להחיל את העדכון הזה}=1{‏מנהל המערכת מבקש להפעיל מחדש את Decentr כדי להחיל את העדכון הזה. החלון האנונימי לא ייפתח מחדש.}one{‏מנהל המערכת מבקש להפעיל מחדש את Decentr כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏מנהל המערכת מבקש להפעיל מחדש את Decentr כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏מנהל המערכת מבקש להפעיל מחדש את Decentr כדי להחיל את העדכון הזה. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="5686916850681061684">‏התאמה אישית וניהול של Decentr. נחוצה פעולה שלך - יש ללחוץ לקבלת פרטים נוספים.</translation>
<translation id="5690427481109656848">Decentr LLC</translation>
<translation id="5715063361988620182">{SECONDS,plural, =1{‏Decentr יבצע אתחול בעוד שנייה אחת}one{‏Decentr יבצע אתחול בעוד # שניות}two{‏Decentr יבצע אתחול בעוד # שניות}other{‏Decentr יבצע אתחול בעוד # שניות}}</translation>
<translation id="5727531838415286053">‏אם צורפת באופן אקראי לגרסת ניסיון פעילה ב-Decentr, היסטוריית הגלישה שלך משפיעה על המודעות שמוצגות לך ועל תחומי העניין המשוערים שמופיעים בהמשך. כדי להגן על הפרטיות שלך, מתבצעת ב-Decentr מחיקה של תחומי העניין שלך על בסיס מתחלף מדי חודש. תחומי עניין שלא הוסרו עוברים רענון.</translation>
<translation id="5736850870166430177">‏אם באתר כלשהו מתבצע ניסיון לגנוב את הסיסמה שלך, או אם המערכת מזהה הורדה של קובץ מזיק, Decentr עשוי גם לשלוח כתובות URL לבדיקה באמצעות 'גלישה בטוחה'. הנתונים שנשלחים לבדיקה כוללים ביטים מתוכן של דפים</translation>
<translation id="5756509061973259733">‏כבר קיים במכשיר פרופיל Decentr עם החשבון הזה.</translation>
<translation id="5795887333006832406">‏<ph name="PAGE_TITLE" /> - Decentr בגרסת Canary</translation>
<translation id="5804318322022881572">‏לא ניתן היה להפעיל את Decentr. יש לנסות שוב.</translation>
<translation id="5867197326698922595">‏Decentr מנסה לערוך את הסיסמאות.</translation>
