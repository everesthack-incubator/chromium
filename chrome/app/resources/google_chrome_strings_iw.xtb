<translation id="659498884637196217">‏שמורה במנהל הסיסמאות של Decentr במכשיר הזה</translation>
<translation id="6632473616050862500">‏השימוש ב-DecentrOS Flex מתאפשר בזכות <ph name="BEGIN_LINK_CROS_OSS" />תוכנת קוד פתוח<ph name="END_LINK_CROS_OSS" /> נוספת.</translation>
<translation id="6676384891291319759">גישה אל האינטרנט</translation>
<translation id="6679975945624592337">‏Decentr יכול לפעול ברקע</translation>
<translation id="6696915334902295848">‏נדרשת הרשאת גישה למיקרופון ב-Decentr עבור האתר הזה</translation>
<translation id="6718739135284199302">‏שיפור המהירות ב-Decentr</translation>
<translation id="6735387454586646204">‏מערכת DecentrOS Flex</translation>
<translation id="6739177684496155661">‏להמשיך בפרופיל Decentr חדש?</translation>
<translation id="6750954913813541382">‏כדי לתקן שגיאות כתיב, הטקסט שהוקלד על ידך בדפדפן נשלח אל Decentr על ידי Decentr</translation>
<translation id="677276454032249905">‏לסגור את Decentr בכל זאת?</translation>
<translation id="683440813066116847">‏כלל נכנס עבור הגרסה הניסיונית של Decentr על מנת לאפשר תנועת mDNS.</translation>
<translation id="6881299373831449287">‏מתבצע עדכון של Decentr</translation>
<translation id="6885412569789873916">‏אפליקציות לגרסת הבטא של Decentr</translation>
<translation id="6933858244219479645">‏מערכת DecentrOS</translation>
<translation id="6938166777909186039">‏כדי לקבל עדכונים של Decentr בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 8.1.</translation>
<translation id="6943584222992551122">‏נתוני הגלישה של האדם הזה יימחקו מהמכשיר. כדי לשחזר את הנתונים, יש להיכנס ל-Decentr בתור<ph name="USER_EMAIL" />.</translation>
<translation id="6967962315388095737">‏כלל נכנס לגרסת הבטא של Decentr כדי לאפשר תנועת mDNS.</translation>
<translation id="6989339256997917931">‏Decentr עודכן, אך לא השתמשת בו לפחות 30 ימים.</translation>
<translation id="7025789849649390912">ההתקנה נעצרה.</translation>
<translation id="7025800014283535195">‏כאן ניתן לעבור בין פרופילים של Decentr</translation>
<translation id="7036251913954633326">‏אם ברצונך להשתמש בחשבון הזה באופן חד-פעמי, אפשר להשתמש <ph name="GUEST_LINK_BEGIN" />במצב אורח<ph name="GUEST_LINK_END" /> בדפדפן Decentr. כדי להוסיף חשבון של מישהו אחר, <ph name="LINK_BEGIN" />יש להוסיף משתמש חדש<ph name="LINK_END" /> אל <ph name="DEVICE_TYPE" />.

יכול להיות שהרשאות שכבר נתת לאתרים ולאפליקציות יחולו על החשבון הזה. יש לך גם אפשרות לנהל את חשבונות Decentr <ph name="SETTINGS_LINK_BEGIN" />בהגדרות<ph name="SETTINGS_LINK_END" />.</translation>
<translation id="7062128746136194023">‏אחד מההורים השבית ב-Decentr את ההגדרה "הרשאות לאתרים, אפליקציות ותוספים". לא ניתן להוסיף את ה<ph name="EXTENSION_TYPE_PARAMETER" />.</translation>
<translation id="7085332316435785646">‏בוחרים אם לכלול את ההיסטוריה ב-Decentr להתאמה אישית מדויקת יותר בשירותי Decentr</translation>
<translation id="7088681679121566888">‏Decentr מעודכן</translation>
<translation id="7098166902387133879">‏Decentr משתמש במיקרופון שלך.</translation>
<translation id="7099479769133613710">‏הפעלה מחדש לצורך עדכון ‎&amp;DecentrOS</translation>
<translation id="7106741999175697885">‏מנהל המשימות - Decentr</translation>
<translation id="7140653346177713799">{COUNT,plural, =0{‏יש עדכון חדש בשביל Decentr והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש.}=1{‏יש עדכון חדש בשביל Decentr והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. החלון האנונימי לא ייפתח מחדש.}one{‏יש עדכון חדש בשביל Decentr והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}two{‏יש עדכון חדש בשביל Decentr והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}other{‏יש עדכון חדש בשביל Decentr והמערכת תחיל אותו ברגע שתבוצע הפעלה מחדש. # החלונות האנונימיים לא ייפתחו מחדש.}}</translation>
<translation id="7155997830309522122">‏אם שינית את הסיסמה הזו, יש לערוך את הסיסמה השמורה ב-Decentr כך שהיא תתאים לסיסמה החדשה שלך.</translation>
<translation id="7161904924553537242">‏ברוך הבא ל-Decentr</translation>
<translation id="7177959540995930968">‏מידע נוסף לגבי התכונות האלה זמין בהגדרות של Decentr.</translation>
<translation id="7242029209006116544">‏בחרת להיכנס לחשבון מנוהל, ויינתן למנהל המערכת שלו שליטה על הפרופיל שלך ב-Decentr. הנתונים שלך ב-Decentr, כגון אפליקציות, סימניות, היסטוריה, סיסמאות והגדרות אחרות ייקשרו באופן קבוע ל-<ph name="USER_NAME" />. ניתן למחוק את הנתונים האלה באמצעות מרכז השליטה של חשבונות Decentr, אבל לא ניתן יהיה לשייך את הנתונים האלה לחשבון אחר. <ph name="LEARN_MORE" /></translation>
<translation id="7295052994004373688">‏זו השפה שבה מוצג ממשק המשתמש של Decentr</translation>
<translation id="7296210096911315575">מידע חשוב על בטיחות ועל אופן השימוש</translation>
<translation id="7308322188646931570">‏Decentr זקוק לגישה לאחסון כדי להוריד קבצים</translation>
<translation id="7339898014177206373">חלון חדש</translation>
<translation id="7388770099345495132">‏אם ברצונך להשתמש בחשבון הזה באופן חד-פעמי, אפשר להשתמש במצב אורח בדפדפן Decentr. כדי להוסיף חשבון של מישהו אחר, <ph name="LINK_BEGIN" />יש להוסיף משתמש חדש<ph name="LINK_END" /> אל <ph name="DEVICE_TYPE" />.

יכול להיות שהרשאות שכבר נתת לאתרים ולאפליקציות יחולו על החשבון הזה. יש לך גם אפשרות לנהל את חשבונות Decentr <ph name="SETTINGS_LINK_BEGIN" />בהגדרות<ph name="SETTINGS_LINK_END" />.</translation>
<translation id="7398801000654795464">‏התחברת ל-Decentr כ-<ph name="USER_EMAIL_ADDRESS" />. יש להשתמש באותו חשבון כדי להיכנס שוב.</translation>
<translation id="7410958280246779049">‏הקובץ הזה מסוכן ולכן הוא נחסם על ידי Decentr</translation>
<translation id="7426611252293106642">‏יכול להיות ש-Decentr לא יפעל כראוי כי הוא כבר לא נתמך בגרסה הזו של Linux</translation>
<translation id="7481213027396403996">‏רוצה להשיג את רמת האבטחה הגבוהה ביותר של Decentr?</translation>
<translation id="7486227612705979895">‏Decentr ייגש ל-Drive שלך כדי להציג הצעות בשורת כתובת האתר</translation>
<translation id="7535429826459677826">‏גרסת הפיתוח של Decentr</translation>
<translation id="7583399374488819119">מנהל ההתקנה של <ph name="COMPANY_NAME" /></translation>
<translation id="7606334485649076285">DecentrOS Flex</translation>
<translation id="7626032353295482388">‏ברוך בואך אל Decentr</translation>
<translation id="7626072681686626474">‏לפי הדרישה של <ph name="MANAGER" />, יש לקרוא ולאשר את התנאים וההגבלות הבאים לפני השימוש במכשיר הזה. תנאים אלה לא מרחיבים, משנים או מגבילים את התנאים לשימוש ב-DecentrOS.</translation>
<translation id="7629695634924605473">‏Decentr מודיע לך אם הסיסמאות שלך נמצאות בסיכון</translation>
<translation id="7641148173327520642">‏לפי הגדרת מנהל המערכת, Decentr יפתח את <ph name="ALTERNATIVE_BROWSER_NAME" /> כדי לגשת אל <ph name="TARGET_URL_HOSTNAME" />.</translation>
<translation id="7649070708921625228">עזרה</translation>
<translation id="7651907282515937834">‏לוגו של Decentr Enterprise</translation>
<translation id="7655455401911432608">‏היסטוריית הגלישה – תיעוד האתרים שביקרת בהם באמצעות Decentr במכשיר הזה.</translation>
<translation id="7747138024166251722">המתקין לא הצליח ליצור ספרייה זמנית. יש לבדוק את המקום הפנוי בדיסק ואת האישור להתקנת תוכנה.</translation>
<translation id="7761834446675418963">‏אפשר ללחוץ על השם שלך כדי לפתוח את Decentr ולהתחיל לגלוש.</translation>
<translation id="7777080907402804672">‏אם אין לתמונה תיאור מועיל, Decentr ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Decentr. אפשר להשבית את האפשרות הזו בכל זמן דרך ההגדרות.</translation>
<translation id="7781002470561365167">‏גרסה חדשה של Decentr זמינה כעת.</translation>
<translation id="778331955594035129">‏נדרשת הרשאת מיקום ב-Decentr עבור האתר הזה</translation>
<translation id="7787950393032327779">‏נראה שהפרופיל נמצא בשימוש על ידי תהליך אחר של Decentr‏ (<ph name="PROCESS_ID" />) במחשב אחר (<ph name="HOST_NAME" />)‏. Decentr נעל את הפרופיל כדי שלא ייפגם. אם ברור לך שאף תהליך אחר אינו משתמש בפרופיל זה, באפשרותך לבטל את נעילת הפרופיל ולהפעיל את Decentr מחדש.</translation>
<translation id="7801699035218095297">‏Decentr מנסה להעתיק את הסיסמאות. כדי לאפשר את הפעולה הזו, יש להקליד את הסיסמה שלך ל-Windows.</translation>
<translation id="7808348361785373670">‏הסרה מ-Decentr...</translation>
<translation id="7825851276765848807">‏ההתקנה נכשלה בשל שגיאה לא מזוהה. צריך להוריד שוב את Decentr.</translation>
<translation id="7845233973568007926">תודה שהתקנת. עליך להפעיל מחדש את המחשב לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="7872446069773932638">מתבצעת הורדה… יש עוד <ph name="SECONDS" /> שנ'</translation>
<translation id="7880591377632733558">‏ברוך בואך אל Decentr, <ph name="ACCOUNT_FIRST_NAME" /></translation>
<translation id="7890208801193284374">‏כשמשתפים מחשב, חברים ובני משפחה יכולים לגלוש בנפרד ולהגדיר את Decentr בדיוק כפי שהם רוצים.</translation>
<translation id="7896673875602241923">‏מישהו נכנס בעבר ל-Decentr מהמחשב הזה כ-<ph name="ACCOUNT_EMAIL_LAST" />. יש ליצור משתמש חדש ל-Decentr כדי לשמור על הפרדת המידע שלך.</translation>
<translation id="7917876797003313048">‏יש לך אפשרות לנהל את חשבונות Decentr שאליהם נכנסת. כדי ליהנות מחיבור לחשבון בדפדפן Decentr, בחנות Play, ב-‏Gmail ובשירותים נוספים, עליך להיכנס עם חשבונות Decentr שלך. כדי להוסיף חשבון של מישהו אחר, כמו חבר/ה בקבוצה המשפחתית, יש להוסיף משתמש חדש ל-<ph name="DEVICE_TYPE" />. <ph name="LINK_BEGIN" />מידע נוסף<ph name="LINK_END" /></translation>
<translation id="7930071585467473040">‏Decentr מנסה להעתיק את הסיסמאות.</translation>
<translation id="7951272445806340501">‏צריך להפעיל מחדש את DecentrOS Flex כדי להחיל את העדכון.</translation>
<translation id="7962368738413920945">‏סביר להניח שאתרים יפעלו כצפוי, אבל ההעדפות שלך באתרים האלו יימחקו לאחר סגירת כל החלונות ב-Decentr</translation>
<translation id="7962410387636238736">‏המחשב הזה כבר לא יקבל עדכונים ל-Decentr, מאחר שכבר אין תמיכה במערכות Windows XP ו-Windows Vista</translation>
<translation id="8005666035647241369">‏נשמרה במנהל הסיסמאות של Decentr במכשיר הזה</translation>
<translation id="8008534537613507642">‏התקנת Decentr מחדש</translation>
<translation id="8013993649590906847">‏אם אין לתמונה תיאור מועיל, Decentr ינסה לספק לך תיאור. כדי ליצור תיאורים, התמונות נשלחות אל Decentr.</translation>
<translation id="80471789339884597">תודה שהתקנת. עליך להפעיל מחדש את כל הדפדפנים לפני השימוש ב-<ph name="BUNDLE_NAME" />.</translation>
<translation id="8064015586118426197">DecentrOS Flex</translation>
<translation id="808089508890593134">Decentr</translation>
<translation id="8129812357326543296">‏מידע על Decentr&amp;</translation>
<translation id="813913629614996137">מתבצע אתחול...</translation>
<translation id="8255190535488645436">‏Decentr משתמש במצלמה ובמיקרופון שלך.</translation>
<translation id="8270775718612349140">‏אישורים שמנוהלים על ידי Decentr</translation>
<translation id="8286862437124483331">‏Decentr מנסה להציג סיסמאות. יש להקליד את הסיסמה שלך ל-Windows כדי לאפשר זאת.</translation>
<translation id="828798499196665338">‏אחד מההורים השבית ב-Decentr את ההגדרה "הרשאות לאתרים, אפליקציות ותוספים". לא ניתן להפעיל את <ph name="EXTENSION_TYPE_PARAMETER" />.</translation>
<translation id="8290100596633877290">‏אופס! Decentr קרס. להפעיל מחדש עכשיו?</translation>
<translation id="8341646175450781745">‏כשההגדרה מופעלת, Decentr מפנה מקום בזיכרון שמוקצה לכרטיסיות לא פעילות. כך, לכרטיסיות הפעילות ולאפליקציות אחרות יש יותר משאבים מהמחשב ו-Decentr פועל מהר. כשחוזרים לכרטיסיות הלא פעילות, הן מופעלות מחדש באופן אוטומטי. אפשר <ph name="BEGIN_LINK" />לקבל מידע נוסף<ph name="END_LINK" /> או <ph name="BEGIN_LINK_2" />לשלוח משוב<ph name="END_LINK_2" /></translation>
<translation id="8342675569599923794">‏Decentr‏ חסם את הקובץ הזה כי הוא מסוכן.</translation>
<translation id="8349795646647783032">‏<ph name="BEGIN_BOLD" />איך אנחנו משתמשים בנתונים האלה:<ph name="END_BOLD" /> אתרים יכולים לשמור מידע ב-Decentr לגבי תחומי העניין שלך. לדוגמה, אם ביקרת באתר כדי לקנות נעליים למרתון, האתר עשוי להגדיר 'ריצת מרתון' כתחום עניין שלך. לאחר מכן, בביקור באתר שונה, למשל כדי להירשם למרוץ, יכול להיות שתוצג לך מודעה לנעלי ריצה על סמך תחומי העניין שלך.</translation>
<translation id="8370517070665726704">‏Copyright <ph name="YEAR" /> Decentr LLC.‎ כל הזכויות שמורות.</translation>
<translation id="8383226135083126309">‏<ph name="BEGIN_BOLD" />איך אנחנו משתמשים בנתונים האלה:<ph name="END_BOLD" /> Decentr יכול להעריך מהם תחומי העניין שלך. לאחר מכן, אתר שבו ביקרת יכול לשלוח בקשה ל-Decentr כדי לגלות מהם תחומי העניין שלך ולהתאים אישית את המודעות שמוצגות לך.</translation>
<translation id="8387459386171870978">‏המשך השימוש ב-Decentr</translation>
<translation id="8394720698884623075">‏המערכת בודקת כתובות URL בעזרת רשימה של אתרים לא בטוחים ששמורה ב-Decentr</translation>
<translation id="840084489713044809">‏Decentr רוצה לייצא את הסיסמאות שלך.</translation>
<translation id="8416347857511542594">‏מידע נוסף על ההתאמה האישית של המודעות ב-Decentr</translation>
<translation id="8418845734693287262">‏לא בוצע סנכרון של הנתונים ב-DecentrOS כי פרטי הכניסה לחשבון לא מעודכנים.</translation>
<translation id="8433638294851456451">‏כדי לשלוח מספר מכאן לטלפון Android, יש להיכנס ל-Decentr בשני המכשירים.</translation>
<translation id="8451192282033883849">‏החשבון שלך מנוהל על ידי <ph name="MANAGER_NAME" />. האדמין שלך יכול לראות ולערוך את הפרופיל הזה של דפדפן Decentr ואת הנתונים שלו, כמו סימניות, היסטוריה וסיסמאות.</translation>
<translation id="8498858610309223613">‏בוצע עדכון אבטחה מיוחד של Decentr. עכשיו עליך להפעיל מחדש את Decentr ואנחנו נשחזר את הכרטיסיות.</translation>
<translation id="8504220326736535258">‏בקובץ הזה יש תוכנה זדונית ולכן הוא נחסם על ידי Decentr</translation>
<translation id="8516431725144212809">‏תחומי העניין שלך בהתאם להערכה של Decentr</translation>
<translation id="8521348052903287641">‏כלל נכנס לגרסת הפיתוח של Decentr כדי לאפשר תנועת mDNS.</translation>
<translation id="8540666473246803645">Decentr</translation>
<translation id="8550334526674375523">פרופיל העבודה שלך נפרד לחלוטין מהפרופיל האישי שלך.</translation>
<translation id="8556340503434111824">‏גרסה חדשה של Decentr זמינה, והיא מהירה יותר מאי פעם.</translation>
<translation id="8571790202382503603">‏בעזרת פרופילים ב-Decentr, אפשר להפריד בין הפריטים ששומרים ב-Decentr. באופן הזה קל יותר להפריד בין עבודה לפנאי.</translation>
<translation id="8614913330719544658">‏Decentr אינו מגיב. להפעיל מחדש עכשיו?</translation>
<translation id="861702415419836452">‏Decentr זקוק להרשאת גישה למצלמה כדי ליצור מפה תלת-ממדית של הסביבה שלך</translation>
<translation id="8625237574518804553">{0,plural, =1{‏Decentr יופעל מחדש בעוד דקה}one{‏Decentr יופעל מחדש בעוד # דקות}two{‏Decentr יופעל מחדש בעוד # דקות}other{‏Decentr יופעל מחדש בעוד # דקות}}</translation>
<translation id="8641606876632989680">‏אם מערכת Decentr תזהה שנכנסת עם סיסמה שנחשפה, היא תתריע לך על כך</translation>
<translation id="8649026945479135076">‏באתרים רבים נהוג לשמור את תחומי העניין שלך כדי להתאים אישית את חוויית הגלישה בהם. בנוסף, אתרים יכולים לשמור מידע ב-Decentr לגבי תחומי העניין שלך.</translation>
<translation id="8669527147644353129">Decentr Helper</translation>
<translation id="8679801911857917785">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Decentr.</translation>
<translation id="8684875378076460854">‏ההמלצה של Decentr היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן</translation>
<translation id="8686817260976772516">‏בעזרת פרופילים ב-Decentr, אפשר להפריד בין הפריטים ששומרים ב-Decentr. יוצרים פרופילים המיועדים לחברים ולבני משפחה או פרופילים נפרדים לעבודה ולבילויים בשעות הפנאי.</translation>
<translation id="8712767363896337380">‏העדכון כמעט הושלם. כדי להשלים את העדכון, עליך להפעיל את Decentr מחדש.</translation>
<translation id="873133009373065397">‏Decentr אינו יכול לקבוע או להגדיר את דפדפן ברירת המחדל</translation>
<translation id="8821043148920470810">‏כדי לקבל עדכונים של Decentr בעתיד, צריך להשתמש ב-Windows מגרסה 10 ואילך. במחשב הזה פועלת מערכת Windows 7.</translation>
<translation id="8823341990149967727">‏Decentr אינו מעודכן</translation>
<translation id="8825634023950448068">‏כדי להגן על הפרטיות שלך, תחומי עניין שהוגדרו לפני יותר מ-4 שבועות נמחקים אוטומטית. עם המשך הגלישה, תחום עניין כלשהו עשוי להופיע שוב ברשימה. אם ב-Decentr הוגדר תחום עניין שגוי או שאינך רוצה לראות מודעות מסוימות, יש לך אפשרות להסיר תחומי עניין.</translation>
<translation id="8834965163890861871">‏Decentr מנסה לערוך את הסיסמאות. כדי לאפשר את הפעולה הזו, יש להקליד את הסיסמה שלך ל-Windows.</translation>
<translation id="884296878221830158">‏הגדרה זו גם קובעת איזה דף מוצג כשמפעילים את Decentr או לוחצים על הלחצן 'דף הבית'.</translation>
<translation id="8847000024471094355">‏Decentr לא פעיל</translation>
<translation id="8862326446509486874">אין לך זכויות שמתאימות להתקנה ברמת המערכת. יש לנסות להפעיל שוב את המתקין כמנהל מערכת.</translation>
<translation id="8914504000324227558">‏הפעלה מחדש של Decentr</translation>
<translation id="8922193594870374009">‏כדי לשלוח מספר מ-<ph name="ORIGIN" /> לטלפון Android, יש להיכנס אל Decentr בשני המכשירים.</translation>
<translation id="8983720963221508955">‏הפעלת בחשבון שלך את הגרסה המשופרת של הגלישה הבטוחה. עכשיו אפשר להפעיל אותה ב-Decentr.</translation>
<translation id="8986207147630327271">בחרת להוסיף פרופיל עבודה לדפדפן זה ולתת למנהל המערכת שליטה רק על פרופיל העבודה.</translation>
<translation id="8989968390305463310">‏היסטוריית הגלישה שלך משפיעה על המודעות שמוצגות לך ועל תחומי העניין המשוערים שמופיעים בהמשך. כדי להגן על הפרטיות שלך, מתבצעת ב-Decentr מחיקה אוטומטית של תחומי העניין שלך על בסיס מתחלף מדי חודש. תחומי עניין שלא הוסרו עוברים רענון.</translation>
<translation id="8999208279178790196">{0,plural, =0{‏יש עדכון זמין ל-Decentr}=1{‏יש עדכון זמין ל-Decentr}one{‏עדכון ל-Decentr זמין כבר # ימים}two{‏עדכון ל-Decentr זמין כבר # ימים}other{‏עדכון ל-Decentr זמין כבר # ימים}}</translation>
<translation id="9003498785844995646">‏כשהתכונה מופעלת, Decentr חוסך בחיי הסוללה על ידי הגבלת הפעילות ברקע והאפקטים החזותיים, כמו גלילה חלקה וקצב פריימים של סרטונים. אפשר <ph name="BEGIN_LINK" />לקבל מידע נוסף<ph name="END_LINK" /> או <ph name="BEGIN_LINK_2" />לשלוח משוב<ph name="END_LINK_2" /></translation>
<translation id="9053892488859122171">‏מערכת DecentrOS Flex</translation>
<translation id="9067395829937117663">‏כדי להשתמש ב-Decentr יש צורך ב-Windows מגירסה 7 ואילך.</translation>
<translation id="911206726377975832">למחוק גם את נתוני הגלישה שלך?</translation>
<translation id="9138603949443464873">‏כדי להחיל את השינויים שביצעת, יש להפעיל מחדש את Decentr</translation>
<translation id="9195993889682885387">‏Decentr יכול להעריך מהם תחומי העניין שלך על סמך היסטוריית הגלישה שלך מהשבועות האחרונים. המידע הזה נשאר במכשיר שלך.</translation>
<translation id="919706545465235479">‏יש לעדכן את Decentr כדי להתחיל את הסנכרון</translation>
<translation id="922152298093051471">‏התאמה אישית של Decentr</translation>
<translation id="93760716455950538">‏הפעלה מחדש של DecentrOS Flex</translation>
<translation id="940313311831216333">‏כדי לקבל גישה אל הפריטים שלך ב-Decentr בכל המכשירים, יש להיכנס לחשבון ולהפעיל את הסנכרון.</translation>
<translation id="943390475793766444">‏ההמלצה של Decentr היא לסרוק את הקובץ הזה כי הוא עלול להיות מסוכן.</translation>
<translation id="989369509083708165">‏Decentr הוא דפדפן ברירת המחדל</translation>
<translation id="989816563149873169">‏ניתן לעבור בין פרופילים של Decentr באמצעות <ph name="SHORTCUT" /></translation>
</translationbundle>