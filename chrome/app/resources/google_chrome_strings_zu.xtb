<translation id="6040143037577758943">Vala</translation>
<translation id="6070348360322141662">Ngokuvikela okungeziwe, i-Decentr izobethela idatha yakho</translation>
<translation id="608006075545470555">Engeza Iphrofayela Yomsebenzi kulesi siphequluli</translation>
<translation id="6113794647360055231">I-Decentr isanda kuba ngcono</translation>
<translation id="6145313976051292476">Vula ama-PDF ku-Decentr</translation>
<translation id="6155960517327665396">Isilondolozi Senkumbulo senze i-Decentr yashesha</translation>
<translation id="6169866489629082767"><ph name="PAGE_TITLE" /> - I-Decentr</translation>
<translation id="6173637689840186878"><ph name="PAGE_TITLE" /> - Decentr Beta</translation>
<translation id="6235018212288296708">Umyalo obophezeleke ngaphakathi we-Decentr ukuze kuvunyelwe ithrafikhi ye-mDNS.</translation>
<translation id="6247557882553405851">Umphathi Wephasiwedi ye-Decentr</translation>
<translation id="6273793429163604305">Guqani...</translation>
<translation id="6291089322031436445">Izinhlelo zokusebenza ze-Decentr Dev</translation>
<translation id="6291549208091401781">I-Decentr isivele ifakelwe bonke abasebenzisi kukhompuyutha yakho.</translation>
<translation id="6326175484149238433">Susa kusuka ku-Decentr</translation>
<translation id="6327105987658262776">Asikho isibuyekezo esitholakalayo.</translation>
<translation id="6412673304250309937">Kuhlola ama-URL anohlu lwamasayithi angaphephile agcinwe ku-Decentr. Uma isayithi lizama ukuntshontsha iphasiwedi yakho, noma uma ulanda ifayela eliyingozi, i-Decentr ingathumela nama-URL, kuhlanganise nokuthile okuqukethwe kulelo khasi, Ekuphequluleni Okuphephile.</translation>
<translation id="6418662306461808273">Shintshela kuphrofayela ye-Decentr ekhona kakade?</translation>
<translation id="6506909944137591434">I-Decentr idinga imvume yekhamera ukudala imephu ye-3D yendawo yakho ekuzungezile</translation>
<translation id="6515495397637126556"><ph name="PAGE_TITLE" /> - Decentr Dev</translation>
<translation id="659498884637196217">Ku-Decentr Password Manager kule divayisi</translation>
<translation id="6632473616050862500">I-DecentrOS Flex yenzeka ngenxa <ph name="BEGIN_LINK_CROS_OSS" />yesofthiwe yomthombo ovulekile eyengeziwe<ph name="END_LINK_CROS_OSS" />.</translation>
<translation id="6676384891291319759">Finyelela i-inthanethi?</translation>
<translation id="6679975945624592337">Vumela i-Decentr isebenze ngemuva</translation>
<translation id="6696915334902295848">I-Decentr idinga imvume yemakrofoni kule sayithi</translation>
<translation id="6718739135284199302">Yenza i-Decentr isheshe</translation>
<translation id="6735387454586646204">Isistimu ye-DecentrOS Flex</translation>
<translation id="6739177684496155661">Qhubeka kuphrofayela entsha ye-Decentr?</translation>
<translation id="6750954913813541382">Ukuze kulungiswe amaphutha okupeletwa, i-Decentr ithumela umbhalo owuthayiphayo kusiphequluli ku-Decentr</translation>
<translation id="677276454032249905">Phuma ku-Decentr noma kunjalo?</translation>
<translation id="683440813066116847">Umyalo wokubophezeleka ngaphakathi kwe-Decentr Canary ukuze kuvunyelwe ithrafikhi ye-mDNS.</translation>
<translation id="6881299373831449287">Ibuyekeza i-Decentr</translation>
<translation id="6885412569789873916">Izinhlelo zokusebenza ze-beta ye-Decentr</translation>
<translation id="6933858244219479645">Isistimu ye-DecentrOS</translation>
<translation id="6938166777909186039">Ukuze uthole izibuyekezo zesikhathi esizayo ze-Decentr, uzodinga i-Windows 10 noma yakamuva. Le khompyutha isebenzisa i-Windows 8.1.</translation>
<translation id="6943584222992551122">Idatha yokuphequlula yalo muntu izosuswa kusukela kule divayisi. Ukuze uphinde uthole idatha, ngena ngemvume ku-Decentr njengo-<ph name="USER_EMAIL" />.</translation>
<translation id="6967962315388095737">Umyalo wokubophezeleka ngaphakathi kwe-beta yeDecentr ukuze kuvunyelwe ithrafikhi ye-mDNS.</translation>
<translation id="6989339256997917931">I-Decentr ibuyekeziwe, kodwa awukayisebenzisi ngokungenani izinsuku ezingu-30.</translation>
<translation id="7025789849649390912">Ukufaka Kumisiwe.</translation>
<translation id="7025800014283535195">Ungashintsha phakathi kwamaphrofayela we-Decentr lapha</translation>
<translation id="7036251913954633326">Uma ufuna ukusebenzisa le akhawunti kanye kuphela, ungasebenzisa <ph name="GUEST_LINK_BEGIN" />Imodi Yesivakashi<ph name="GUEST_LINK_END" /> kwibhrawuza ye-Decentr. Uma ufuna ukwengeza i-akhawunti yothile, <ph name="LINK_BEGIN" />engeza umuntu omusha<ph name="LINK_END" /> ku-<ph name="DEVICE_TYPE" /> yakho.

Izimvume ozinikezile kakade amawebhusayithi nama-app zingase zisebenze kule akhawunti. Ungakwazi nokuphatha ama-Decentr Account wakho kokuthi <ph name="SETTINGS_LINK_BEGIN" />Amasethingi<ph name="SETTINGS_LINK_END" />.</translation>
<translation id="7062128746136194023">Umzali wakho uvale "Izimvume zamasayithi, izinhlelo zokusebenza, nezandiso" ze-Decentr. Ukwengeza le <ph name="EXTENSION_TYPE_PARAMETER" /> akuvumelekile.</translation>
<translation id="7085332316435785646">Khetha ukuthi ufake phakathi umlando we-Decentr ukuze uthole umuzwa womuntu siqu kumasevisi e-Decentr</translation>
