<!DOCTYPE translationbundle>
<translationbundle lang="km">
<translation id="1026101648481255140">បន្តការដំឡើង</translation>
<translation id="1029669172902658969">ចាប់ផ្តើម​ឡើងវិញ​ដើម្បីដំឡើងកំណែ &amp;TomiOS</translation>
<translation id="1065672644894730302">ចំណូលចិត្តរបស់អ្នកមិនអាចអានបានទេ។

លក្ខណៈពិសេសមួយចំនួនប្រហែលជាមិនមាន ហើយការប្តូរទៅចំណូលចិត្តនឹងមិនត្រូវបានរក្សាទុកទេ។</translation>
<translation id="1098170124587656448">Tomi អាច​ជួយរក្សាសុវត្ថិភាពរបស់អ្នកពី​ការបែកធ្លាយ​ទិន្នន័យ កម្មវិធីបន្ថែម​ដែលមានបញ្ហា និង​អ្វីៗជាច្រើនទៀត</translation>
<translation id="1104942323762546749">Tomi ចង់​នាំ​ចេញពាក្យ​សម្ងាត់​របស់អ្នក។ សូមវាយ​បញ្ចូលពាក្យ​សម្ងាត់ Windows របស់អ្នក​ដើម្បីអនុញ្ញាត​ការនាំចេញ​នេះ។</translation>
<translation id="113122355610423240">Tomi គឺជា​កម្មវិធីរុករក​តាមអ៊ីនធឺណិត​លំនាំដើម​របស់​អ្នក</translation>
<translation id="1131805035311359397">ដើម្បីពិនិត្យមើលថា​តើពាក្យសម្ងាត់​របស់អ្នក​មានសុវត្ថិភាពពី​ការបែកធ្លាយ​ទិន្នន័យ និងបញ្ហាសុវត្ថិភាព​ផ្សេងទៀតឬអត់ សូម​<ph name="BEGIN_LINK" />ចូល Tomi<ph name="END_LINK" />។</translation>
<translation id="1185134272377778587">អំពី Tomi</translation>
<translation id="1203500561924088507">សូមអរគុណសម្រាប់ការដំឡើង។ អ្នកត្រូវតែចាប់ផ្ដើមកម្មវិធីរុករកតាមអ៊ីនធឺណិតរបស់អ្នកឡើងវិញ មុនពេលប្រើ <ph name="BUNDLE_NAME" />។</translation>
<translation id="1231839967188101156">នៅពេលបើក Tomi សម្អាតឱ្យសល់​អង្គចងចាំ​ពីផ្ទាំងដែលអសកម្ម។ សកម្មភាព​នេះ​ផ្ដល់​ធនធានកុំព្យូទ័រ​បន្ថែម​ដល់​ផ្ទាំង​ដែលសកម្ម និងកម្មវិធីផ្សេងទៀត ព្រមទាំង​រក្សាឱ្យ Tomi មានល្បឿនលឿន។ ផ្ទាំង​ដែលអសកម្ម​របស់អ្នក​ប្រែជា​សកម្ម​ឡើងវិញដោយស្វ័យប្រវត្តិ នៅពេលអ្នកត្រឡប់ទៅផ្ទាំងទាំងនោះវិញ។ <ph name="BEGIN_LINK" />ស្វែងយល់បន្ថែម<ph name="END_LINK" /></translation>
<translation id="1261119230216066228">មុខងារសន្សំសំចៃអង្គចងចាំ​បាន​ធ្វើ​ឱ្យ​ Tomi កាន់តែ​លឿន</translation>
<translation id="1315551408014407711">រៀបចំ​កម្រងព័ត៌មាន Tomi ថ្មី​របស់អ្នក</translation>
<translation id="1396446129537741364">Tomi កំពុងព្យាយាមបង្ហាញពាក្យសម្ងាត់។</translation>
<translation id="1414495520565016063">អ្នកបានចូលមកកាន់ Tomi!</translation>
<translation id="1493803763272692301">អ្នកអាច​រីករាយ​នឹង​អត្ថប្រយោជន៍ច្រើនបំផុត​ពី Tomi</translation>
<translation id="1524282610922162960">ចែករំលែក​ផ្ទាំង Tomi</translation>
<translation id="1553461853655228091">Tomi ត្រូវការការអនុញ្ញាតចូលប្រើកាមេរ៉ារបស់អ្នក ដើម្បីបង្កើតផែនទី 3D នៃមជ្ឈដ្ឋានជុំវិញរបស់អ្នក</translation>
<translation id="1607715478322902680">{COUNT,plural, =0{អ្នក​គ្រប់គ្រង​របស់អ្នក​តម្រូវឱ្យអ្នក​ចាប់ផ្ដើម Tomi ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មី}=1{អ្នក​គ្រប់គ្រង​របស់អ្នក​តម្រូវឱ្យអ្នក​ចាប់ផ្ដើម Tomi ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មី។ ផ្ទាំងឯកជនរបស់អ្នក​នឹង​មិនបើកឡើងវិញទេ។}other{អ្នក​គ្រប់គ្រង​របស់អ្នក​តម្រូវឱ្យអ្នក​ចាប់ផ្ដើម Tomi ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មី។ ផ្ទាំងឯកជន # របស់អ្នក​នឹងមិន​បើកឡើងវិញទេ។}}</translation>
<translation id="1625909126243026060">ពិនិត្យមើល​ការគ្រប់គ្រង​សុវត្ថិភាព និងឯកជនភាព​សំខាន់ៗនៅក្នុង Tomi</translation>
<translation id="1632539827495546968">ប្រសិនបើអ្នកចង់ប្រើគណនីនេះតែម្ដងគត់ អ្នកអាចប្រើ<ph name="GUEST_LINK_BEGIN" />មុខងារភ្ញៀវ<ph name="GUEST_LINK_END" />នៅក្នុងកម្មវិធីរុករកតាមអ៊ីនធឺណិត Tomi។ ប្រសិនបើអ្នកចង់បញ្ចូលគណនីសម្រាប់អ្នកផ្សេងទៀត សូម<ph name="LINK_BEGIN" />បញ្ចូលមនុស្សថ្មី<ph name="LINK_END" />ទៅក្នុង <ph name="DEVICE_TYPE" /> របស់អ្នក។

ការអនុញ្ញាត​ដែលអ្នកបានផ្ដល់​ឱ្យគេហទំព័រ និងកម្មវិធីរួចហើយ​អាចអនុវត្តចំពោះ​គណនីនេះ។ អ្នកអាចគ្រប់គ្រងគណនី Tomi របស់អ្នកបាននៅក្នុង<ph name="SETTINGS_LINK_BEGIN" />ការកំណត់<ph name="SETTINGS_LINK_END" />។</translation>
<translation id="1640672724030957280">កំពុងទាញ​យក...</translation>
<translation id="1708666629004767631">មានកំណែថ្មីដែលមានសុវត្ថិភាពជាងមុនសម្រាប់ Tomi។</translation>
<translation id="17264556997921157">អ្នក​អាច​មើលឃើញ និង​លុប​ចេញ​នូវ​ប្រធានបទ​ជា​ទី​ចាប់​អារម្មណ៍​ដែល​គេហទំព័រ​ប្រើប្រាស់​សម្រាប់​បង្ហាញ​ការ​ផ្សាយ​ពាណិជ្ជកម្ម​ដល់​អ្នក។ Tomi ប៉ាន់ស្មានចំណាប់អារម្មណ៍របស់អ្នក ដោយផ្អែកលើប្រវត្តិ​រុករក​តាមអ៊ីនធឺណិតថ្មីៗរបស់អ្នក។</translation>
<translation id="1774152462503052664">អនុញ្ញាតឲ្យ Tomi ដំណើរនៅក្នុងផ្ទៃខាងក្រោយ</translation>
<translation id="1779356040007214683">ដើម្បីធ្វើឲ្យ Tomi មានសុវត្ថិភាពជាងមុន យើងបានបិទដំណើរកម្មវិធីបន្ថែមមួយចំនួនដែលមិនត្រូវបានរាយនៅក្នុង <ph name="IDS_EXTENSION_WEB_STORE_TITLE" /> ហើយអាចត្រូវបានបន្ថែមដោយពុំមានការជូនដំណឹងដល់អ្នក។</translation>
<translation id="1808667845054772817">តំឡើង Tomi ឡើងវិញ</translation>
<translation id="185970820835152459">អ្នកអាចគ្រប់គ្រង​គណនី Tomi ដែលអ្នកចូល។ គណនី Tomi របស់អ្នក​ត្រូវបានប្រើ​សម្រាប់​កម្មវិធីរុករកតាមអ៊ីនធឺណិត Tomi, Play Store, Gmail និងអ្វីៗជាច្រើនទៀត។ ប្រសិនបើអ្នក​ចង់បញ្ចូល​គណនីសម្រាប់​អ្នកផ្សេងទៀត​ដូចជា សមាជិកគ្រួសារជាដើម សូមបញ្ចូលមនុស្សថ្មី​ទៅក្នុង <ph name="DEVICE_TYPE" /> របស់អ្នក​ជំនួសវិញ។ <ph name="LINK_BEGIN" />ស្វែងយល់បន្ថែម<ph name="LINK_END" /></translation>
<translation id="1863308913976887472">គេហទំព័រអាច​រក្សាទុក​ព័ត៌មានជាមួយ Tomi អំពីចំណាប់អារម្មណ៍​របស់អ្នក។ ឧទាហរណ៍ ប្រសិនបើអ្នក​ចូលមើល​គេហទំព័រ ដើម្បីទិញស្បែកជើង​សម្រាប់រត់ម៉ារ៉ាតុង នោះគេហទំព័រនោះ​ប្រហែលជាកំណត់​ចំណាប់អារម្មណ៍​របស់អ្នក​ថាជាការរត់ម៉ារ៉ាតុង។ ក្រោយមកទៀត ប្រសិនបើអ្នកចូលមើល​គេហទំព័រផ្សេង ដើម្បីចុះឈ្មោះ​ចូលរួមការប្រណាំង គេហទំព័រនោះ​អាចបង្ហាញ​ការផ្សាយពាណិជ្ជកម្ម​អំពីស្បែកជើងសម្រាប់​រត់ប្រណាំងដល់អ្នក ដោយផ្អែកលើ​ចំណាប់អារម្មណ៍​របស់អ្នក។</translation>
<translation id="1881322772814446296">អ្នកកំពុងចូលជាមួយគណនីដែលបានគ្រប់គ្រង ហើយផ្តល់ឲ្យអ្នកគ្រប់គ្រងនូវការគ្រប់គ្រងលើទម្រង់ Tomi របស់អ្នក។ ទិន្នន័យ Tomi របស់អ្នក ដូចជាកម្មវិធី គេហទំព័រ ប្រវត្តិ ពាក្យសម្ងាត់ និងការកំណត់ផ្សេងទៀតរបស់អ្នកនឹងភ្ជាប់ជាមួយ <ph name="USER_NAME" /> ជាអចិន្ត្រៃយ៍។ អ្នកនឹងអាចលុបទិន្នន័យនេះតាមរយៈ Tomi Accounts Dashboard ប៉ុន្តែអ្នកនឹងមិនអាចភ្ជាប់ទិន្នន័យនេះជាមួយគណនីដ៏ទៃទៀតឡើយ។ ជាជម្រើស អ្នកអាចបង្កើតទម្រង់ថ្មីដើម្បីរក្សាទិន្នន័យ Tomi ដែលមានស្រាប់របស់អ្នកដាច់ដោយឡែក។ <ph name="LEARN_MORE" /></translation>
<translation id="1911763535808217981">ប្រសិនបើ​បិទ​មុខងារនេះ មានន័យ​ថាអ្នក​អាចចូល​គេហទំព័រផ្សេងៗ​របស់ Tomi ដូចជា Gmail ដោយមិន​ចាំបាច់ចូល Tomi នោះទេ</translation>
<translation id="1929939181775079593">Tomi មិនឆ្លើយតប។ បើកដំណើរការឡើងវិញឥឡូវនេះ?</translation>
