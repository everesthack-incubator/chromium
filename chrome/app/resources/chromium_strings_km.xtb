<translation id="364817392622123556">{COUNT,plural, =0{មានកំណែថ្មី​សម្រាប់ Tomi ​ហើយ ហើយកំណែថ្មីនេះ​នឹង​ប្រើភ្លាមៗ ​បន្ទាប់ពី​អ្នកចាប់ផ្ដើម​ឡើងវិញ។}=1{មានកំណែថ្មី​សម្រាប់ Tomi ​ហើយ ហើយកំណែថ្មីនេះ​នឹង​ប្រើភ្លាមៗ ​បន្ទាប់ពី​អ្នកចាប់ផ្ដើម​ឡើងវិញ។ ផ្ទាំងឯកជនរបស់អ្នក​នឹង​មិនបើកឡើងវិញទេ។}other{មានកំណែថ្មី​សម្រាប់ Tomi ​ហើយ ហើយកំណែថ្មីនេះ​នឹង​ប្រើភ្លាមៗ ​បន្ទាប់ពី​អ្នកចាប់ផ្ដើម​ឡើងវិញ។ ផ្ទាំងឯកជន # របស់អ្នក​នឹងមិន​បើកឡើងវិញទេ។}}</translation>
<translation id="3651803019964686660">ដើម្បីផ្ញើ​លេខទូរសព្ទពី <ph name="ORIGIN" /> ទៅទូរសព្ទ Android របស់អ្នក សូមចូល Tomi នៅលើឧបករណ៍​ទាំងពីរ។</translation>
<translation id="3685209450716071127">Tomi មិនអាចពិនិត្យ​ពាក្យសម្ងាត់របស់អ្នកបានទេ។ សូមសាកល្បងពិនិត្យ​ការតភ្ជាប់អ៊ីនធឺណិត​របស់អ្នក។</translation>
<translation id="3702352323269013324">ស្វែងយល់បន្ថែមអំពីការកំណត់ការផ្សាយពាណិជ្ជកម្មឱ្យស្របតាមបុគ្គលនៅក្នុង Tomi</translation>
<translation id="370962675267501463">{COUNT,plural, =0{អ្នក​គ្រប់គ្រង​របស់អ្នក​ស្នើឱ្យអ្នក​ចាប់ផ្ដើម Tomi ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មីនេះ}=1{អ្នក​គ្រប់គ្រង​របស់អ្នក​ស្នើឱ្យអ្នក​ចាប់ផ្ដើម Tomi ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មីនេះ។ ផ្ទាំងឯកជនរបស់អ្នក​នឹង​មិនបើកឡើងវិញទេ។}other{អ្នក​គ្រប់គ្រង​របស់អ្នក​ស្នើឱ្យអ្នក​ចាប់ផ្ដើម Tomi ឡើងវិញ​ ដើម្បីប្រើ​កំណែថ្មីនេះ។ ផ្ទាំងឯកជន # របស់អ្នក​នឹងមិន​បើកឡើងវិញទេ។}}</translation>
<translation id="3713809861844741608">បើក​តំណ​នៅក្នុងផ្ទាំង​ Tomi ថ្មី</translation>
