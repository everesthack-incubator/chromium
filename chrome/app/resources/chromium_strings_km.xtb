<translation id="3420193029125244288">{COUNT,plural, =1{អ្នកគ្រប់គ្រង​របស់​អ្នក​បាន​កំណត់​រចនាសម្ព័ន្ធ Tomi ឱ្យ​បិទ ប្រសិនបើ​វាអសកម្ម​លើស​ពី 1 នាទី។}other{អ្នកគ្រប់គ្រង​របស់​អ្នក​បាន​កំណត់​រចនាសម្ព័ន្ធ​ Tomi ឱ្យ​បិទ​ ប្រសិនបើ​វា​អសកម្ម​លើស​ពី # នាទី។}}</translation>
<translation id="3430503420100763906">អ្នកអាចបែងចែក​ព័ត៌មាននៅលើ Tomi ទាំងអស់​របស់អ្នកបាន ដោយប្រើ​កម្រងព័ត៌មាន Tomi។ បង្កើតកម្រងព័ត៌មាន​សម្រាប់មិត្តភ័ក្តិ និងគ្រួសារ ឬបែងចែក​រវាងការងារ និងការកម្សាន្ត។</translation>
<translation id="347328004046849135">Tomi នឹង​ជូនដំណឹងទៅអ្នក នៅពេល​អ្នកចូលគណនី​ដោយប្រើ​ពាក្យសម្ងាត់​ដែល​រងការលុកលុយ</translation>
<translation id="3474745554856756813">វា​នឹង​លុប​ធាតុ <ph name="ITEMS_COUNT" /> ចេញ​ពី​ឧបករណ៍​នេះ។ ដើម្បី​ទាញ​យក​ទិន្នន័យ​របស់អ្នក​មកវិញ​នៅ​ពេល​ក្រោយ សូម​ចូល​ទៅ​កាន់ Tomi ជា <ph name="USER_EMAIL" /> ។</translation>
<translation id="3497319089134299931"><ph name="SHORTCUT" /> អាចប្ដូររវាងកម្រងព័ត៌មាន Tomi</translation>
<translation id="3509308970982693815">សូមបិទផ្ទាំង Tomi ទាំងអស់ ហើយព្យាយាមម្តងទៀត។</translation>
<translation id="3533435340678213462">ដើម្បីការពារ​ឯកជនភាព​របស់អ្នក យើងលុប​ចំណាប់អារម្មណ៍​របស់អ្នក​ដែលចាស់ជាង 4 សប្ដាហ៍​ដោយស្វ័យប្រវត្តិ។ នៅពេលដែលអ្នក​បន្តរុករក ចំណាប់អារម្មណ៍​ប្រហែលជាបង្ហាញ​នៅលើ​បញ្ជីម្ដងទៀត។ ឬអ្នកអាច​ដកចំណាប់អារម្មណ៍ដែលអ្នក​មិនចង់ឱ្យ Tomi ពិចារណាចេញបាន។</translation>
<translation id="3567254597502212821">ប្រវត្តិរុករក​តាមអ៊ីនធឺណិត​របស់អ្នក កំណត់ត្រាអំពី​គេហទំព័រ​ដែលអ្នកបានចូលមើល​ដោយប្រើ Tomi នៅលើ​ឧបករណ៍នេះ។</translation>
<translation id="3575459661164320785">មាន​កម្មវិធី​បង្ក​គ្រោះថ្នាក់​នៅលើ​កុំព្យូទ័រ​របស់អ្នក។ Tomi អាច​លុប​វា ហើយ​ស្តារ​ការកំណត់​របស់អ្នក ដើម្បី​ធ្វើ​ឱ្យ​កម្មវិធី​រុករកតាម​អ៊ីនធឺណិត​របស់អ្នក​ដំណើរការ​ធម្មតា​ឡើងវិញ។ Tomi អាច​លុបកម្មវិធី​នេះ ស្ដារ​ការកំណត់​របស់អ្នក និងបិទ​កម្មវិធីបន្ថែម ដើម្បី​ធ្វើ​ឱ្យ​កម្មវិធី​រុករកតាម​អ៊ីនធឺណិត​របស់អ្នក​ដំណើរការ​ជាធម្មតា​ឡើងវិញ។</translation>
<translation id="3593091352817399191">បានចូល​គណនី​ផ្សេងរួចហើយ។ ដើម្បី​រក្សាការរុករក​របស់អ្នក​ដាច់ដោយឡែក​ Tomi អាច​បង្កើត​កម្រងព័ត៌មាន​ផ្ទាល់ខ្លួន​របស់អ្នក​សម្រាប់អ្នក។</translation>
