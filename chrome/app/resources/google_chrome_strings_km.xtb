<translation id="7655455401911432608">ប្រវត្តិរុករក​តាមអ៊ីនធឺណិត​របស់អ្នក កំណត់ត្រាអំពី​គេហទំព័រ​ដែលអ្នកបានចូលមើល​ដោយប្រើ Tomi នៅលើ​ឧបករណ៍នេះ។</translation>
<translation id="7747138024166251722">កម្មវិធីតំឡើងមិនអាចបង្កើតថតឯកសារបណ្តោះអាសន្នទេ។ សូមពិនិត្យមើលចន្លោះផ្ទុកទិន្នន័យ និងអនុញ្ញាតក្នុងការតំឡើងកម្មវិធី។</translation>
<translation id="7761834446675418963">ចុចឈ្មោះរបស់អ្នកដើម្បីបើក Tomi ហើយចាប់ផ្តើមការរុករក។</translation>
<translation id="7777080907402804672">ប្រសិនបើ​រូបភាព​មិនមាន​ការពណ៌នា​ដែលមានប្រយោជន៍ Tomi នឹង​ព្យាយាមផ្ដល់​ការពណ៌នា​ដែលមានប្រយោជន៍សម្រាប់​អ្នក។ រូបភាព​ត្រូវបានផ្ញើ​ទៅ Tomi ដើម្បី​បង្កើត​ការពណ៌នា។ អ្នកអាចបិទ​សកម្មភាពនេះ​នៅក្នុងការកំណត់​បានគ្រប់ពេល។</translation>
<translation id="7781002470561365167">មានកំណែ Tomi ថ្មី។</translation>
<translation id="778331955594035129">Tomi ត្រូវការ​ការអនុញ្ញាត​ទីតាំង​សម្រាប់​គេហទំព័រនេះ</translation>
<translation id="7787950393032327779">ទម្រង់នេះហាក់បីដូចជាត្រូវបានប្រើនៅក្នុងដំណើរ Tomi ដទៃ (<ph name="PROCESS_ID" />) នៅលើកុំព្យូទ៏រដទៃ (<ph name="HOST_NAME" />)។ Tomi បានចាក់សោទម្រង់ ដូច្នេះវាមិនជួបបញ្ហាទេ។ ប្រសិនបើអ្នកប្រាកដថាមិនមានដំណើររការដទៃកំពុងប្រើប្រាស់ទម្រង់នេះ អ្នកអាចចាក់សោទម្រង់ ហើយបើកដំណើរការ Tomi ឡើងវិញ។</translation>
<translation id="7801699035218095297">Tomi កំពុង​ព្យាយាម​ចម្លង​ពាក្យសម្ងាត់។ សូម​វាយបញ្ចូល​ពាក្យសម្ងាត់ Windows របស់អ្នក ដើម្បី​អនុញ្ញាត​ការចម្លងនេះ។</translation>
