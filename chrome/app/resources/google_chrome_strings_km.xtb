<translation id="521447420733633466">ប្រសិនបើអ្នកចែករំលែកឧបករណ៍ណាមួយ មិត្តភ័ក្ដិ និងគ្រួសាររបស់អ្នកអាចរុករកដាច់ដោយឡែក ព្រមទាំងរៀបចំ Tomi តាមអ្វីដែលពួកគេចង់បាន</translation>
<translation id="5251420635869119124">ភ្ញៀវអាចប្រើ Tomi ដោយមិនមានបន្សល់ទុកអ្វីឡើយ។</translation>
<translation id="5334309298019785904">TomiOS មិនអាចធ្វើ​សម​កាល​កម្មទិន្នន័យរបស់អ្នកបានទេ ដោយសារមិនអាចប្រើ​សម​កាល​កម្មនៅក្នុងដែនរបស់អ្នក។</translation>
