<translation id="7890208801193284374">ប្រសិនបើអ្នកចែករំលែកកុំព្យូទ័រ មិត្តភ័ក្ត និងគ្រួសារអាចរុករកដាច់ដោយឡែក ហើយតំឡើង Tomi តាមរបៀបដែលអ្នកចង់បាន។</translation>
<translation id="7896673875602241923">មាននរណាម្នាក់បានចូលទៅកាន់ Tomi នៅលើកុំព្យូទ័រនេះកាលពីមុន ជា <ph name="ACCOUNT_EMAIL_LAST" /> ។ សូមបង្កើតអ្នកប្រើ Tomi ថ្មី ដើម្បីរក្សាព័ត៌មានរបស់អ្នកដាច់ដោយឡែក។</translation>
<translation id="7917876797003313048">អ្នកអាចគ្រប់គ្រង​គណនី Tomi ដែលអ្នកចូល។ គណនី Tomi របស់អ្នក​ត្រូវបានប្រើ​សម្រាប់​កម្មវិធីរុករកតាមអ៊ីនធឺណិត Tomi, Play Store, Gmail និងអ្វីៗជាច្រើនទៀត។ ប្រសិនបើអ្នក​ចង់បញ្ចូល​គណនីសម្រាប់​អ្នកផ្សេងទៀត​ដូចជា សមាជិកគ្រួសារជាដើម សូមបញ្ចូលមនុស្សថ្មី​ទៅក្នុង <ph name="DEVICE_TYPE" /> របស់អ្នក​ជំនួសវិញ។ <ph name="LINK_BEGIN" />ស្វែងយល់បន្ថែម<ph name="LINK_END" /></translation>
<translation id="7930071585467473040">Tomi កំពុង​ព្យាយាម​ចម្លង​ពាក្យសម្ងាត់។</translation>
<translation id="7951272445806340501">TomiOS Flex ត្រូវការចាប់ផ្ដើមឡើងវិញ ដើម្បីប្រើកំណែថ្មី។</translation>
<translation id="7962368738413920945">គេហទំព័រប្រហែលជា​នឹង​ដំណើរការ​ដូច​ដែល​អ្នក​រំពឹង​ទុក ប៉ុន្តែ​នឹង​មិន​ចងចាំ​អ្នក​បន្ទាប់​ពី​អ្នក​បិទ​វិនដូ Tomi ទាំងអស់ទេ</translation>
<translation id="7962410387636238736">កុំព្យូទ័រនេះ​នឹងមិនទទួល​បានកំណែ​ថ្មី​របស់ Tomi ទៀតទេ ដោយសារ​តែ Windows XP និង Windows Vista មិន​អាច​ប្រើបាន​ទៀតទេ</translation>
<translation id="8005666035647241369">ទៅក្នុង​កម្មវិធីគ្រប់គ្រង​ពាក្យសម្ងាត់ Tomi នៅលើ​ឧបករណ៍នេះ</translation>
