<translation id="8255190535488645436">Tomi កំពុងប្រើកាមេរ៉ា និងម៉ៃក្រូហ្វូនរបស់អ្នក។</translation>
<translation id="8270775718612349140">វិញ្ញាបនបត្រ​ត្រូវបានគ្រប់គ្រង​ដោយ Tomi</translation>
<translation id="8286862437124483331">Tomi កំពុងព្យាយាមបង្ហាញពាក្យសម្ងាត់។ វាយបញ្ចូលពាក្យសម្ងាត់ Windows ដើម្បីអនុញ្ញាត។</translation>
<translation id="828798499196665338">មាតាបិតា​របស់អ្នក​បានបិទ "ការអនុញ្ញាត​ឱ្យចូលប្រើ​គេហទំព័រ កម្មវិធី និង​កម្មវិធី​បន្ថែម" សម្រាប់ Tomi។ ការបើក <ph name="EXTENSION_TYPE_PARAMETER" /> នេះ​មិនត្រូវបាន​អនុញ្ញាតទេ​។</translation>
<translation id="8290100596633877290">អូយ! Tomi បានគាំង។ ចាប់ផ្តើមដំណើរការឡើងវិញឥឡូវនេះ?</translation>
