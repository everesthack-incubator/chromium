<translation id="5132929315877954718">ស្វែងយល់ពីកម្មវិធី ហ្គេម កម្មវិធីបន្ថែម និងធីមដ៏អស្ចារ្យសម្រាប់ Tomi។</translation>
<translation id="5139423532931106058">ប្ដូរកម្រងព័ត៌មាន Tomi របស់អ្នកតាមបំណង</translation>
<translation id="5163087008893166964">សូម​ស្វាគមន៍​មក​កាន់ Tomi។ បាន​បើក​វិនដូ​របស់​កម្មវិធីរុករកតាមអ៊ីនធឺណិត​ថ្មី</translation>
