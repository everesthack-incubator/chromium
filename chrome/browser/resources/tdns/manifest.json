{
  "name": "tDNS Resolver",
  "version": "1.0",
  "description": "Resolve tDNS names",
  "manifest_version": 2,
  "permissions": [
    "activeTab",
    "storage",
    "webRequest",
    "*://*.tomi/"
  ],
  "icons": {
    "16": "assets/icon16.png",
    "24": "assets/icon24.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
      "scripts": [
          "background.js",
          "runtime.js"
      ],
    "persistent": true
  },
  "browser_action": {},
  "content_security_policy": "script-src 'self' 'unsafe-eval'; object-src 'self'",
  "web_accessible_resources": [
    "*"
  ],
  "key":""
}
