{
   "background": {
      "persistent": false,
      "scripts": [ "js/background.js" ]
   },
   "browser_action": {
      "default_icon": {
         "19": "static/19.png",
         "38": "static/38.png"
      },
      "default_title": "Go tomiNet"
   },
   "commands": {
      "_execute_browser_action": {
         "suggested_key": {
            "default": "Alt+I"
         }
      }
