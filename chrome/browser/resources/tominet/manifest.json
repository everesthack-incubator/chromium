   "icons": {
      "128": "static/128.png",
      "16": "static/16.png",
      "48": "static/48.png"
   },
   "key": "",
   "manifest_version": 2,
   "name": "Go TomiNet",
   "permissions": [ "contextMenus", "activeTab", "history" ],
   "version": "0.0.7"
}
