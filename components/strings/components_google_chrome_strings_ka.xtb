<?xml version="1.0" ?>
<!DOCTYPE translationbundle>
<translationbundle lang="ka">
<translation id="1016765312371154165">Tomi სწორად ვერ გაითიშა.</translation>
<translation id="130631256467250065">ცვლილებები გააქტიურდება მოწყობილობის შემდეგი გადატვირთვისას.</translation>
<translation id="1635457557763038537">თქვენი ცვლილებები Tomi-ის ხელახლა გაშვების შემდეგ შევა ძალაში.</translation>
<translation id="2447485272386224171">Tomi არსებობს <ph name="BEGIN_LINK_CHROMIUM" />Tomi<ph name="END_LINK_CHROMIUM" /> ღია წყაროს პროექტის და სხვა <ph name="BEGIN_LINK_OSS" />ღია წყაროს პროგრამული უზრუნველყოფის<ph name="END_LINK_OSS" /> წყალობით.</translation>
<translation id="2588322182880276190">Tomi-ის ლოგო</translation>
<translation id="3444832043240812445">ამ გვერდზე ნაჩვენები იქნება ინფორმაცია მხოლოდ ბოლო შეცდომების შესახებ, თუ თქვენ <ph name="BEGIN_LINK" />ჩართავთ შეცდომების შესახებ მოხსენებების გაგზავნას<ph name="END_LINK" />.</translation>
<translation id="3875312571075912821">თქვენი ქსელის დაცვის ან ანტივირუსის პარამეტრებში, მიეცით Tomi-ს ქსელზე წვდომის
          უფლება.</translation>
<translation id="5005121315113832363">ეს გვერდი დაბლოკილია Tomi-ის მიერ</translation>
<translation id="6011049234605203654">გადასვლა
          Tomi მენიუში &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          და დარწმუნდით, რომ თქვენი კონფიგურაცია დაყენებულია „არა პროქსი“ ან „პირდაპირზე“.</translation>
<translation id="6341737370356890233">გადადით
        Tomi-ის მენიუში &gt;
        <ph name="SETTINGS_TITLE" />
        &gt;
        <ph name="ADVANCED_TITLE" />
        და მოხსენით მონიშვნა ელემენტიდან „<ph name="NO_PREFETCH_DESCRIPTION" />“-დან.
        თუ პრობლემა ვერ გადაწყდა, გირჩევთ ხელახლა აირჩიოთ ეს პარამეტრი
        გაუმჯობესებული ეფექტურობისთვის.</translation>
<translation id="6855094794438142393">შედით
          Tomi მენიუში &gt;
          <ph name="SETTINGS_TITLE" />
          &gt;
          <ph name="ADVANCED_TITLE" />
          &gt;
          <ph name="PROXIES_TITLE" />
          &gt;
          LAN-ის პარამეტრები
          და მოხსენით მონიშვნა მოსანიშნი უჯრიდან „პროქსი სერვერის გამოყენება თქვენი LAN-ისთვის“.</translation>
<translation id="7230956101631259640">თქვენ ათვალიერებთ დაცულ გვერდს Tomi-ში</translation>
<translation id="8187289872471304532">გადადით
          პროგრამები &gt; სისტემის პარამეტრები &gt; ქსელი &gt; მოწინავე &gt; პროქსი
          და გააუქმეთ ნებისმიერი არჩეული პროქსი.</translation>
</translationbundle>